{% extends 'base.html.twig' %}

{% block title %}Activities - Rehletna.tn{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap');

        .main-container {
            display: flex;
            min-height: 100vh;
            background: radial-gradient(1400px 500px at 10% -20%, rgba(10, 160, 159, 0.22), transparent 60%), radial-gradient(1000px 500px at 100% 0%, rgba(252, 186, 48, 0.20), transparent 55%), linear-gradient(180deg, #f4f9ff 0%, #eff6fb 100%);
            font-family: 'Sora', 'Segoe UI', sans-serif;
        }

        .side-menu {
            position: fixed;
            left: -300px;
            top: 0;
            width: 300px;
            height: 100vh;
            background: linear-gradient(180deg, #ffffff 0%, #f3f9ff 100%);
            box-shadow: 10px 0 32px rgba(3, 39, 75, 0.15);
            transition: left 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
            border-right: none;
        }

        .side-menu.open {
            left: 0;
        }

        .side-menu-content {
            padding: 28px 22px;
        }

        .user-info {
            text-align: center;
            padding-bottom: 18px;
            border-bottom: none;
            margin-bottom: 18px;
        }

        .avatar {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            margin: 0 auto 10px;
            background: linear-gradient(145deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            box-shadow: 0 10px 24px rgba(7, 57, 107, 0.25);
        }

        .user-name {
            font-size: 15px;
            font-weight: 700;
            color: #11406f;
            margin: 0;
        }

        .user-role {
            font-size: 12px;
            color: #d29a16;
            font-weight: 700;
            margin: 2px 0 0;
            text-transform: capitalize;
        }



        /* ── AI Chatbot Assistant ── */
.ai-chat-fab {
    position: fixed;
    bottom: 28px;
    right: 32px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0fa5a2, #1788b6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(15,165,162,0.45);
    z-index: 3000;
    transition: transform 0.2s, box-shadow 0.2s;
    color: white;
    font-size: 24px;
    display: none;
}
.ai-chat-fab:hover { transform: scale(1.1); box-shadow: 0 8px 28px rgba(15,165,162,0.55); }
.ai-chat-fab.visible { display: flex; }

.ai-chat-fab-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(15,165,162,0.35);
    animation: aiFabPulse 2.2s ease-out infinite;
    pointer-events: none;
}
@keyframes aiFabPulse {
    0% { transform: scale(1); opacity: 0.7; }
    70% { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
}

.ai-chat-window {
    position: fixed;
    bottom: 96px;
    right: 32px;
    width: 370px;
    height: 500px;
    border-radius: 22px;
    background: #ffffff;
    border: 1px solid rgba(126,152,178,0.28);
    box-shadow: 0 16px 56px rgba(3,24,46,0.22);
    flex-direction: column;
    overflow: hidden;
    z-index: 3001;
    transform: translateY(16px) scale(0.95);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.24s cubic-bezier(.4,0,.2,1), opacity 0.22s ease;
    display: none;
}
.ai-chat-window.open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: all;
    display: flex;
}

.ai-chat-header {
    padding: 14px 16px;
    background: linear-gradient(135deg, #0b4e7a 0%, #0fa5a2 100%);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}
.ai-chat-header-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.28);
}
.ai-chat-header-info { flex: 1; }
.ai-chat-header-name { font-size: 14px; font-weight: 700; color: #fff; margin: 0; }
.ai-chat-header-sub { font-size: 11px; color: rgba(255,255,255,0.72); margin: 2px 0 0; }
.ai-chat-header-close {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.22);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: background 0.15s;
}
.ai-chat-header-close:hover { background: rgba(255,255,255,0.26); }

.ai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px 13px 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(126,152,178,0.3) transparent;
}
.ai-chat-messages::-webkit-scrollbar { width: 4px; }
.ai-chat-messages::-webkit-scrollbar-thumb { background: rgba(126,152,178,0.3); border-radius: 4px; }

.ai-msg {
    max-width: 88%;
    font-size: 13px;
    line-height: 1.55;
    padding: 9px 12px;
    border-radius: 16px;
    animation: aiMsgIn 0.18s ease;
    font-family: 'Sora', 'Segoe UI', sans-serif;
}
@keyframes aiMsgIn { from { opacity:0; transform: translateY(7px); } to { opacity:1; transform: none; } }
.ai-msg.from-ai {
    background: #f4f8fc;
    color: #1a3a52;
    border-bottom-left-radius: 4px;
    align-self: flex-start;
    border: 1px solid rgba(126,152,178,0.18);
}
.ai-msg.from-user {
    background: linear-gradient(135deg, #0fa5a2, #1788b6);
    color: #fff;
    border-bottom-right-radius: 4px;
    align-self: flex-end;
}
.ai-msg.typing-indicator {
    background: #f4f8fc;
    color: #7a90a4;
    border-bottom-left-radius: 4px;
    align-self: flex-start;
    border: 1px solid rgba(126,152,178,0.18);
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 6px;
}
.ai-typing-dots span {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #7a90a4;
    animation: aiDot 1.3s infinite;
}
.ai-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.ai-typing-dots span:nth-child(3) { animation-delay: 0.4s; }
@keyframes aiDot { 0%,80%,100%{transform:scale(0.7);opacity:0.5} 40%{transform:scale(1);opacity:1} }

.ai-apply-btn {
    display: inline-block;
    margin-top: 7px;
    font-size: 11px;
    padding: 4px 11px;
    border-radius: 8px;
    border: none;
    background: rgba(15,165,162,0.14);
    color: #0b7a7a;
    cursor: pointer;
    font-weight: 700;
    font-family: 'Sora', 'Segoe UI', sans-serif;
    transition: background 0.15s;
}
.ai-apply-btn:hover { background: rgba(15,165,162,0.26); }

.ai-chat-chips {
    padding: 4px 12px 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    flex-shrink: 0;
    border-top: 1px solid rgba(126,152,178,0.13);
}
.ai-chip {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 20px;
    border: 1px solid rgba(126,152,178,0.28);
    background: rgba(255,255,255,0.85);
    color: #336080;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    font-family: 'Sora', 'Segoe UI', sans-serif;
    white-space: nowrap;
}
.ai-chip:hover { background: rgba(15,165,162,0.1); color: #0b7a7a; border-color: rgba(15,165,162,0.35); }

.ai-chat-input-row {
    padding: 9px 11px;
    border-top: 1px solid rgba(126,152,178,0.15);
    display: flex;
    gap: 8px;
    align-items: flex-end;
    flex-shrink: 0;
}
.ai-chat-input {
    flex: 1;
    border: 1px solid rgba(126,152,178,0.32);
    border-radius: 12px;
    padding: 8px 11px;
    font-size: 13px;
    font-family: 'Sora', 'Segoe UI', sans-serif;
    resize: none;
    min-height: 36px;
    max-height: 90px;
    background: #f7fbff;
    color: #174a78;
    outline: none;
    transition: border-color 0.15s;
}
.ai-chat-input:focus { border-color: #0fa5a2; }
.ai-chat-send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0fa5a2, #1788b6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.15s, opacity 0.15s;
    box-shadow: 0 4px 12px rgba(15,165,162,0.3);
}
.ai-chat-send:hover { transform: scale(1.08); }
.ai-chat-send:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

body.dark-mode .ai-chat-window { background: #121824; border-color: rgba(255,255,255,0.08); }
body.dark-mode .ai-msg.from-ai { background: rgba(255,255,255,0.05); color: #c8dff0; border-color: rgba(255,255,255,0.08); }
body.dark-mode .ai-chat-input { background: rgba(255,255,255,0.05); color: #c8dff0; border-color: rgba(255,255,255,0.1); }
body.dark-mode .ai-chip { background: rgba(255,255,255,0.06); color: #8db4d7; border-color: rgba(255,255,255,0.1); }
body.dark-mode .ai-chat-chips { border-color: rgba(255,255,255,0.07); }
body.dark-mode .ai-chat-input-row { border-color: rgba(255,255,255,0.07); }




        .side-menu-btn {
            width: 100%;
            text-align: left;
            padding: 12px 18px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 14px;
            color: #33506f;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .side-menu-btn:hover {
            background: rgba(10, 160, 159, 0.10);
            border-color: rgba(10, 160, 159, 0.22);
            color: #0b8e8b;
        }

        .logout-btn {
            margin-top: 18px;
            background: #fff2f2;
            color: #d94a5a;
            font-weight: 700;
            border-color: #ffd9de;
        }

