{% extends 'base.html.twig' %}

{% block title %}Activities - Rehletna.tn{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap');

        .main-container {
            display: flex;
            min-height: 100vh;
            background: radial-gradient(1400px 500px at 10% -20%, rgba(10, 160, 159, 0.22), transparent 60%), radial-gradient(1000px 500px at 100% 0%, rgba(252, 186, 48, 0.20), transparent 55%), linear-gradient(180deg, #f4f9ff 0%, #eff6fb 100%);
            font-family: 'Sora', 'Segoe UI', sans-serif;
        }

        .side-menu {
            position: fixed;
            left: -300px;
            top: 0;
            width: 300px;
            height: 100vh;
            background: linear-gradient(180deg, #ffffff 0%, #f3f9ff 100%);
            box-shadow: 10px 0 32px rgba(3, 39, 75, 0.15);
            transition: left 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
            border-right: none;
        }

        .side-menu.open {
            left: 0;
        }

        .side-menu-content {
            padding: 28px 22px;
        }

        .user-info {
            text-align: center;
            padding-bottom: 18px;
            border-bottom: none;
            margin-bottom: 18px;
        }

        .avatar {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            margin: 0 auto 10px;
            background: linear-gradient(145deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            box-shadow: 0 10px 24px rgba(7, 57, 107, 0.25);
        }

        .user-name {
            font-size: 15px;
            font-weight: 700;
            color: #11406f;
            margin: 0;
        }

        .user-role {
            font-size: 12px;
            color: #d29a16;
            font-weight: 700;
            margin: 2px 0 0;
            text-transform: capitalize;
        }

        .side-menu-btn {
            width: 100%;
            text-align: left;
            padding: 12px 18px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 14px;
            color: #33506f;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .side-menu-btn:hover {
            background: rgba(10, 160, 159, 0.10);
            border-color: rgba(10, 160, 159, 0.22);
            color: #0b8e8b;
        }

        .logout-btn {
            margin-top: 18px;
            background: #fff2f2;
            color: #d94a5a;
            font-weight: 700;
            border-color: #ffd9de;
        }

        .logout-btn:hover {
            background: #ffe9ec;
            border-color: #ffccd4;
            color: #c03b4d;
        }

        .menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(3, 30, 58, 0.40);
            backdrop-filter: blur(2px);
            z-index: 999;
        }

        .menu-overlay.show {
            display: block;
        }

        .top-bar {
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(10px);
            padding: 16px 28px;
            box-shadow: 0 8px 24px rgba(10, 46, 88, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: none;
        }

        .logo {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            height: 40px;
            width: auto;
            display: flex;
            align-items: center;
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        .menu-toggle {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            margin-right: 12px;
            border-radius: 10px;
            transition: background 0.2s ease;
        }

        .menu-toggle:hover {
            background: rgba(10, 160, 159, 0.10);
        }

        .menu-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: #1D4D7C;
            margin: 5px 0;
            transition: 0.3s;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 6px 8px 6px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(80, 149, 198, 0.16);
            transition: all 0.25s ease;
        }

        .profile-info {
            text-align: right;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 700;
            color: #1D4D7C;
            margin: 0;
        }

        .profile-role {
            font-size: 11px;
            color: #d19a1a;
            font-weight: 700;
            margin: 0;
            text-transform: capitalize;
        }

        .profile-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            position: relative;
            box-shadow: 0 8px 20px rgba(7, 57, 107, 0.20);
        }

        .online-status {
            position: absolute;
            bottom: 1px;
            right: 1px;
            width: 12px;
            height: 12px;
            background: #2ecc71;
            border-radius: 50%;
            border: 2px solid white;
        }

        .nav-tabs {
            background: transparent;
            padding: 10px 28px 0;
            border-bottom: 0;
            display: flex;
            gap: 10px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .nav-tabs::-webkit-scrollbar {
            display: none;
        }

        .nav-tab {
            padding: 10px 18px;
            background: rgba(255, 255, 255, 0.75);
            border: none;
            border-radius: 999px;
            color: #49617a;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .nav-tab:hover {
            background: #ffffff;
            color: #0FA5A2;
        }

        .nav-tab.active {
            background: linear-gradient(135deg, #0FA5A2 0%, #1788b6 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(15, 165, 162, 0.26);
        }

        .content-area {
            flex: 1;
            padding: 22px 28px 36px;
            background: transparent;
        }

        .welcome-section {
            margin-bottom: 24px;
            padding: 28px;
            border-radius: 24px;
            background: linear-gradient(120deg, #ffffff 0%, #f7fbff 100%);
            box-shadow: 0 16px 34px rgba(7, 57, 107, 0.09);
        }

        .welcome-title {
            font-size: clamp(2rem, 3.8vw, 3rem);
            font-weight: 800;
            color: #133f6a;
            margin-bottom: 8px;
            line-height: 1.06;
            letter-spacing: -1px;
        }

        .welcome-subtitle {
            font-size: 16px;
            color: #4f657c;
            margin-bottom: 0;
        }

        .activities-card {
            padding: 28px;
            border-radius: 24px;
            background: #ffffff;
            box-shadow: 0 16px 34px rgba(7, 57, 107, 0.09);
        }

        .activities-module {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .activities-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 20px 22px;
            border-radius: 22px;
            background: linear-gradient(135deg, rgba(8, 97, 123, 0.96), rgba(14, 136, 161, 0.93));
            color: #fff;
            box-shadow: 0 18px 38px rgba(10, 52, 90, 0.2);
        }

        .activities-head h2 {
            margin: 0;
            font-size: clamp(28px, 3vw, 42px);
            line-height: 1.05;
        }

        .activities-head p {
            margin: 8px 0 0;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }

        .activities-head-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .activities-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.34);
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            white-space: nowrap;
            text-decoration: none;
        }

        .activities-filter-guide {
            cursor: pointer;
        }

        .activities-filter-guide svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
        }

        .activities-filter-guide.active {
            background: rgba(255, 255, 255, 0.28);
            border-color: rgba(255, 255, 255, 0.65);
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.22);
        }

        .activities-add-new {
            cursor: pointer;
        }

        .activities-search {
            border: 1px solid rgba(255, 255, 255, 0.45);
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.16);
            min-width: 220px;
            outline: none;
        }

        .activities-search-form {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .activities-search-btn {
            border: 1px solid rgba(255, 255, 255, 0.45);
            border-radius: 999px;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: 700;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.16);
            cursor: pointer;
        }

        .activities-search::placeholder {
            color: rgba(255, 255, 255, 0.9);
        }

        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 14px;
        }

        .activity-card {
            border: 1px solid rgba(126, 152, 178, 0.28);
            border-radius: 18px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 12px 24px rgba(10, 34, 62, 0.08);
            display: flex;
            flex-direction: column;
            min-height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            position: relative;
        }

        .activity-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.55);
            box-shadow: 0 18px 34px rgba(56, 189, 248, 0.28), 0 10px 22px rgba(10, 34, 62, 0.08);
        }

        .activity-owner-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            background: rgba(56, 189, 248, 0.95);
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.02em;
            box-shadow: 0 10px 20px rgba(56, 189, 248, 0.32);
            text-transform: uppercase;
        }

        .activity-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
            object-position: center;
            background: #f8fbff;
        }

        .activity-body {
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .activity-title {
            margin: 0;
            font-size: 20px;
            color: #174a78;
            font-weight: 800;
        }

        .activity-meta {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .activity-tag {
            border: 1px solid rgba(11, 164, 161, 0.3);
            background: rgba(11, 164, 161, 0.1);
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 700;
            color: #0b8e8b;
        }

        .activity-description {
            color: #5d7590;
            font-size: 13px;
            line-height: 1.45;
            min-height: 56px;
        }

        .activity-foot {
            margin-top: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .activity-price {
            font-size: 22px;
            font-weight: 800;
            color: #0d5e8a;
        }

        .activity-foot-right {
            display: flex;
            flex-direction: row;
            align-items: flex-end;
            gap: 8px;
        }

        .activity-delete-form {
            margin: 0;
        }

        .activity-view {
            border: 0;
            border-radius: 12px;
            padding: 10px 12px;
            cursor: pointer;
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            background: linear-gradient(135deg, #0fa5a2, #1788b6);
            text-decoration: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
        }

        .activity-view:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.28);
        }

        .activity-edit,
        .activity-delete {
            border: 0;
            border-radius: 12px;
            padding: 10px 12px;
            cursor: pointer;
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            text-decoration: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .activity-edit {
            background: linear-gradient(135deg, #0fa5a2, #1788b6);
        }

        .activity-edit:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.28);
        }

        .activity-delete {
            background: linear-gradient(135deg, #e85d75, #c6364f);
        }

        .activity-delete:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(200, 54, 79, 0.28);
        }

        .activity-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 16, 30, 0.58);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 2500;
        }

        .activity-modal-overlay.show {
            display: flex;
        }

        .activity-modal {
            width: min(980px, 100%);
            max-height: calc(100vh - 36px);
            overflow: auto;
            border-radius: 28px;
            background:
                radial-gradient(760px 260px at 100% 0%, rgba(11, 164, 161, 0.12), transparent 60%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 250, 253, 0.98));
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.26);
            border: 1px solid rgba(137, 156, 174, 0.24);
        }

        .activity-modal-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(137, 156, 174, 0.16);
        }

        .activity-modal-title {
            margin: 0;
            font-size: 26px;
            color: #134563;
            font-weight: 800;
        }

        .activity-modal-close {
            border: 0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(13, 94, 138, 0.1);
            color: #0d5e8a;
            cursor: pointer;
            font-size: 18px;
            font-weight: 800;
        }

        .activity-modal-body {
            display: grid;
            grid-template-columns: minmax(280px, 360px) 1fr;
            gap: 22px;
            padding: 22px;
        }

        .activity-modal-image {
            width: 100%;
            height: 100%;
            max-height: 420px;
            object-fit: cover;
            border-radius: 22px;
            box-shadow: 0 14px 26px rgba(10, 34, 62, 0.14);
        }

        .activity-modal-info {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .activity-modal-desc {
            color: #5d7590;
            line-height: 1.7;
            margin: 0;
        }

        .activity-modal-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .activity-modal-item {
            border: 1px solid rgba(126, 152, 178, 0.22);
            border-radius: 16px;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.92);
        }

        .activity-modal-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6a8198;
            margin-bottom: 4px;
            font-weight: 800;
        }

        .activity-modal-value {
            color: #174a78;
            font-weight: 700;
        }

        .activity-guide-box {
            display: flex;
            align-items: center;
            gap: 12px;
            border: 1px solid rgba(126, 152, 178, 0.22);
            border-radius: 18px;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.92);
        }

        .activity-guide-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(11, 164, 161, 0.3);
            box-shadow: 0 8px 16px rgba(10, 34, 62, 0.08);
        }

        .activity-guide-name {
            margin: 0;
            color: #134563;
            font-weight: 800;
        }

        .activity-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 6px;
            flex-wrap: wrap;
        }

        .activity-modal-reserve {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 14px;
            padding: 12px 16px;
            color: #fff;
            background: linear-gradient(135deg, #0fa5a2, #1788b6);
            text-decoration: none;
            font-weight: 800;
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.22);
        }

        .activity-modal-reserve:hover {
            box-shadow: 0 14px 24px rgba(11, 154, 157, 0.30);
            transform: translateY(-1px);
        }

        .payment-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 16, 30, 0.64);
            backdrop-filter: blur(6px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 2700;
        }

        .payment-overlay.show {
            display: flex;
        }

        .payment-modal {
            width: min(560px, 100%);
            max-height: calc(100vh - 36px);
            overflow: auto;
            border-radius: 26px;
            background: linear-gradient(170deg, #f7fbff 0%, #eef6ff 100%);
            border: 1px solid rgba(130, 157, 184, 0.34);
            box-shadow: 0 30px 70px rgba(3, 24, 46, 0.36);
        }

        .payment-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 20px;
            border-bottom: 1px solid rgba(130, 157, 184, 0.22);
        }

        .payment-title {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            color: #123e66;
        }

        .payment-amount {
            margin: 12px 20px 0;
            padding: 10px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(130, 157, 184, 0.22);
            color: #1d4d7c;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .payment-card {
            position: relative;
            overflow: hidden;
            margin: 14px 20px 0;
            border-radius: 20px;
            padding: 20px;
            color: #ffffff;
            background:
                radial-gradient(220px 140px at 90% -20%, rgba(255, 255, 255, 0.34), transparent 68%),
                radial-gradient(260px 180px at -10% 120%, rgba(255, 255, 255, 0.18), transparent 72%),
                linear-gradient(132deg, #0a2e59 0%, #0d4f7e 35%, #0fa5a2 68%, #2f7cc4 100%);
            border: 1px solid rgba(255, 255, 255, 0.24);
            box-shadow: 0 20px 36px rgba(12, 63, 99, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .payment-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, transparent 0%, rgba(255, 255, 255, 0.1) 42%, transparent 68%);
            pointer-events: none;
        }

        .payment-card::after {
            content: '';
            position: absolute;
            left: -15%;
            right: -15%;
            top: 52%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            pointer-events: none;
        }

        .payment-card-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            position: relative;
            z-index: 1;
        }

        .payment-chip {
            width: 44px;
            height: 34px;
            border-radius: 8px;
            background:
                linear-gradient(90deg, rgba(120, 84, 30, 0.24) 0, rgba(120, 84, 30, 0.24) 12px, transparent 12px, transparent 16px, rgba(120, 84, 30, 0.24) 16px, rgba(120, 84, 30, 0.24) 28px, transparent 28px),
                linear-gradient(160deg, #f1d49b, #b98d49);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35), 0 2px 6px rgba(7, 32, 59, 0.24);
        }

        .payment-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.16);
            padding: 4px 8px;
            border: 1px solid rgba(255, 255, 255, 0.26);
            backdrop-filter: blur(4px);
        }

        .payment-brand-dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: inline-block;
        }

        .payment-brand-dot.red {
            background: #ff6659;
        }

        .payment-brand-dot.yellow {
            background: #ffc94f;
            margin-left: -6px;
            mix-blend-mode: screen;
        }

        .payment-brand-text {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.92);
        }

        .payment-card-number {
            position: relative;
            z-index: 1;
            margin: 24px 0 12px;
            letter-spacing: 0.14em;
            font-size: clamp(18px, 4vw, 24px);
            font-weight: 800;
            text-shadow: 0 4px 12px rgba(0, 0, 0, 0.26);
        }

        .payment-card-meta {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            color: rgba(255, 255, 255, 0.95);
            font-size: 11px;
