{% block javascripts %}
    {{ parent() }}
    <script src="https://js.stripe.com/v3/"></script>
    <script>

       // ── AI Activity Assistant Chatbot ──
(function () {
    var AI_ASSISTANT_URL = '{{ path('app_activities_ai_assistant_reply') }}';

    var fab, chatWin, closeBtn, msgBox, inputEl, sendBtn, chipsEl;
    var history = [];
    var isBusy = false;
    var chatInitialized = false;
    var eventsBound = false;
    var createOverlayObserver = null;

    function initElements() {
        fab      = document.getElementById('aiChatFab');
        chatWin  = document.getElementById('aiChatWindow');
        closeBtn = document.getElementById('aiChatClose');
        msgBox   = document.getElementById('aiChatMessages');
        inputEl  = document.getElementById('aiChatInput');
        sendBtn  = document.getElementById('aiChatSend');
        chipsEl  = document.getElementById('aiChatChips');
        return !!(fab && chatWin && closeBtn && msgBox && inputEl && sendBtn && chipsEl);
    }

    function setFabVisibility() {
        var createOverlay = document.querySelector('.activity-create-overlay');
        if (!fab) {
            return;
        }

        if (createOverlay && createOverlay.classList.contains('show')) {
            fab.classList.add('visible');
            return;
        }

        fab.classList.remove('visible');
        if (chatWin) {
            chatWin.classList.remove('open');
        }
    }

    function syncFabVisibility() {
        var createOverlay = document.querySelector('.activity-create-overlay');
        setFabVisibility();
        if (!createOverlay || !fab) {
            return;
        }

        if (createOverlayObserver) {
            createOverlayObserver.disconnect();
        }

        createOverlayObserver = new MutationObserver(function () {
            setFabVisibility();
        });
        createOverlayObserver.observe(createOverlay, { attributes: true, attributeFilter: ['class'] });
    }

    function addMessage(text, role) {
        var div = document.createElement('div');
        div.className = 'ai-msg ' + (role === 'user' ? 'from-user' : 'from-ai');
        var applyMatch = text.match(/\[APPLY:(\w+)\]/i);
        var cleanText  = text.replace(/\[APPLY:\w+\]/gi, '').trim();
        div.textContent = cleanText;
        if (applyMatch) {
            var field = String(applyMatch[1] || '').toLowerCase();
            var applyBtn = document.createElement('button');
            applyBtn.className   = 'ai-apply-btn';
            applyBtn.textContent = '⬆ Apply to ' + field + ' field';
            applyBtn.addEventListener('click', function () {
                applyToForm(field, cleanText);
                applyBtn.textContent = '✓ Applied!';
                applyBtn.disabled = true;
            });
            div.appendChild(document.createElement('br'));
            div.appendChild(applyBtn);
        }
        msgBox.appendChild(div);
        msgBox.scrollTop = msgBox.scrollHeight;
        return div;
    }

    function addTyping() {
        var div = document.createElement('div');
        div.className = 'ai-msg typing-indicator';
        div.id = 'aiTyping';
        div.innerHTML = '<span>Thinking</span><span class="ai-typing-dots"><span></span><span></span><span></span></span>';
        msgBox.appendChild(div);
        msgBox.scrollTop = msgBox.scrollHeight;
    }

    function removeTyping() {
        var el = document.getElementById('aiTyping');
        if (el) el.remove();
    }

    function applyToForm(field, text) {
        var fieldMap = {
            title:       '#create-title',
            description: '#create-description',
            location:    '#create-location',
            category:    '#create-category'
        };
        var normalizedField = String(field || '').toLowerCase();
        var el = document.querySelector(fieldMap[normalizedField]);
        if (el) {
            el.value = text;
            el.dispatchEvent(new Event('input'));
            el.focus();
            el.style.transition = 'box-shadow 0.3s';
            el.style.boxShadow = '0 0 0 3px rgba(15,165,162,0.35)';
            setTimeout(function () { el.style.boxShadow = ''; }, 1400);
        }
    }

    function getFormContextValues() {
        var title    = document.querySelector('#create-title');
        var location = document.querySelector('#create-location');
        var category = document.querySelector('#create-category');

        return {
            title: title && title.value ? title.value.trim() : '',
            location: location && location.value ? location.value.trim() : '',
            category: category && category.value ? category.value.trim() : ''
        };
    }

    async function sendMessage(userText) {
        if (isBusy || !userText.trim()) return;
        isBusy = true;
        sendBtn.disabled = true;
        addMessage(userText, 'user');
        history.push({ role: 'user', content: userText });
        inputEl.value = '';
        inputEl.style.height = '';
        addTyping();
        var formContext = getFormContextValues();
        try {
            var response = await fetch(AI_ASSISTANT_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    history: history,
                    formContext: formContext
                })
            });

            var data = await response.json().catch(function () { return {}; });
            if (!response.ok || !data || data.success === false) {
                throw new Error(data && data.message ? data.message : ('API error ' + response.status));
            }

            var reply = data.reply ? String(data.reply) : 'Sorry, I could not generate a response.';
            removeTyping();
            addMessage(reply, 'ai');
            history.push({ role: 'assistant', content: reply });
        } catch (err) {
            removeTyping();
            addMessage('Oops — could not reach Grok right now. (' + (err.message || '') + ')', 'ai');
        } finally {
            isBusy = false;
            sendBtn.disabled = false;
            inputEl.focus();
        }
    }

    function initChat() {
        if (chatInitialized) return;
        chatInitialized = true;
        history = [];
        msgBox.innerHTML = '';
        addMessage('Hi! 👋 I can help you write descriptions, suggest locations in Tunisia, recommend pricing, seasons, and more. What would you like help with?', 'ai');
