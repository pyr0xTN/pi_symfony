            background: #ffe9ec;
            border-color: #ffccd4;
            color: #c03b4d;
        }

        .menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(3, 30, 58, 0.40);
            backdrop-filter: blur(2px);
            z-index: 999;
        }

        .menu-overlay.show {
            display: block;
        }

        .top-bar {
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(10px);
            padding: 16px 28px;
            box-shadow: 0 8px 24px rgba(10, 46, 88, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: none;
        }

        .logo {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            height: 40px;
            width: auto;
            display: flex;
            align-items: center;
        }

        .logo img {
            height: 100%;
