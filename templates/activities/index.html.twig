            async function openReservationsModal(url, fallbackTitle) {
                if (!reservationsOverlay || !reservationsBody) {
                    return;
                }

                if (reservationsTitle) {
                    reservationsTitle.textContent = 'Reservations - ' + (fallbackTitle || 'Activity');
                }

                reservationsBody.innerHTML = '';
                showReservationsMessage('Chargement des reservations...');
                reservationsOverlay.classList.add('show');

                try {
                    const response = await fetch(url, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json().catch(function () { return {}; });
                    if (!response.ok || !data.success) {
                        throw new Error((data && data.message) ? data.message : 'Impossible de charger les reservations.');
                    }

                    if (reservationsTitle && data.activity && data.activity.titre) {
                        reservationsTitle.textContent = 'Reservations - ' + data.activity.titre;
                    }

                    if (reservationsMessage) {
                        reservationsMessage.classList.remove('show');
                    }

                    var rows = Array.isArray(data.reservations) ? data.reservations : [];
                    if (rows.length === 0) {
                        showReservationsMessage('Aucune reservation pour cette activite.');
                        return;
                    }

                    reservationsBody.innerHTML = rows.map(function (row) {
                        var usernameSuffix = row.username ? ' <small>(' + escapeHtml(row.username) + ')</small>' : '';
                        var avatarHtml = '<img src="' + escapeHtml(row.avatarUrl) + '" alt="' + escapeHtml(row.fullName) + '" class="reservations-avatar" />';
                        return '<tr>'
                            + '<td class="reservations-avatar-cell">' + avatarHtml + '</td>'
                            + '<td>' + escapeHtml(row.fullName || '-') + usernameSuffix + '</td>'
                            + '<td>' + escapeHtml(row.email || '-') + '</td>'
                            + '<td>' + escapeHtml(row.nbPlaces || 0) + '</td>'
                            + '<td>' + escapeHtml(row.montantTotal || '0') + ' DT</td>'
                            + '<td>' + escapeHtml(row.statut || '-') + '</td>'
                            + '<td>' + escapeHtml(row.dateAchat || '-') + '</td>'
                            + '</tr>';
                    }).join('');
                } catch (e) {
                    showReservationsMessage(e && e.message ? e.message : 'Erreur de chargement des reservations.');
                }
