        }

        .activity-card.activity-card--inactive:hover {
            opacity: 0.72;
        }

        .activity-owner-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            background: rgba(56, 189, 248, 0.95);
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.02em;
            box-shadow: 0 10px 20px rgba(56, 189, 248, 0.32);
            text-transform: uppercase;
        }

        .activity-new-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            background: linear-gradient(135deg, #ffd24d 0%, #f5b301 100%);
            color: #5a3b00;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.03em;
            box-shadow: 0 10px 20px rgba(245, 179, 1, 0.35);
            text-transform: uppercase;
            overflow: hidden;
            isolation: isolate;
        }


        .activity-new-badge::after {
            content: '';
            position: absolute;
            top: -40%;
            left: -55%;
            width: 45%;
            height: 180%;
            background: linear-gradient(120deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.65) 45%, rgba(255, 255, 255, 0) 100%);
            transform: rotate(18deg);
            animation: newBadgeShine 2.6s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes newBadgeShine {
            0% {
                left: -55%;
            }
            60% {
                left: 125%;
            }
            100% {
                left: 125%;
            }
        }

        .activity-admin-delete-form {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 3;
        }

        .activity-admin-delete-btn {
            width: 30px;
