{% block javascripts %}
    {{ parent() }}
    <script>
        window.closeActivityModal = function () {
            var activityModalOverlay = document.querySelector('.activity-modal-overlay');
            if (activityModalOverlay) {
                activityModalOverlay.classList.remove('show');
            }
        };

        window.closeActivityEditModal = function () {
            var editModalOverlay = document.querySelector('.activity-edit-overlay');
            if (editModalOverlay) {
                editModalOverlay.classList.remove('show');
            }
        };

        window.closeActivityCreateModal = function () {
            var createModalOverlay = document.querySelector('.activity-create-overlay');
            if (createModalOverlay) {
                createModalOverlay.classList.remove('show');
            }
        };

        window.openActivityModal = function (button) {
            var activityModalOverlay = document.querySelector('.activity-modal-overlay');
            var activityModalReserve = document.querySelector('.activity-modal-reserve');
            var activityModalTitle = document.querySelector('.js-activity-modal-title');
            var activityModalImage = document.querySelector('.js-activity-modal-image');
            var activityModalDescription = document.querySelector('.js-activity-modal-description');
            var activityModalGuideImage = document.querySelector('.js-activity-modal-guide-image');
            var activityModalGuideName = document.querySelector('.js-activity-modal-guide-name');
            var activityModalFields = {
                location: document.querySelector('.js-activity-modal-location'),
                category: document.querySelector('.js-activity-modal-category'),
                places: document.querySelector('.js-activity-modal-places'),
                price: document.querySelector('.js-activity-modal-price'),
                status: document.querySelector('.js-activity-modal-status'),
                date: document.querySelector('.js-activity-modal-date'),
                duration: document.querySelector('.js-activity-modal-duration')
            };

            if (!activityModalOverlay || !button) {
                return;
            }

            if (activityModalTitle) {
                activityModalTitle.textContent = button.dataset.title || 'Activity';
            }
            if (activityModalImage) {
                activityModalImage.src = button.dataset.image || '';
                activityModalImage.alt = button.dataset.title || 'Activity';
            }
            if (activityModalDescription) {
                activityModalDescription.textContent = button.dataset.description || '';
            }
            if (activityModalGuideImage) {
                activityModalGuideImage.src = button.dataset.guideImage || '';
                activityModalGuideImage.alt = button.dataset.guideName || 'Guide';
            }
            if (activityModalGuideName) {
                activityModalGuideName.textContent = button.dataset.guideName || 'Guide';
            }

            if (activityModalFields.location) {
                activityModalFields.location.textContent = button.dataset.location || '-';
            }
            if (activityModalFields.category) {
                activityModalFields.category.textContent = button.dataset.category || '-';
            }
            if (activityModalFields.places) {
                activityModalFields.places.textContent = button.dataset.places || '-';
            }
            if (activityModalFields.price) {
                activityModalFields.price.textContent = (button.dataset.price || '-') + ' coins';
            }
            if (activityModalFields.status) {
                activityModalFields.status.textContent = button.dataset.status || '-';
            }
            if (activityModalFields.date) {
                activityModalFields.date.textContent = button.dataset.date || '-';
            }
            if (activityModalFields.duration) {
                activityModalFields.duration.textContent = (button.dataset.duration || '-') + ' h';
            }

            if (activityModalReserve) {
                activityModalReserve.setAttribute('data-amount', button.dataset.price || '0');
                activityModalReserve.setAttribute('data-activity-title', button.dataset.title || 'Activity');
            }

            activityModalOverlay.classList.add('show');
        };

        window.openActivityEditModal = function (button) {
            if (!button) {
                return;
            }

            var editModalOverlay = document.querySelector('.activity-edit-overlay');
            var editForm = document.querySelector('.js-activity-edit-form');
            if (!editModalOverlay || !editForm) {
                return;
            }

            editForm.action = button.dataset.editUrl || '';

            var fieldMap = {
                title: '.js-edit-title',
                description: '.js-edit-description',
                location: '.js-edit-location',
                category: '.js-edit-category',
                status: '.js-edit-status',
                dateInput: '.js-edit-date',
                duration: '.js-edit-duration',
                price: '.js-edit-price',
                places: '.js-edit-places',
                token: '.js-edit-token'
            };

            Object.keys(fieldMap).forEach(function (key) {
                var field = document.querySelector(fieldMap[key]);
                if (field) {
                    field.value = button.dataset[key] || '';
                }
            });

            editModalOverlay.classList.add('show');
        };

        window.openActivityCreateModal = function () {
            var createModalOverlay = document.querySelector('.activity-create-overlay');
            var createForm = document.querySelector('.js-activity-create-form');
            if (!createModalOverlay || !createForm) {
                return;
            }

            createForm.reset();
            createModalOverlay.classList.add('show');
        };

        window.closePaymentModal = function () {
            var paymentOverlay = document.querySelector('.payment-overlay');
            var paymentForm = document.querySelector('.js-payment-form');
            var paymentSuccess = document.querySelector('.js-payment-success');
            if (paymentOverlay) {
                paymentOverlay.classList.remove('show');
            }
            if (paymentForm) {
                paymentForm.reset();
            }
            if (paymentSuccess) {
                paymentSuccess.classList.remove('show');
            }
        };

        window.openPaymentModal = function (amount, activityTitle) {
            var paymentOverlay = document.querySelector('.payment-overlay');
            var amountLabel = document.querySelector('.js-payment-amount');
            var titleLabel = document.querySelector('.js-payment-activity-title');
            var cardNumberDisplay = document.querySelector('.js-card-number-display');
            var cardHolderDisplay = document.querySelector('.js-card-holder-display');
            var cardExpiryDisplay = document.querySelector('.js-card-expiry-display');

            if (!paymentOverlay) {
                return;
            }

            if (amountLabel) {
                amountLabel.textContent = (amount || '0') + ' DT';
            }
            if (titleLabel) {
                titleLabel.textContent = activityTitle || 'Activity';
            }
            if (cardNumberDisplay) {
                cardNumberDisplay.textContent = '•••• •••• •••• ••••';
            }
            if (cardHolderDisplay) {
                cardHolderDisplay.textContent = 'VOTRE NOM';
            }
            if (cardExpiryDisplay) {
                cardExpiryDisplay.textContent = 'MM/AA';
            }

            paymentOverlay.classList.add('show');
        };

        document.addEventListener('DOMContentLoaded', function () {
            var menuToggle = document.querySelector('.menu-toggle');
            var sideMenu = document.querySelector('.side-menu');
            var overlay = document.querySelector('.menu-overlay');
            var activityModalOverlay = document.querySelector('.activity-modal-overlay');
            var activityModalClose = document.querySelector('.activity-modal-close');
            var editModalOverlay = document.querySelector('.activity-edit-overlay');
            var editModalClose = document.querySelector('.activity-edit-close');
            var createModalOverlay = document.querySelector('.activity-create-overlay');
            var createModalClose = document.querySelector('.activity-create-close');
            var paymentOverlay = document.querySelector('.payment-overlay');
            var paymentClose = document.querySelector('.payment-close');
            var reserveButton = document.querySelector('.activity-modal-reserve');
            var paymentForm = document.querySelector('.js-payment-form');
            var paymentCardNumber = document.querySelector('.js-payment-card-number');
            var paymentCardHolder = document.querySelector('.js-payment-card-holder');
            var paymentCardExpiry = document.querySelector('.js-payment-card-expiry');
            var paymentCardCvv = document.querySelector('.js-payment-card-cvv');
            var cardNumberDisplay = document.querySelector('.js-card-number-display');
            var cardHolderDisplay = document.querySelector('.js-card-holder-display');
            var cardExpiryDisplay = document.querySelector('.js-card-expiry-display');
            var paymentSuccess = document.querySelector('.js-payment-success');
            var errorCardNumber = document.querySelector('.js-payment-error-number');
            var errorCardHolder = document.querySelector('.js-payment-error-holder');
            var errorCardExpiry = document.querySelector('.js-payment-error-expiry');
            var errorCardCvv = document.querySelector('.js-payment-error-cvv');

            function closeMenu() {
                if (sideMenu) {
                    sideMenu.classList.remove('open');
                }
                if (overlay) {
                    overlay.classList.remove('show');
                }
            }

            if (menuToggle && sideMenu && overlay) {
                menuToggle.addEventListener('click', function () {
                    sideMenu.classList.toggle('open');
                    overlay.classList.toggle('show');
                });

                overlay.addEventListener('click', closeMenu);
            }

            if (activityModalClose) {
                activityModalClose.addEventListener('click', closeActivityModal);
            }

            if (activityModalOverlay) {
                activityModalOverlay.addEventListener('click', function (event) {
                    if (event.target === activityModalOverlay) {
                        closeActivityModal();
                    }
                });
            }

            if (editModalClose) {
                editModalClose.addEventListener('click', closeActivityEditModal);
            }

            if (editModalOverlay) {
                editModalOverlay.addEventListener('click', function (event) {
                    if (event.target === editModalOverlay) {
                        closeActivityEditModal();
                    }
                });
            }

            if (createModalClose) {
                createModalClose.addEventListener('click', closeActivityCreateModal);
            }

            if (createModalOverlay) {
                createModalOverlay.addEventListener('click', function (event) {
                    if (event.target === createModalOverlay) {
                        closeActivityCreateModal();
                    }
                });
            }

            if (paymentClose) {
                paymentClose.addEventListener('click', closePaymentModal);
            }

            if (paymentOverlay) {
                paymentOverlay.addEventListener('click', function (event) {
                    if (event.target === paymentOverlay) {
                        closePaymentModal();
                    }
                });
            }

            if (reserveButton) {
                reserveButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    var amount = reserveButton.getAttribute('data-amount') || '0';
                    var activityTitle = reserveButton.getAttribute('data-activity-title') || 'Activity';
                    openPaymentModal(amount, activityTitle);
                });
            }

            function formatCardNumber(value) {
                var digits = String(value || '').replace(/\D/g, '').slice(0, 16);
                return digits.replace(/(.{4})/g, '$1 ').trim();
            }

            function formatExpiry(value) {
                var digits = String(value || '').replace(/\D/g, '').slice(0, 4);
                if (digits.length <= 2) {
                    return digits;
                }
                return digits.slice(0, 2) + '/' + digits.slice(2);
            }

            if (paymentCardNumber) {
                paymentCardNumber.addEventListener('input', function () {
                    paymentCardNumber.value = formatCardNumber(paymentCardNumber.value);
                    if (cardNumberDisplay) {
                        cardNumberDisplay.textContent = paymentCardNumber.value || '•••• •••• •••• ••••';
                    }
                    if (errorCardNumber) {
                        errorCardNumber.classList.remove('show');
                    }
                });
            }

            if (paymentCardHolder) {
                paymentCardHolder.addEventListener('input', function () {
                    if (cardHolderDisplay) {
                        cardHolderDisplay.textContent = paymentCardHolder.value || 'VOTRE NOM';
                    }
                    if (errorCardHolder) {
                        errorCardHolder.classList.remove('show');
                    }
                });
            }

            if (paymentCardExpiry) {
                paymentCardExpiry.addEventListener('input', function () {
                    paymentCardExpiry.value = formatExpiry(paymentCardExpiry.value);
                    if (cardExpiryDisplay) {
                        cardExpiryDisplay.textContent = paymentCardExpiry.value || 'MM/AA';
                    }
                    if (errorCardExpiry) {
                        errorCardExpiry.classList.remove('show');
                    }
                });
            }

            if (paymentCardCvv) {
                paymentCardCvv.addEventListener('input', function () {
                    paymentCardCvv.value = String(paymentCardCvv.value || '').replace(/\D/g, '').slice(0, 4);
                    if (errorCardCvv) {
                        errorCardCvv.classList.remove('show');
                    }
                });
            }

            if (paymentForm) {
                paymentForm.addEventListener('submit', function (event) {
                    event.preventDefault();

                    var rawNumber = String(paymentCardNumber ? paymentCardNumber.value : '').replace(/\s/g, '');
                    var holder = String(paymentCardHolder ? paymentCardHolder.value : '').trim();
                    var expiry = String(paymentCardExpiry ? paymentCardExpiry.value : '').trim();
                    var cvv = String(paymentCardCvv ? paymentCardCvv.value : '').trim();
                    var expiryOk = /^(0[1-9]|1[0-2])\/[0-9]{2}$/.test(expiry);

                    var isValid = true;
                    if (errorCardNumber) {
                        var numberInvalid = rawNumber.length < 13 || rawNumber.length > 19;
                        errorCardNumber.classList.toggle('show', numberInvalid);
                        if (numberInvalid) {
                            isValid = false;
                        }
                    }
                    if (errorCardHolder) {
                        var holderInvalid = holder.length < 3;
                        errorCardHolder.classList.toggle('show', holderInvalid);
                        if (holderInvalid) {
                            isValid = false;
                        }
                    }
                    if (errorCardExpiry) {
                        errorCardExpiry.classList.toggle('show', !expiryOk);
                        if (!expiryOk) {
                            isValid = false;
                        }
                    }
                    if (errorCardCvv) {
                        var cvvInvalid = !/^\d{3,4}$/.test(cvv);
                        errorCardCvv.classList.toggle('show', cvvInvalid);
                        if (cvvInvalid) {
                            isValid = false;
                        }
                    }

                    if (!isValid) {
                        return;
                    }

                    if (paymentSuccess) {
                        paymentSuccess.classList.add('show');
                    }

                    window.setTimeout(function () {
                        closePaymentModal();
                        closeActivityModal();
                    }, 1200);
                });
            }

            document.querySelectorAll('.js-open-activity-modal').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityModal(button);
                });
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeActivityModal();
                    closeActivityEditModal();
                    closeActivityCreateModal();
                    closePaymentModal();
                }
            });

            document.querySelectorAll('.js-open-activity-edit').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityEditModal(button);
                });
            });

            var addNewButton = document.querySelector('.js-open-activity-create');
            if (addNewButton) {
                addNewButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityCreateModal();
                });
            }

            var guideFilterToggle = document.querySelector('.js-guide-activities-toggle');
            var activitiesEmptyFilter = document.querySelector('.js-activities-empty-filter');
            var activityCards = Array.prototype.slice.call(document.querySelectorAll('.activity-card'));

            function applyActivityFilters() {
                var guideFilterActive = guideFilterToggle && guideFilterToggle.getAttribute('data-filter-active') === '1';
                var visibleCards = 0;

                activityCards.forEach(function (card) {
                    var isMine = card.getAttribute('data-is-my-activity') === '1';
                    var hiddenByGuideFilter = guideFilterActive && !isMine;
                    var shouldHide = hiddenByGuideFilter;
                    card.style.display = shouldHide ? 'none' : '';
                    if (!shouldHide) {
                        visibleCards += 1;
                    }
                });

                if (activitiesEmptyFilter) {
                    activitiesEmptyFilter.style.display = visibleCards === 0 ? 'block' : 'none';
                }
            }

            if (guideFilterToggle) {
                guideFilterToggle.addEventListener('click', function () {
                    var nextState = guideFilterToggle.getAttribute('data-filter-active') !== '1';
                    guideFilterToggle.classList.toggle('active', nextState);
                    guideFilterToggle.setAttribute('aria-pressed', nextState ? 'true' : 'false');
                    guideFilterToggle.setAttribute('data-filter-active', nextState ? '1' : '0');
                    guideFilterToggle.setAttribute('title', nextState ? 'Show all activities' : 'Show only my activities');
                    applyActivityFilters();
                });
            }

            applyActivityFilters();

            document.querySelectorAll('.nav-tab[data-view]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var view = tab.getAttribute('data-view');
                    if (!view) {
                        return;
                    }

                    // Keep the same module-driven navigation behavior as mainpage.
                    window.location.href = '{{ path('app_mainpage') }}?module=' + encodeURIComponent(view);
                });
            });

            document.querySelectorAll('.side-menu-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    var action = button.getAttribute('data-action');
                    if (action === 'logout') {
                        window.location.href = '{{ path('app_logout') }}';
                    } else if (action === 'dashboard') {
                        window.location.href = '{{ path('app_dashboard') }}';
                    } else if (action === 'guide-dashboard') {
                        window.location.href = '{{ path('app_guide_dashboard') }}';
                    } else if (action === 'reservations') {
                        window.location.href = '{{ path('app_reservations') }}';
                    } else if (action === 'my-reservations') {
                        window.location.href = '{{ path('app_my_reservations') }}';
                    } else if (action === 'my-orders') {
                        window.location.href = '{{ path('app_my_orders') }}';
                    } else if (action === 'offers-grid') {
                        window.location.href = '{{ path('app_offers_grid') }}';
                    }
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
    {% set userRoleLabel = 'main.role.member'|trans %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set userRoleLabel = 'main.role.administrator'|trans %}
    {% elseif is_granted('ROLE_GUIDE') %}
        {% set userRoleLabel = 'main.role.guide'|trans %}
    {% endif %}

    <div class="menu-overlay"></div>

    <div class="side-menu">
        <div class="side-menu-content">
            <div class="user-info">
                <div class="avatar">{{ app.user.username|first|upper }}</div>
                <p class="user-name">{{ app.user.fullName|default(app.user.username) }}</p>
                <p class="user-role">{{ userRoleLabel }}</p>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <button class="side-menu-btn" data-action="dashboard">🏠 {{ 'main.menu.dashboard'|trans }}</button>
            {% endif %}

            {% if is_granted('ROLE_GUIDE') %}
                <button class="side-menu-btn" data-action="guide-dashboard">👤 {{ 'main.menu.guide_dashboard'|trans }}</button>
            {% endif %}

            <button class="side-menu-btn" data-action="my-reservations">👤 {{ 'main.menu.my_reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="my-orders">🧾 {{ 'main.menu.my_orders'|trans }}</button>
            <button class="side-menu-btn" data-action="reservations">💻 {{ 'main.menu.reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="offers-grid">📋 {{ 'main.menu.offers_grid'|trans }}</button>

            <button class="side-menu-btn logout-btn" data-action="logout">Logout</button>
        </div>
    </div>

    <div class="main-container">
        <div style="flex: 1;">
            <div class="top-bar">
                <div style="display: flex; align-items: center;">
                    <button class="menu-toggle" type="button" aria-label="Toggle menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <div class="logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna.tn" title="Rehletna.tn" />
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="profile-section">
                        <div class="profile-info">
                            <p class="profile-name">{{ app.user.fullName|default(app.user.username) }}</p>
                            <p class="profile-role">{{ userRoleLabel }}</p>
                        </div>
                        <div class="profile-avatar">
                            {{ app.user.username|first|upper }}
                            <div class="online-status"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-tabs">
                <button class="nav-tab active" data-view="services">💻 {{ 'main.tab.services'|trans }}</button>
                                <a class="nav-tab" href="{{ path('app_activities') }}">🏞 {{ 'main.tab.activities'|trans }}</a>
                <button class="nav-tab" data-view="shop">🛒 {{ 'main.tab.shop'|trans }}</button>
                <button class="nav-tab" data-view="ai-guide">🤖 {{ 'main.tab.ai_guide'|trans }}</button>
                <button class="nav-tab" data-view="offers">🔖 {{ 'main.tab.offers'|trans }}</button>
                <button class="nav-tab" data-view="messenger">💬 {{ 'main.tab.messenger'|trans }}</button>
                <button class="nav-tab" data-view="post">✉️ Posts</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-tab" href="{{ path('app_admin_stats') }}">📊 {{ 'main.tab.stats'|trans }}</a>
                {% endif %}
            </div>

            <div class="content-area">
                <div class="activities-module">
                    <div class="activities-head">
                        <div>
                            <h2>Activities</h2>
                            <p>{{ activities|length }} activities loaded from the database.</p>
                        </div>
                        <div class="activities-head-actions">
                            <span class="activities-pill">{{ activities|length }} total</span>
                            <form class="activities-search-form" method="get" action="{{ path('app_activities') }}">
                                <input
                                    type="text"
                                    name="q"
                                    value="{{ currentSearch|default('') }}"
                                    class="activities-search"
                                    placeholder="Search by activity name or place"
                                    aria-label="Search activities by name or place"
                                >
                                <button type="submit" class="activities-search-btn">Search</button>
                            </form>
                            {% if is_granted('ROLE_GUIDE') %}
                                <button
                                    type="button"
                                    class="activities-pill activities-filter-guide js-guide-activities-toggle"
                                    data-filter-active="0"
                                    aria-pressed="false"
                                    title="Show only my activities"
                                >
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 5h18"></path>
                                        <path d="M6 12h12"></path>
                                        <path d="M10 19h4"></path>
                                    </svg>
                                    <span>My activities</span>
                                </button>
                                <button
                                    type="button"
                                    class="activities-pill activities-add-new js-open-activity-create"
                                    title="Add a new activity"
                                >
                                    <span>+ Add new</span>
                                </button>
                            {% endif %}
                            <a class="activities-pill" href="{{ path('app_mainpage') }}">Back to main</a>
                        </div>
                    </div>

                    <div class="activities-grid">
                        {% for activity in activities %}
                            {% set status = activity.statut|default('')|lower %}
                            {% set isMyActivity = is_granted('ROLE_GUIDE') and app.user and activity.idGuide is not null and activity.idGuide == app.user.id %}
                            <article class="activity-card" data-is-my-activity="{{ isMyActivity ? '1' : '0' }}" data-title="{{ activity.titre|default('')|e('html_attr') }}">
                                {% if isMyActivity %}
                                    <div class="activity-owner-badge">My activity</div>
                                {% endif %}
                                <img class="activity-image" src="{{ activity.image_url }}" alt="{{ activity.titre }}">
                                <div class="activity-body">
                                    <h3 class="activity-title">{{ activity.titre }}</h3>
                                    <div class="activity-meta">
                                        <span class="activity-tag">{{ activity.categorie|default('Activity') }}</span>
                                        <span class="activity-tag">{{ activity.lieu }}</span>
                                    </div>
                                    <div class="activity-description">
                                        {{ activity.description|length > 120 ? activity.description|slice(0, 120) ~ '...' : activity.description }}
                                    </div>
                                    <div class="activity-meta">
                                        <span class="activities-badge neutral">{{ activity.placesDisponibles }} places</span>
                                        <span class="activities-badge {{ status == 'actif' ? 'active' : 'inactive' }}">{{ activity.statut }}</span>
                                    </div>
                                    <div class="activity-foot">
                                        <div class="activity-price">{{ activity.prix }} coins</div>
                                        <div class="activity-foot-right">
                                            {% if isMyActivity %}
                                                <button
                                                    type="button"
                                                    class="activity-edit js-open-activity-edit"
                                                    onclick="window.openActivityEditModal(this); return false;"
                                                    data-title="{{ activity.titre|e('html_attr') }}"
                                                    data-description="{{ activity.description|e('html_attr') }}"
                                                    data-location="{{ activity.lieu|e('html_attr') }}"
                                                    data-category="{{ activity.categorie|default('')|e('html_attr') }}"
                                                    data-status="{{ activity.statut|default('Actif')|e('html_attr') }}"
                                                    data-date-input="{{ activity.dateActivite ? activity.dateActivite|date('Y-m-d\\TH:i') : '' }}"
                                                    data-duration="{{ activity.dureParJour|default(0) }}"
                                                    data-price="{{ activity.prix|default(0) }}"
                                                    data-places="{{ activity.placesDisponibles|default(0) }}"
                                                    data-edit-url="{{ path('app_activities_edit', { id: activity.idActivite }) }}"
                                                    data-token="{{ csrf_token('edit_activity_' ~ activity.idActivite) }}"
                                                >Edit</button>
                                                <form
                                                    method="post"
                                                    action="{{ path('app_activities_delete', { id: activity.idActivite }) }}"
                                                    class="activity-delete-form"
                                                    onsubmit="return window.confirm('Delete this activity?');"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_activity_' ~ activity.idActivite) }}">
                                                    <button type="submit" class="activity-delete">Delete</button>
                                                </form>
                                            {% else %}
                                                <button
                                                    type="button"
                                                    class="activity-view js-open-activity-modal"
                                                    onclick="window.openActivityModal(this); return false;"
                                                    data-title="{{ activity.titre|e('html_attr') }}"
                                                    data-description="{{ activity.description|e('html_attr') }}"
                                                    data-location="{{ activity.lieu|e('html_attr') }}"
                                                    data-category="{{ activity.categorie|default('-')|e('html_attr') }}"
                                                    data-places="{{ activity.placesDisponibles }}"
                                                    data-price="{{ activity.prix }}"
                                                    data-status="{{ activity.statut|e('html_attr') }}"
                                                    data-date="{{ activity.dateActivite ? activity.dateActivite|date('d M Y H:i') : '-' }}"
                                                    data-duration="{{ activity.dureParJour }}"
                                                    data-image="{{ activity.image_url|e('html_attr') }}"
                                                    data-guide-name="{{ activity.guide_display_name|e('html_attr') }}"
                                                    data-guide-image="{{ activity.guide_image_url|e('html_attr') }}"
                                                >View</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </article>
                        {% else %}
                            <div class="activities-empty">No activities found with that name.</div>
                        {% endfor %}
                    </div>
                    <div class="activities-empty js-activities-empty-filter" style="display: none;">No activities match.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="activity-modal-overlay">
        <div class="activity-modal" role="dialog" aria-modal="true" aria-labelledby="activityModalTitle">
            <div class="activity-modal-head">
                <h3 class="activity-modal-title js-activity-modal-title" id="activityModalTitle">Activity</h3>
                <button type="button" class="activity-modal-close" aria-label="Close" onclick="window.closeActivityModal(); return false;">&times;</button>
            </div>

            <div class="activity-modal-body">
                <img class="activity-modal-image js-activity-modal-image" src="" alt="Activity image">

                <div class="activity-modal-info">
                    <p class="activity-modal-desc js-activity-modal-description"></p>

                    <div class="activity-modal-grid">
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Location</span>
                            <span class="activity-modal-value js-activity-modal-location"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Category</span>
                            <span class="activity-modal-value js-activity-modal-category"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Places</span>
                            <span class="activity-modal-value js-activity-modal-places"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Price</span>
                            <span class="activity-modal-value js-activity-modal-price"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Status</span>
                            <span class="activity-modal-value js-activity-modal-status"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Date</span>
                            <span class="activity-modal-value js-activity-modal-date"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Duration</span>
                            <span class="activity-modal-value js-activity-modal-duration"></span>
                        </div>
                    </div>

                    <div class="activity-guide-box">
                        <img class="activity-guide-avatar js-activity-modal-guide-image" src="" alt="Guide profile picture">
                        <div>
                            <span class="activity-modal-label">Guide</span>
                            <p class="activity-guide-name js-activity-modal-guide-name"></p>
                        </div>
                    </div>

                    <div class="activity-modal-actions">
                        <button type="button" class="activity-modal-reserve" data-amount="0" data-activity-title="Activity">Reserver</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="payment-overlay">
        <div class="payment-modal" role="dialog" aria-modal="true" aria-labelledby="paymentTitle">
            <div class="payment-head">
                <h3 class="payment-title" id="paymentTitle">Paiement</h3>
                <button type="button" class="activity-modal-close payment-close" aria-label="Close" onclick="window.closePaymentModal(); return false;">&times;</button>
            </div>

            <div class="payment-amount">
                <span class="js-payment-activity-title">Activity</span>
                <strong class="js-payment-amount">0 DT</strong>
            </div>

            <div class="payment-card" aria-hidden="true">
                <div class="payment-card-row">
                    <span class="payment-chip"></span>
                    <span class="payment-brand" aria-hidden="true">
                        <span class="payment-brand-dot red"></span>
                        <span class="payment-brand-dot yellow"></span>
                        <span class="payment-brand-text">card</span>
                    </span>
                </div>
                <p class="payment-card-number js-card-number-display">•••• •••• •••• ••••</p>
                <div class="payment-card-meta">
                    <span>Card Holder<span class="payment-card-value js-card-holder-display">VOTRE NOM</span></span>
                    <span>Expire<span class="payment-card-value js-card-expiry-display">MM/AA</span></span>
                </div>
            </div>

            <div class="payment-success js-payment-success">Payment confirmed successfully.</div>

            <form class="payment-form js-payment-form" novalidate>
                <div class="payment-field">
                    <label class="payment-label" for="pay-card-number">Numero de carte</label>
                    <input class="payment-input js-payment-card-number" id="pay-card-number" type="text" inputmode="numeric" autocomplete="cc-number" placeholder="0000 0000 0000 0000" required>
                    <span class="payment-error js-payment-error-number">Numero de carte invalide.</span>
                </div>

                <div class="payment-field">
                    <label class="payment-label" for="pay-card-holder">Nom du titulaire</label>
                    <input class="payment-input js-payment-card-holder" id="pay-card-holder" type="text" autocomplete="cc-name" placeholder="PRENOM NOM" required>
                    <span class="payment-error js-payment-error-holder">Nom requis.</span>
                </div>

                <div class="payment-split">
                    <div class="payment-field">
                        <label class="payment-label" for="pay-card-expiry">Expiration</label>
                        <input class="payment-input js-payment-card-expiry" id="pay-card-expiry" type="text" inputmode="numeric" autocomplete="cc-exp" placeholder="MM/AA" required>
                        <span class="payment-error js-payment-error-expiry">Date invalide.</span>
                    </div>
                    <div class="payment-field">
                        <label class="payment-label" for="pay-card-cvv">Code CVV</label>
                        <input class="payment-input js-payment-card-cvv" id="pay-card-cvv" type="password" inputmode="numeric" autocomplete="cc-csc" placeholder="***" required>
                        <span class="payment-error js-payment-error-cvv">CVV invalide.</span>
                    </div>
                </div>

                <div class="payment-actions">
                    <button type="submit" class="payment-confirm">Confirmer le paiement</button>
                    <button type="button" class="payment-cancel" onclick="window.closePaymentModal(); return false;">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div class="activity-edit-overlay">
        <div class="activity-edit-modal" role="dialog" aria-modal="true" aria-labelledby="activityEditTitle">
            <div class="activity-edit-head">
                <h3 class="activity-edit-title" id="activityEditTitle">Edit Activity</h3>
                <button type="button" class="activity-modal-close activity-edit-close" aria-label="Close" onclick="window.closeActivityEditModal(); return false;">&times;</button>
            </div>

            <form method="post" class="activity-edit-form js-activity-edit-form" action="{{ path('app_activities') }}">
                <input type="hidden" name="_token" class="js-edit-token" value="">

                <div class="activity-edit-field full">
                    <label class="activity-edit-label" for="edit-title">Title</label>
                    <input class="activity-edit-input js-edit-title" id="edit-title" type="text" name="title" required>
                </div>

                <div class="activity-edit-field full">
                    <label class="activity-edit-label" for="edit-description">Description</label>
                    <textarea class="activity-edit-textarea js-edit-description" id="edit-description" name="description" required></textarea>
