        function renderReviewCards(container, reviews) {
            if (!container) {
                return;
            }

            container.innerHTML = '';
            if (!Array.isArray(reviews) || reviews.length === 0) {
                var empty = document.createElement('div');
                empty.className = 'activity-review-empty';
                empty.textContent = 'No reviews yet. Be the first to share your experience!';
                container.appendChild(empty);
                return;
            }

            reviews.forEach(function (review) {
                var card = document.createElement('div');
                card.className = 'activity-review-item';

                var head = document.createElement('div');
                head.className = 'activity-review-item-head';

                var metaWrap = document.createElement('div');
                var title = document.createElement('div');
                title.className = 'activity-review-item-title';
                title.textContent = review.anonymousLabel || 'Anonymous traveler';

                var meta = document.createElement('div');
                meta.className = 'activity-review-item-meta';
                meta.textContent = review.timeAgo || review.createdAt || '';

                metaWrap.appendChild(title);
                metaWrap.appendChild(meta);

                if (review.displayName && review.displayName !== (review.anonymousLabel || 'Anonymous traveler')) {
                    var adminName = document.createElement('div');
                    adminName.className = 'activity-review-item-meta';
                    adminName.textContent = review.displayName;
                    metaWrap.appendChild(adminName);
                }

                head.appendChild(metaWrap);

                if (review.canDelete) {
                    var deleteButton = document.createElement('button');
                    deleteButton.type = 'button';
                    deleteButton.className = 'activity-review-delete js-delete-activity-review';
                    deleteButton.setAttribute('data-review-id', review.id || '0');
                    deleteButton.textContent = 'Delete';
                    head.appendChild(deleteButton);
                }

                var content = document.createElement('p');
                content.className = 'activity-review-content';
                content.textContent = review.content || '';

                card.appendChild(head);
                card.appendChild(content);
                container.appendChild(card);
            });
        }

        function syncReviewForms(myReview, canSubmit, reviewToken, statusMessage) {
            var form = document.querySelector('.js-activity-review-form');
            if (!form) {
                return;
            }

            var tokenField = form.querySelector('.js-activity-review-token');
            var inputField = form.querySelector('.js-activity-review-input');
            var submitButton = form.querySelector('.activity-review-submit');
            var statusField = form.querySelector('.js-activity-review-status');

            if (tokenField) {
                tokenField.value = reviewToken || '';
            }
            if (inputField) {
                inputField.value = myReview || '';
                inputField.disabled = !canSubmit;
                inputField.placeholder = canSubmit
                    ? 'Write your global review for this activity...'
                    : 'Review unlocks after the activity is completed.';
            }
            if (submitButton) {
                submitButton.disabled = !canSubmit;
            }
            if (statusField) {
                statusField.textContent = statusMessage !== undefined ? statusMessage : (canSubmit ? 'Review unlocked. You can write your feedback now.' : 'Complete this activity to unlock the review.');
            }

            var activityReviewLock = document.querySelector('.js-activity-review-lock');
            if (activityReviewLock) {
                activityReviewLock.textContent = canSubmit ? 'Review unlocked for this activity.' : 'Review unlocks after the activity is completed.';
            }
        }

        window.loadActivityReviewPanel = async function (activityId, reviewToken) {
            var activityReviewList = document.querySelector('.js-activity-review-list');

            currentReviewState.activityId = String(activityId || '');
            currentReviewState.reviewToken = String(reviewToken || '');
            currentReviewState.canSubmit = false;
            renderReviewCards(activityReviewList, []);
            syncReviewForms('', false, currentReviewState.reviewToken, 'Loading review access...');

            if (!currentReviewState.activityId) {
                return;
            }

            try {
                var response = await fetch(buildReviewUrl(reviewsApiBaseUrl, 'ACTIVITY_ID_PLACEHOLDER', currentReviewState.activityId), {
                    headers: { 'Accept': 'application/json' }
                });
                var data = await response.json();

                if (!response.ok || !data || data.success === false) {
                    throw new Error(data && data.message ? data.message : 'Unable to load reviews.');
                }

                currentReviewState.canSubmit = !!data.canSubmit;
                renderReviewCards(activityReviewList, data.reviews && Array.isArray(data.reviews) ? data.reviews : []);
                syncReviewForms(data.myReview || '', currentReviewState.canSubmit, currentReviewState.reviewToken);
            } catch (error) {
                renderReviewCards(activityReviewList, []);
                syncReviewForms('', false, currentReviewState.reviewToken, 'Unable to load reviews right now.');
            }
        };

        window.submitActivityReview = async function (form) {
            if (!form || !currentReviewState.activityId) {
                return;
            }

            var inputField = form.querySelector('.js-activity-review-input');
            var tokenField = form.querySelector('.js-activity-review-token');
            var statusField = form.querySelector('.js-activity-review-status');
            var submitButton = form.querySelector('.activity-review-submit');
            var content = inputField ? inputField.value.trim() : '';

            if (!content) {
                if (statusField) {
                    statusField.textContent = 'Write a review first.';
                }
                return;
            }

            if (submitButton) {
                submitButton.disabled = true;
            }
            if (statusField) {
                statusField.textContent = 'Posting...';
            }

            try {
                var response = await fetch(buildReviewUrl(reviewsSaveBaseUrl, 'ACTIVITY_ID_PLACEHOLDER', currentReviewState.activityId), {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    body: new URLSearchParams({
                        content: content,
                        _token: tokenField ? tokenField.value : currentReviewState.reviewToken
                    })
                });

                var data = await response.json();
                if (!response.ok || !data || data.success === false) {
                    throw new Error(data && data.message ? data.message : 'Unable to save review.');
                }

                if (statusField) {
                    statusField.textContent = data.message || 'Review posted.';
                }
                await window.loadActivityReviewPanel(currentReviewState.activityId, currentReviewState.reviewToken);
            } catch (error) {
                if (statusField) {
                    statusField.textContent = error && error.message ? error.message : 'Unable to save review.';
                }
            } finally {
                if (submitButton) {
                    submitButton.disabled = !currentReviewState.canSubmit;
                }
            }
        };

