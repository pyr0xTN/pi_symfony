        }

        .activities-card {
            padding: 28px;
            border-radius: 24px;
            background: #ffffff;
            box-shadow: 0 16px 34px rgba(7, 57, 107, 0.09);
        }

        .activities-module {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .activities-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 20px 22px;
            border-radius: 22px;
            background: linear-gradient(135deg, rgba(8, 97, 123, 0.96), rgba(14, 136, 161, 0.93));
            color: #fff;
            box-shadow: 0 18px 38px rgba(10, 52, 90, 0.2);
        }

        .activities-head h2 {
            margin: 0;
            font-size: clamp(28px, 3vw, 42px);
            line-height: 1.05;
        }

        .activities-head p {
            margin: 8px 0 0;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }

        .activities-head-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .activities-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.34);
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            white-space: nowrap;
            text-decoration: none;
        }

        .activities-filter-guide {
            cursor: pointer;
        }

        .activities-filter-guide svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
        }

        .activities-filter-guide.active {
            background: rgba(255, 255, 255, 0.28);
            border-color: rgba(255, 255, 255, 0.65);
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.22);
        }

        .activities-add-new {
            cursor: pointer;
        }

        .activities-search {
            border: 1px solid rgba(255, 255, 255, 0.45);
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.16);
            min-width: 220px;
            outline: none;
        }

        .activities-search-form {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .activities-search-btn {
            border: 1px solid rgba(255, 255, 255, 0.45);
            border-radius: 999px;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: 700;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.16);
            cursor: pointer;
        }

        .activities-search::placeholder {
            color: rgba(255, 255, 255, 0.9);
        }

        .activities-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            padding: 0 20px;
            box-sizing: border-box;
        }

        @media (max-width: 1400px) {
            .activities-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 1100px) {
            .activities-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 700px) {
            .activities-grid {
                grid-template-columns: 1fr;
            }
        }

