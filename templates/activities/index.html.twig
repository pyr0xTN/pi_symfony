            if (paymentPlaces) {
                paymentPlaces.addEventListener('input', function () {
                    var maxPlaces = parseInt((paymentForm && paymentForm.getAttribute('data-max-places')) || '1', 10);
                    var places = parseInt(paymentPlaces.value || '1', 10);

                    if (!Number.isFinite(places) || places < 1) {
                        places = 1;
                    }
                    if (Number.isFinite(maxPlaces) && maxPlaces > 0 && places > maxPlaces) {
                        places = maxPlaces;
                    }

                    paymentPlaces.value = String(places);
                    if (errorPaymentPlaces) {
                        errorPaymentPlaces.classList.remove('show');
                    }
                    refreshPaymentTotal();

                    if (stripeInitTimer) {
                        window.clearTimeout(stripeInitTimer);
                    }
                    stripeInitTimer = window.setTimeout(function () {
                        initializeStripeElement();
                    }, 350);
                });
            }

            async function initializeStripeElement() {
                if (!paymentForm || !paymentCheckoutToken || !stripePaymentElementContainer) {
                    return false;
                }

                var places = parseInt(String(paymentPlaces ? paymentPlaces.value : '1'), 10);
                var maxPlaces = parseInt((paymentForm && paymentForm.getAttribute('data-max-places')) || '1', 10);
                var unitAmount = parseInt((paymentForm && paymentForm.getAttribute('data-unit-amount')) || '0', 10);
                var activityId = parseInt((paymentForm && paymentForm.getAttribute('data-activity-id')) || '0', 10);
                var token = String(paymentCheckoutToken.value || '');

                if (!Number.isFinite(places) || places < 1) {
                    places = 1;
                }
                if (Number.isFinite(maxPlaces) && maxPlaces > 0 && places > maxPlaces) {
                    places = maxPlaces;
                }

                if (!Number.isFinite(unitAmount) || unitAmount <= 0) {
                    return false;
                }
                if (!Number.isFinite(activityId) || activityId <= 0) {
                    return false;
                }

                if (errorStripePayment) {
                    errorStripePayment.classList.remove('show');
                }
                stripePaymentElementContainer.innerHTML = '';

                try {
                    const response = await fetch(checkoutUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: new URLSearchParams({
                            _token: token,
                            activity_id: String(activityId),
                            quantity: String(places)
                        }).toString()
                    });

                    const data = await response.json().catch(function () { return {}; });
                    if (!response.ok || !data.success || !data.clientSecret || !data.publishableKey) {
                        throw new Error((data && data.message) ? data.message : 'Unable to initialize payment form.');
                    }

                    if (!stripeInstance || stripeInstance.__key !== data.publishableKey) {
                        stripeInstance = Stripe(data.publishableKey);
                        stripeInstance.__key = data.publishableKey;
                    }

                    stripeElements = stripeInstance.elements({ clientSecret: data.clientSecret });
                    stripePaymentElement = stripeElements.create('payment');
                    stripePaymentElement.mount(stripePaymentElementContainer);

                    return true;
                } catch (e) {
                    if (errorStripePayment) {
                        errorStripePayment.textContent = e && e.message ? e.message : "Impossible d'initialiser le formulaire de paiement.";
                        errorStripePayment.classList.add('show');
                    }
                    return false;
                }
            }

            if (paymentForm) {
                paymentForm.addEventListener('submit', function (event) {
                    event.preventDefault();

                    var places = parseInt(String(paymentPlaces ? paymentPlaces.value : '1'), 10);
                    var maxPlaces = parseInt((paymentForm && paymentForm.getAttribute('data-max-places')) || '1', 10);
                    var unitAmount = parseInt((paymentForm && paymentForm.getAttribute('data-unit-amount')) || '0', 10);
                    var activityId = parseInt((paymentForm && paymentForm.getAttribute('data-activity-id')) || '0', 10);

                    var isValid = true;

                    if (errorPaymentPlaces) {
                        var placesInvalid = !Number.isFinite(places) || places < 1 || (Number.isFinite(maxPlaces) && maxPlaces > 0 && places > maxPlaces);
                        errorPaymentPlaces.classList.toggle('show', placesInvalid);
                        if (placesInvalid) {
                            isValid = false;
                        }
                    }

                    if (!Number.isFinite(unitAmount) || unitAmount <= 0) {
                        isValid = false;
                    }
                    if (!Number.isFinite(activityId) || activityId <= 0) {
                        isValid = false;
                    }

                    if (!isValid) {
                        return;
                    }

                    var submitButton = paymentForm.querySelector('.payment-confirm');
                    if (paymentSuccess) {
                        paymentSuccess.textContent = 'Creation du paiement...';
                        paymentSuccess.style.color = '#0d5e8a';
                        paymentSuccess.style.background = 'rgba(13, 94, 138, 0.12)';
                        paymentSuccess.style.borderColor = 'rgba(13, 94, 138, 0.28)';
                        paymentSuccess.classList.add('show');
                    }

                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Traitement...';
                    }

                    Promise.resolve()
                        .then(async function () {
                            var ready = stripeElements ? true : await initializeStripeElement();
                            if (!ready || !stripeInstance || !stripeElements) {
                                throw new Error("Le formulaire de paiement n'est pas prêt.");
                            }

                            const result = await stripeInstance.confirmPayment({
                                elements: stripeElements,
                                confirmParams: {
                                    return_url: stripeReturnUrl
                                },
                                redirect: 'if_required'
                            });

                            if (result.error) {
                                throw new Error(result.error.message || 'Paiement refuse.');
                            }

                            if (result.paymentIntent && result.paymentIntent.status === 'succeeded') {
                                const finalizeResponse = await fetch(finalizeUrl, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                                    },
                                    body: new URLSearchParams({
                                        _token: String(paymentCheckoutToken ? paymentCheckoutToken.value : ''),
                                        payment_intent_id: String(result.paymentIntent.id || '')
                                    }).toString()
                                });

                                const finalizeData = await finalizeResponse.json().catch(function () { return {}; });
                                if (!finalizeResponse.ok || !finalizeData.success) {
                                    throw new Error((finalizeData && finalizeData.message) ? finalizeData.message : "Paiement confirme, mais l'enregistrement a echoue.");
                                }

                                window.location.href = '{{ path('app_activities', {'payment': 'success'}) }}';
                                return;
                            }

                            if (result.paymentIntent && result.paymentIntent.status === 'processing') {
                                if (paymentSuccess) {
                                    paymentSuccess.textContent = 'Paiement en cours de traitement...';
                                    paymentSuccess.style.color = '#0d5e8a';
                                    paymentSuccess.style.background = 'rgba(13, 94, 138, 0.12)';
                                    paymentSuccess.style.borderColor = 'rgba(13, 94, 138, 0.28)';
                                }
                                return;
                            }
                        })
                        .catch(function (err) {
                            if (paymentSuccess) {
                                paymentSuccess.textContent = err && err.message ? err.message : 'Erreur de paiement. Veuillez reessayer.';
                                paymentSuccess.style.color = '#c6364f';
                                paymentSuccess.style.background = 'rgba(198, 54, 79, 0.12)';
                                paymentSuccess.style.borderColor = 'rgba(198, 54, 79, 0.28)';
                            }
                        })
                        .finally(function () {
                            if (submitButton) {
                                submitButton.disabled = false;
                                submitButton.textContent = 'Confirmer le paiement';
                            }
                        });
                });
            }

            document.querySelectorAll('.js-open-activity-modal').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityModal(button);
                });
            });

            var urlParams = new URLSearchParams(window.location.search);
            var modalActivityId = (urlParams.get('modal') || '').trim();
            var deepLinkHandled = false;

            function findDeepLinkTarget(activityId) {
                if (!activityId) {
                    return null;
                }

                return document.querySelector('.js-open-activity-modal[data-activity-id="' + activityId + '"]')
                    || document.querySelector('.activity-card[data-activity-id="' + activityId + '"]')
                    || document.querySelector('[data-activity-id="' + activityId + '"]');
            }

            function clearDeepLinkParams() {
                urlParams.delete('modal');
                urlParams.delete('from_reservations');
                var cleanQuery = urlParams.toString();
                var cleanUrl = window.location.pathname + (cleanQuery ? ('?' + cleanQuery) : '') + window.location.hash;
                window.history.replaceState({}, document.title, cleanUrl);
            }

            function openDeepLinkedActivity(activityId, hideReserve) {
                var deepLinkTarget = findDeepLinkTarget(activityId);
                if (!deepLinkTarget) {
                    return false;
                }

                deepLinkHandled = true;

                if (hideReserve) {
                    deepLinkTarget.setAttribute('data-hide-reserve', '1');
                }

                openActivityModal(deepLinkTarget);

                if (hideReserve) {
                    deepLinkTarget.removeAttribute('data-hide-reserve');
                }

                clearDeepLinkParams();
                return true;
            }

            function readDeepLinkFromStorage() {
                try {
                    var payload = sessionStorage.getItem('rehletna_activity_modal');
                    if (!payload) {
                        return null;
                    }

                    return JSON.parse(payload);
                } catch (error) {
                    return null;
                }
            }

            function clearDeepLinkStorage() {
                try {
                    sessionStorage.removeItem('rehletna_activity_modal');
                } catch (error) {
                    // Ignore storage issues.
                }
            }

            function triggerDeepLinkOpen() {
                if (deepLinkHandled) {
                    return;
                }

                var storagePayload = readDeepLinkFromStorage();
                var storageActivityId = storagePayload && storagePayload.activityId ? String(storagePayload.activityId) : '';
                var storageHideReserve = !!(storagePayload && storagePayload.hideReserve);
                var activityIdToOpen = modalActivityId || storageActivityId;
                var hideReserve = urlParams.get('from_reservations') === '1' || storageHideReserve;

                if (!activityIdToOpen) {
                    return;
                }

                var openedImmediately = openDeepLinkedActivity(activityIdToOpen, hideReserve);
                if (openedImmediately) {
                    clearDeepLinkStorage();
                    return;
                }

                window.setTimeout(function () {
                    if (!deepLinkHandled && openDeepLinkedActivity(activityIdToOpen, hideReserve)) {
                        clearDeepLinkStorage();
                    }
                }, 180);
            }

            if (modalActivityId !== '' || readDeepLinkFromStorage()) {
                triggerDeepLinkOpen();
            }

            window.addEventListener('pageshow', function () {
                triggerDeepLinkOpen();
            });

            window.addEventListener('load', function () {
                triggerDeepLinkOpen();
            });

            document.querySelectorAll('.js-open-reservations-modal').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    var reservationsUrl = button.getAttribute('data-reservations-url') || '';
                    currentReservationsPdfUrl = button.getAttribute('data-reservations-pdf-url') || '';
                    if (!reservationsUrl) {
                        return;
                    }
                    openReservationsModal(reservationsUrl, button.getAttribute('data-activity-title') || 'Activity');
                });
            });

            document.querySelectorAll('.js-guide-own-activity-open').forEach(function (card) {
                card.addEventListener('click', function (event) {
                    if (event.target.closest('button, a, form, input, select, textarea, label')) {
                        return;
                    }
                    openActivityModal(card);
                });
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeActivityModal();
                    closeActivityEditModal();
                    closeActivityCreateModal();
                    closeReservationsModal();
                    closePaymentModal();
                }
            });

            document.querySelectorAll('.js-open-activity-edit').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityEditModal(button);
                });
            });

            document.querySelectorAll('.js-activity-review-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    window.submitActivityReview(form);
                });
            });

            document.addEventListener('click', async function (event) {
                var deleteButton = event.target.closest('.js-delete-activity-review');
                if (!deleteButton) {
                    return;
                }

                var reviewId = deleteButton.getAttribute('data-review-id');
                if (!reviewId || !window.confirm('Delete this review?')) {
                    return;
                }

                try {
                    deleteButton.disabled = true;
                    var response = await fetch(buildReviewUrl(reviewsDeleteBaseUrl, 'REVIEW_ID_PLACEHOLDER', reviewId), {
                        method: 'DELETE',
                        headers: { 'Accept': 'application/json' }
                    });
                    var data = await response.json();
                    if (!response.ok || !data || data.success === false) {
                        throw new Error(data && data.message ? data.message : 'Unable to delete review.');
                    }
                    await window.loadActivityReviewPanel(currentReviewState.activityId, currentReviewState.reviewToken);
                } catch (error) {
                    window.alert(error && error.message ? error.message : 'Unable to delete review.');
                } finally {
                    deleteButton.disabled = false;
                }
            });

            var addNewButton = document.querySelector('.js-open-activity-create');
            if (addNewButton) {
                addNewButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    openActivityCreateModal();
                });
            }

            var guideFilterToggle = document.querySelector('.js-guide-activities-toggle');
            var activitiesEmptyFilter = document.querySelector('.js-activities-empty-filter');
            var activityCards = Array.prototype.slice.call(document.querySelectorAll('.activity-card'));

            function applyActivityFilters() {
                var guideFilterActive = guideFilterToggle && guideFilterToggle.getAttribute('data-filter-active') === '1';
                var visibleCards = 0;

                activityCards.forEach(function (card) {
                    var isMine = card.getAttribute('data-is-my-activity') === '1';
                    var hiddenByGuideFilter = guideFilterActive && !isMine;
                    var shouldHide = hiddenByGuideFilter;
                    card.style.display = shouldHide ? 'none' : '';
                    if (!shouldHide) {
                        visibleCards += 1;
                    }
                });

                if (activitiesEmptyFilter) {
                    activitiesEmptyFilter.style.display = visibleCards === 0 ? 'block' : 'none';
                }
            }

            if (guideFilterToggle) {
                guideFilterToggle.addEventListener('click', function () {
                    var nextState = guideFilterToggle.getAttribute('data-filter-active') !== '1';
                    guideFilterToggle.classList.toggle('active', nextState);
                    guideFilterToggle.setAttribute('aria-pressed', nextState ? 'true' : 'false');
                    guideFilterToggle.setAttribute('data-filter-active', nextState ? '1' : '0');
                    guideFilterToggle.setAttribute('title', nextState ? 'Show all activities' : 'Show only my activities');
                    applyActivityFilters();
                });
            }

            applyActivityFilters();

            document.querySelectorAll('.nav-tab[data-view]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var view = tab.getAttribute('data-view');
                    if (!view) {
                        return;
                    }

                    // Keep the same module-driven navigation behavior as mainpage.
                    window.location.href = '{{ path('app_mainpage') }}?module=' + encodeURIComponent(view);
                });
            });

            document.querySelectorAll('.side-menu-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    var action = button.getAttribute('data-action');
                    if (action === 'logout') {
                        window.location.href = '{{ path('app_logout') }}';
                    } else if (action === 'dashboard') {
                        window.location.href = '{{ path('app_dashboard') }}';
                    } else if (action === 'guide-dashboard') {
                        window.location.href = '{{ path('app_guide_dashboard') }}';
                    } else if (action === 'reservations') {
                        window.location.href = '{{ path('app_reservations') }}';
                    } else if (action === 'my-reservations') {
                        window.location.href = '{{ path('app_my_reservations') }}';
                    } else if (action === 'my-orders') {
                        window.location.href = '{{ path('app_my_orders') }}';
                    } else if (action === 'offers-grid') {
                        window.location.href = '{{ path('app_offers_grid') }}';
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', initializeActivitiesPage);
        document.addEventListener('turbo:load', initializeActivitiesPage);
        if (document.readyState !== 'loading') {
            initializeActivitiesPage();
        }
    </script>
{% endblock %}

{% block body %}
    {% set userRoleLabel = 'main.role.member'|trans %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set userRoleLabel = 'main.role.administrator'|trans %}
    {% elseif is_granted('ROLE_GUIDE') %}
        {% set userRoleLabel = 'main.role.guide'|trans %}
    {% endif %}

    <div class="menu-overlay"></div>

    <div class="side-menu">
        <div class="side-menu-content">
            <div class="user-info">
                <div class="avatar">{{ app.user.username|first|upper }}</div>
                <p class="user-name">{{ app.user.fullName|default(app.user.username) }}</p>
                <p class="user-role">{{ userRoleLabel }}</p>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <button class="side-menu-btn" data-action="dashboard">🏠 {{ 'main.menu.dashboard'|trans }}</button>
            {% endif %}

            {% if is_granted('ROLE_GUIDE') %}
                <button class="side-menu-btn" data-action="guide-dashboard">👤 {{ 'main.menu.guide_dashboard'|trans }}</button>
            {% endif %}

            <button class="side-menu-btn" data-action="my-reservations">👤 {{ 'main.menu.my_reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="my-orders">🧾 {{ 'main.menu.my_orders'|trans }}</button>
            <button class="side-menu-btn" data-action="reservations">💻 {{ 'main.menu.reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="offers-grid">📋 {{ 'main.menu.offers_grid'|trans }}</button>

            <button class="side-menu-btn logout-btn" data-action="logout">Logout</button>
        </div>
    </div>

    <div class="main-container">
        <div style="flex: 1;">
            <div class="top-bar">
                <div style="display: flex; align-items: center;">
                    <button class="menu-toggle" type="button" aria-label="Toggle menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <div class="logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna.tn" title="Rehletna.tn" />
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="profile-section">
                        <div class="profile-info">
                            <p class="profile-name">{{ app.user.fullName|default(app.user.username) }}</p>
                            <p class="profile-role">{{ userRoleLabel }}</p>
                        </div>
                        <div class="profile-avatar">
                            {{ app.user.username|first|upper }}
                            <div class="online-status"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-tabs">
                <button class="nav-tab active" data-view="services">💻 {{ 'main.tab.services'|trans }}</button>
                                <a class="nav-tab" href="{{ path('app_activities') }}">🏞 {{ 'main.tab.activities'|trans }}</a>
                <button class="nav-tab" data-view="shop">🛒 {{ 'main.tab.shop'|trans }}</button>
                <button class="nav-tab" data-view="ai-guide">🤖 {{ 'main.tab.ai_guide'|trans }}</button>
                <button class="nav-tab" data-view="offers">🔖 {{ 'main.tab.offers'|trans }}</button>
                <button class="nav-tab" data-view="messenger">💬 {{ 'main.tab.messenger'|trans }}</button>
                <button class="nav-tab" data-view="post">✉️ Posts</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-tab" href="{{ path('app_admin_stats') }}">📊 {{ 'main.tab.stats'|trans }}</a>
                {% endif %}
            </div>

            <div class="content-area">
                {% set paymentStatus = app.request.query.get('payment') %}

                <div class="activities-module">
                    <div class="activities-head">
                        <div>
                            {% set historyMode = historyMode|default(false) %}
                            <h2>{{ historyMode ? 'Activity history' : 'Activities' }}</h2>
                            <p>
                                {{ activities|length }}
                                {{ historyMode ? 'passed activities' : 'activities available' }}
                            </p>
                        </div>
                        <div class="activities-head-actions">
                            <span class="activities-pill">{{ activities|length }} total</span>
                            <form class="activities-search-form" method="get" action="{{ historyMode ? path('app_activities_history') : path('app_activities') }}">
                                <input
                                    type="text"
                                    name="q"
                                    value="{{ currentSearch|default('') }}"
                                    class="activities-search"
                                    placeholder="Search by activity name or place"
                                    aria-label="Search activities by name or place"
                                >
                                <button type="submit" class="activities-search-btn">🔍</button>
                            </form>
                            {% if is_granted('ROLE_GUIDE') %}
                                <a class="activities-pill activities-stats-link" href="{{ path('app_activities_stats') }}" title="Activity statistics">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 19h16"></path>
                                        <path d="M7 16V9"></path>
                                        <path d="M12 16V5"></path>
                                        <path d="M17 16v-6"></path>
                                    </svg>
                                    <span>Stats</span>
                                </a>
                                {% if not historyMode %}
                                    <button
                                        type="button"
                                        class="activities-pill activities-filter-guide js-guide-activities-toggle"
                                        data-filter-active="0"
                                        aria-pressed="false"
                                        title="Show only my activities"
                                    >
                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 5h18"></path>
                                            <path d="M6 12h12"></path>
                                            <path d="M10 19h4"></path>
                                        </svg>
                                        <span>My activities</span>
                                    </button>
                                {% endif %}
                                {% if not historyMode %}
                                    <a class="activities-pill activities-history-link" href="{{ path('app_activities_history') }}" title="History">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 3v5h5"></path>
                                            <path d="M3.05 13A9 9 0 1 0 6 6.3L3 8"></path>
                                            <path d="M12 7v5l3 2"></path>
                                        </svg>
                                        <span>Historique</span>
                                    </a>
                                    <button
                                        type="button"
                                        class="activities-pill activities-add-new js-open-activity-create"
                                        title="Add a new activity"
                                    >
                                        <span>+</span>
                                    </button>
                                {% else %}
                                    <a class="activities-pill" href="{{ path('app_activities') }}">Back to activities</a>
                                {% endif %}
                            {% endif %}
                            
                        </div>
                    </div>

                    {% if paymentStatus == 'success' %}
                        <div class="activities-banner success">
                            Payment completed successfully. Your reservation has been confirmed.
                        </div>
                    {% endif %}

                    <div class="activities-grid">
                        {% set canSeeInactive = is_granted('ROLE_GUIDE') %}
                        {% for activity in activities %}
                            {% set status = activity.statut|default('')|lower %}
                            {% set isPassed = activity.is_passed|default(false) %}
                            {% set isMyActivity = is_granted('ROLE_GUIDE') and app.user and activity.idGuide is not null and activity.idGuide == app.user.id %}
                            {% if historyMode or canSeeInactive or status == 'actif' %}
                            <article
                                class="activity-card {{ status == 'inactif' ? 'activity-card--inactive' : '' }} {{ isMyActivity and not historyMode ? 'activity-card--clickable js-guide-own-activity-open' : '' }}"
                                data-is-my-activity="{{ isMyActivity ? '1' : '0' }}"
                                data-title="{{ activity.titre|default('')|e('html_attr') }}"
                                data-activity-id="{{ activity.idActivite }}"
                                data-description="{{ activity.description|default('')|e('html_attr') }}"
                                data-location="{{ activity.lieu|default('')|e('html_attr') }}"
                                data-category="{{ activity.categorie|default('-')|e('html_attr') }}"
                                data-places="{{ activity.placesDisponibles|default(0) }}"
                                data-price="{{ activity.prix|default(0) }}"
                                data-status="{{ activity.statut|default('')|e('html_attr') }}"
                                data-date="{{ activity.dateActivite ? activity.dateActivite|date('d M Y H:i') : '-' }}"
                                data-duration="{{ activity.dureParJour|default(0) }}"
                                data-image="{{ activity.image_url|default('')|e('html_attr') }}"
                                data-guide-name="{{ activity.guide_display_name|default('Guide')|e('html_attr') }}"
                                data-guide-image="{{ activity.guide_image_url|default('')|e('html_attr') }}"
                                data-review-token="{{ csrf_token('activity-review-' ~ activity.idActivite)|e('html_attr') }}"
                            >
                                {% if is_granted('ROLE_ADMIN') %}
                                    <form
                                        method="post"
                                        action="{{ path('app_activities_admin_delete', { id: activity.idActivite }) }}"
                                        class="activity-admin-delete-form"
                                        onsubmit="return window.confirm('Delete this activity?');"
                                    >
                                        <button type="submit" class="activity-admin-delete-btn" title="Delete activity" aria-label="Delete activity">&times;</button>
                                    </form>
                                {% endif %}
                               
                                {% set showNewBadge = (not historyMode) and (not isPassed) and activity.is_new|default(false) and (is_granted('ROLE_ADMIN') or (is_granted('ROLE_USER') and not is_granted('ROLE_GUIDE'))) %}
                                {% if showNewBadge %}
                                    <div class="activity-new-badge">New</div>
                                {% endif %}
                                <div class="activity-image-wrap">
                                    <img class="activity-image" src="{{ activity.image_url }}" alt="{{ activity.titre }}">
                                    {% if activity.weather is iterable or is_granted('ROLE_GUIDE') or is_granted('ROLE_USER') %}
                                        <div class="activity-top-overlays">
                                            {% if activity.weather is iterable %}
                                                <div class="activity-weather activity-weather-overlay" title="Forecast near activity date">
                                                    <span class="activity-weather-main">{{ activity.weather.emoji|default('🌤️') }}</span>
                                                    <span class="activity-weather-temp">{{ activity.weather.formattedTemp|default('') }}</span>
                                                </div>
                                            {% endif %}
                                            {% if isMyActivity and is_granted('ROLE_GUIDE') and not historyMode %}
                                                <button
                                                    type="button"
                                                    class="activity-places-overlay js-open-reservations-modal"
                                                    data-reservations-url="{{ path('app_activities_reservations_data', { id: activity.idActivite }) }}"
                                                    data-reservations-pdf-url="{{ path('app_activities_reservations_pdf', { id: activity.idActivite }) }}"
                                                    data-activity-title="{{ activity.titre|e('html_attr') }}"
                                                    title="Voir les reservations de cette activite"
                                                >{{ activity.placesDisponibles|default(0) }} places</button>
                                            {% elseif is_granted('ROLE_GUIDE') or is_granted('ROLE_USER') %}
                                                <span class="activity-places-overlay" title="Available places">{{ activity.placesDisponibles|default(0) }} places</span>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                                {% if isMyActivity and not historyMode %}
                                    <div class="activity-guide-actions">
                                        <button
                                            type="button"
                                            class="activity-guide-icon-btn edit js-open-activity-edit"
                                            onclick="window.openActivityEditModal(this); return false;"
                                            data-title="{{ activity.titre|e('html_attr') }}"
                                            data-description="{{ activity.description|e('html_attr') }}"
                                            data-location="{{ activity.lieu|e('html_attr') }}"
                                            data-category="{{ activity.categorie|default('')|e('html_attr') }}"
                                            data-status="{{ activity.statut|default('Actif')|e('html_attr') }}"
                                            data-date-input="{{ activity.dateActivite ? activity.dateActivite|date('Y-m-d\\TH:i') : '' }}"
                                            data-duration="{{ activity.dureParJour|default(0) }}"
                                            data-price="{{ activity.prix|default(0) }}"
                                            data-places="{{ activity.placesDisponibles|default(0) }}"
                                            data-edit-url="{{ path('app_activities_edit', { id: activity.idActivite }) }}"
                                            data-token="{{ csrf_token('edit_activity_' ~ activity.idActivite) }}"
                                            title="Edit activity"
                                            aria-label="Edit activity"
                                        >✎</button>
                                        <form
                                            method="post"
                                            action="{{ path('app_activities_delete', { id: activity.idActivite }) }}"
                                            class="activity-delete-form"
                                            onsubmit="return window.confirm('Delete this activity?');"
                                        >
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_activity_' ~ activity.idActivite) }}">
                                            <button type="submit" class="activity-guide-icon-btn delete" title="Delete activity" aria-label="Delete activity">&times;</button>
                                        </form>
                                    </div>
                                {% endif %}
                                <div class="activity-body">
                                    <h3 class="activity-title">{{ activity.titre }}</h3>
                                    {% if not isMyActivity %}
                                        <div class="activity-meta">
                                            <span class="activity-tag">{{ activity.categorie|default('Activity') }}</span>
                                            <span class="activity-tag">{{ activity.lieu }}</span>
                                        </div>

                                        {% if is_granted('ROLE_GUIDE') or is_granted('ROLE_ADMIN') %}
                                            <div class="activity-meta">
                                                <span class="activities-badge {{ status == 'actif' ? 'active' : 'inactive' }}">{{ activity.statut }}</span>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                    <div class="activity-foot">
                                        <div class="activity-price">{{ activity.prix }} Dt</div>
                                        <div class="activity-foot-right">
                                            {% if not isMyActivity %}
                                                <button
                                                    type="button"
                                                    class="activity-view js-open-activity-modal"
                                                    onclick="window.openActivityModal(this); return false;"
                                                    data-activity-id="{{ activity.idActivite }}"
                                                    data-title="{{ activity.titre|e('html_attr') }}"
                                                    data-description="{{ activity.description|e('html_attr') }}"
                                                    data-location="{{ activity.lieu|e('html_attr') }}"
                                                    data-category="{{ activity.categorie|default('-')|e('html_attr') }}"
                                                    data-places="{{ activity.placesDisponibles }}"
                                                    data-price="{{ activity.prix }}"
                                                    data-status="{{ activity.statut|e('html_attr') }}"
                                                    data-date="{{ activity.dateActivite ? activity.dateActivite|date('d M Y H:i') : '-' }}"
                                                    data-duration="{{ activity.dureParJour }}"
                                                    data-image="{{ activity.image_url|e('html_attr') }}"
                                                    data-guide-name="{{ activity.guide_display_name|e('html_attr') }}"
                                                    data-guide-image="{{ activity.guide_image_url|e('html_attr') }}"
                                                    data-review-token="{{ csrf_token('activity-review-' ~ activity.idActivite)|e('html_attr') }}"
                                                    title="View activity details"
                                                >View</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </article>
                            {% endif %}
                        {% else %}
                            <div class="activities-empty">No activities found with that name.</div>
                        {% endfor %}
                    </div>
                    <div class="activities-empty js-activities-empty-filter" style="display: none;">No activities match.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="activity-modal-overlay">
        <div class="activity-modal" role="dialog" aria-modal="true" aria-labelledby="activityModalTitle">
            <div class="activity-modal-head">
                <h3 class="activity-modal-title js-activity-modal-title" id="activityModalTitle">Activity</h3>
                <button type="button" class="activity-modal-close" aria-label="Close" onclick="window.closeActivityModal(); return false;">&times;</button>
            </div>

            <div class="activity-modal-body">
                <img class="activity-modal-image js-activity-modal-image" src="" alt="Activity image">

                <div class="activity-modal-info">
                    <div class="activity-modal-grid">
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Location</span>
                            <span class="activity-modal-value js-activity-modal-location"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Category</span>
                            <span class="activity-modal-value js-activity-modal-category"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Places</span>
                            <span class="activity-modal-value js-activity-modal-places"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Price</span>
                            <span class="activity-modal-value js-activity-modal-price"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Status</span>
                            <span class="activity-modal-value js-activity-modal-status"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Date</span>
                            <span class="activity-modal-value js-activity-modal-date"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Duration</span>
                            <span class="activity-modal-value js-activity-modal-duration"></span>
                        </div>
                        <div class="activity-modal-item">
                            <span class="activity-modal-label">Description</span>
                            <p class="activity-modal-desc js-activity-modal-description"></p>
                        </div>
                    </div>

                    <div class="activity-guide-box">
                        <img class="activity-guide-avatar js-activity-modal-guide-image" src="" alt="Guide profile picture">
                        <div>
                            <span class="activity-modal-label">Guide</span>
                            <p class="activity-guide-name js-activity-modal-guide-name"></p>
                        </div>
                    </div>

                    <section class="activity-review-shell">
                        <article class="activity-review-card">
                            <div class="activity-review-card-head">
                                <div>
                                    <span class="activity-review-label">Global Review</span>
                                    <h4>Share your experience with all travelers</h4>
                                </div>
                            </div>
                            <form class="activity-review-form js-activity-review-form">
                                <input type="hidden" class="js-activity-review-token" value="">
                                <textarea class="activity-review-input js-activity-review-input" rows="4" placeholder="Review unlocks after the activity is completed."></textarea>
                                <div class="activity-review-actions">
                                    <span class="activity-review-status js-activity-review-status"></span>
                                    <button type="submit" class="activity-review-submit">Post Review</button>
                                </div>
                            </form>
                            <div class="activity-review-list js-activity-review-list"></div>
                        </article>
                        <p class="activity-review-lock js-activity-review-lock"></p>
                    </section>

                    <div class="activity-modal-actions">
                        <button type="button" class="activity-modal-reserve" data-activity-id="0" data-amount="0" data-activity-title="Activity">Reserver</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if modalActivity is defined and modalActivity %}
        <button
            type="button"
            class="js-open-activity-modal"
            style="display: none;"
            data-activity-id="{{ modalActivity.idActivite }}"
            data-title="{{ modalActivity.titre|e('html_attr') }}"
            data-description="{{ modalActivity.description|e('html_attr') }}"
            data-location="{{ modalActivity.lieu|e('html_attr') }}"
            data-category="{{ modalActivity.categorie|default('-')|e('html_attr') }}"
            data-places="{{ modalActivity.placesDisponibles|default(0) }}"
            data-price="{{ modalActivity.prix|default(0) }}"
            data-status="{{ modalActivity.statut|e('html_attr') }}"
            data-date="{{ modalActivity.dateActivite ? modalActivity.dateActivite|date('d M Y H:i') : '-' }}"
            data-duration="{{ modalActivity.dureParJour|default(0) }}"
            data-image="{{ modalActivity.image_url|e('html_attr') }}"
            data-guide-name="{{ modalActivity.guide_display_name|e('html_attr') }}"
            data-guide-image="{{ modalActivity.guide_image_url|e('html_attr') }}"
            data-review-token="{{ csrf_token('activity-review-' ~ modalActivity.idActivite)|e('html_attr') }}"
            {% if modalHideReserve %}data-hide-reserve="1"{% endif %}
            aria-hidden="true"
            tabindex="-1"
        >Open activity</button>
    {% endif %}

    <div class="reservations-overlay">
        <div class="reservations-modal" role="dialog" aria-modal="true" aria-labelledby="reservationsTitle">
            <div class="reservations-head">
                <h3 class="reservations-title js-reservations-title" id="reservationsTitle">Reservations</h3>
                <button type="button" class="activity-modal-close reservations-close" aria-label="Close">&times;</button>
            </div>
            <div class="reservations-content">
                <div class="reservations-message js-reservations-message"></div>
                <div class="reservations-table-wrap">
                    <table class="reservations-table">
                        <thead>
                            <tr>
                                <th>Avatar</th>
                                <th>Client</th>
                                <th>Email</th>
                                <th>Places</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody class="js-reservations-body"></tbody>
                    </table>
                </div>
                <div class="reservations-actions">
                    <button type="button" class="reservations-pdf-btn js-reservations-pdf-btn">Download PDF</button>
                </div>
            </div>
        </div>
    </div>

    <div class="payment-overlay">
        <div class="payment-modal" role="dialog" aria-modal="true" aria-labelledby="paymentTitle">
            <div class="payment-head">
                <h3 class="payment-title" id="paymentTitle">Paiement</h3>
                <button type="button" class="activity-modal-close payment-close" aria-label="Close" onclick="window.closePaymentModal(); return false;">&times;</button>
            </div>

            <div class="payment-amount">
                <span class="js-payment-activity-title">Activity</span>
                <strong class="js-payment-amount">0 DT</strong>
            </div>

            <div class="payment-card" aria-hidden="true">
                <div class="payment-card-row">
                    <span class="payment-chip"></span>
                    <span class="payment-brand" aria-hidden="true">
                        <span class="payment-brand-dot red"></span>
                        <span class="payment-brand-dot yellow"></span>
                        <span class="payment-brand-text">card</span>
                    </span>
                </div>
                <p class="payment-card-number js-card-number-display">•••• •••• •••• ••••</p>
                <div class="payment-card-meta">
                    <span>Card Holder<span class="payment-card-value js-card-holder-display">VOTRE NOM</span></span>
                    <span>Expire<span class="payment-card-value js-card-expiry-display">MM/AA</span></span>
                </div>
            </div>

            <div class="payment-success js-payment-success">Payment confirmed successfully.</div>

            <form class="payment-form js-payment-form" novalidate>
                <input type="hidden" class="js-payment-checkout-token" value="{{ csrf_token('activities-checkout') }}">

                <div class="payment-field">
                    <label class="payment-label" for="pay-places">Nombre de places</label>
                    <input class="payment-input js-payment-places" id="pay-places" type="number" min="1" step="1" value="1" required>
                    <span class="payment-error js-payment-error-places">Nombre de places invalide.</span>
                </div>

                <div class="payment-field">
                    <label class="payment-label">Informations de carte</label>
                    <div class="payment-input" style="padding: 14px; background: rgba(255, 255, 255, 0.88);">
                        <div class="js-stripe-payment-element"></div>
                    </div>
                    <span class="payment-error js-payment-error-stripe">Impossible d'initialiser le formulaire de paiement.</span>
                </div>

                <div class="payment-actions">
                    <button type="submit" class="payment-confirm">Confirmer le paiement</button>
                    <button type="button" class="payment-cancel" onclick="window.closePaymentModal(); return false;">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div class="activity-edit-overlay">
        <div class="activity-edit-modal" role="dialog" aria-modal="true" aria-labelledby="activityEditTitle">
            <div class="activity-edit-head">
                <h3 class="activity-edit-title" id="activityEditTitle">Edit Activity</h3>
                <button type="button" class="activity-modal-close activity-edit-close" aria-label="Close" onclick="window.closeActivityEditModal(); return false;">&times;</button>
            </div>

            <form method="post" class="activity-edit-form js-activity-edit-form" action="{{ path('app_activities') }}">
                <input type="hidden" name="_token" class="js-edit-token" value="">

                <div class="activity-edit-field full">
                    <label class="activity-edit-label" for="edit-title">Title</label>
                    <input class="activity-edit-input js-edit-title" id="edit-title" type="text" name="title" required>
                </div>

                <div class="activity-edit-field full">
                    <label class="activity-edit-label" for="edit-description">Description</label>
                    <textarea class="activity-edit-textarea js-edit-description" id="edit-description" name="description" required></textarea>
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-location">Location</label>
                    <input class="activity-edit-input js-edit-location" id="edit-location" type="text" name="location" required>
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-category">Category</label>
                    <input class="activity-edit-input js-edit-category" id="edit-category" type="text" name="category">
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-date">Date</label>
                    <input class="activity-edit-input js-edit-date" id="edit-date" type="datetime-local" name="date" required>
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-duration">Duration (hours)</label>
                    <input class="activity-edit-input js-edit-duration" id="edit-duration" type="number" min="0" name="duration" required>
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-price">Price</label>
                    <input class="activity-edit-input js-edit-price" id="edit-price" type="number" min="0" name="price" required>
                </div>

                <div class="activity-edit-field">
                    <label class="activity-edit-label" for="edit-places">Places</label>
                    <input class="activity-edit-input js-edit-places" id="edit-places" type="number" min="0" name="places" required>
                </div>

                <div class="activity-edit-field full">
                    <label class="activity-edit-label" for="edit-status">Status</label>
                    <select class="activity-edit-select js-edit-status" id="edit-status" name="status">
                        <option value="Actif">Actif</option>
                        <option value="Inactif">Inactif</option>
                    </select>
                </div>

                <div class="activity-edit-actions">
                    <button type="button" class="activity-edit-cancel" onclick="window.closeActivityEditModal(); return false;">Cancel</button>
                    <button type="submit" class="activity-edit-submit">Save changes</button>
                </div>
            </form>
        </div>
    </div>

    <div class="activity-create-overlay">
        <div class="activity-create-modal" role="dialog" aria-modal="true" aria-labelledby="activityCreateTitle">
            <div class="activity-create-head">
                <h3 class="activity-create-title" id="activityCreateTitle">Add New Activity</h3>
                <button type="button" class="activity-modal-close activity-create-close" aria-label="Close" onclick="window.closeActivityCreateModal(); return false;">&times;</button>
            </div>

            <form method="post" class="activity-create-form js-activity-create-form" action="{{ path('app_activities_new') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('new_activity') }}">

                <div class="activity-create-field full">
                    <label class="activity-create-label" for="create-title">Title</label>
                    <input class="activity-create-input" id="create-title" type="text" name="title" required>
                </div>

                <div class="activity-create-field full">
                    <label class="activity-create-label" for="create-description">Description</label>
                    <textarea class="activity-create-textarea" id="create-description" name="description" required></textarea>
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-location">Location</label>
                    <input class="activity-create-input" id="create-location" type="text" name="location" required>
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-category">Category</label>
                    <input class="activity-create-input" id="create-category" type="text" name="category">
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-date">Date</label>
                    <input class="activity-create-input" id="create-date" type="datetime-local" name="date" required>
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-duration">Duration (hours)</label>
                    <input class="activity-create-input" id="create-duration" type="number" min="0" name="duration" required>
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-price">Price</label>
                    <input class="activity-create-input" id="create-price" type="number" min="0" name="price" required>
                </div>

                <div class="activity-create-field">
                    <label class="activity-create-label" for="create-places">Places</label>
                    <input class="activity-create-input" id="create-places" type="number" min="0" name="places" required>
                </div>

                <div class="activity-create-field full">
                    <label class="activity-create-label" for="create-image">Activity image</label>
                    <input class="activity-create-input" id="create-image" type="file" name="image" accept="image/*">
                </div>

                <div class="activity-create-field full">
                    <label class="activity-create-label" for="create-status">Status</label>
                    <select class="activity-create-select" id="create-status" name="status">
                        <option value="Actif">Actif</option>
                        <option value="Inactif">Inactif</option>
                    </select>
                </div>

                <div class="activity-create-actions">
                    <button type="button" class="activity-create-cancel" onclick="window.closeActivityCreateModal(); return false;">Cancel</button>
                    <button type="submit" class="activity-create-submit">Create activity</button>
                </div>
            </form>
        </div>
    </div>




    {# ── AI Activity Assistant Chatbot ── #}
<button class="ai-chat-fab" id="aiChatFab" title="AI Activity Assistant" aria-label="Open AI assistant">
    <div class="ai-chat-fab-pulse"></div>
    🤖
</button>

<div class="ai-chat-window" id="aiChatWindow" role="dialog" aria-modal="true" aria-label="AI Activity Assistant">
    <div class="ai-chat-header">
        <div class="ai-chat-header-avatar">🤖</div>
        <div class="ai-chat-header-info">
            <p class="ai-chat-header-name">Activity AI Assistant</p>
            <p class="ai-chat-header-sub">Powered by Grok · Helps you build your activity</p>
        </div>
        <button class="ai-chat-header-close" id="aiChatClose" aria-label="Close">✕</button>
    </div>

    <div class="ai-chat-messages" id="aiChatMessages"></div>

    <div class="ai-chat-chips" id="aiChatChips">
        <button class="ai-chip" data-q="Suggest a compelling description for my activity">✍️ Write description</button>
        <button class="ai-chip" data-q="What are the best places to visit in Tunisia for outdoor activities?">📍 Best places</button>
        <button class="ai-chip" data-q="What is the best season for outdoor activities in Tunisia?">🌤️ Best season</button>
        <button class="ai-chip" data-q="What price should I set for a guided day activity in Tunisia?">💰 Pricing advice</button>
        <button class="ai-chip" data-q="What categories of activities are most popular with tourists?">🏷️ Popular categories</button>
        <button class="ai-chip" data-q="What duration is ideal for a tourism activity?">⏱️ Duration tips</button>
    </div>

    <div class="ai-chat-input-row">
        <textarea
            class="ai-chat-input"
            id="aiChatInput"
            rows="1"
            placeholder="Ask me anything about your activity..."
            aria-label="Chat message"
        ></textarea>
        <button class="ai-chat-send" id="aiChatSend" aria-label="Send">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="white"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
        </button>
    </div>
</div>


{% endblock %}
