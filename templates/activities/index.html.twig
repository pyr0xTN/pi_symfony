    function bindEvents() {
        if (eventsBound) {
            return;
        }
        eventsBound = true;

        fab.addEventListener('click', function () {
            if (!fab.classList.contains('visible')) {
                return;
            }
            var isOpen = chatWin.classList.toggle('open');
            if (isOpen) initChat();
        });
        closeBtn.addEventListener('click', function () {
            chatWin.classList.remove('open');
        });
        chipsEl.addEventListener('click', function (e) {
            var chip = e.target.closest('.ai-chip');
            if (!chip) return;
            var q = chip.getAttribute('data-q');
            if (q) sendMessage(q);
        });
        sendBtn.addEventListener('click', function () {
            sendMessage(inputEl.value.trim());
        });
        inputEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage(inputEl.value.trim());
            }
        });
        inputEl.addEventListener('input', function () {
            this.style.height = '';
            this.style.height = Math.min(this.scrollHeight, 90) + 'px';
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && chatWin) chatWin.classList.remove('open');
        });

        document.addEventListener('rehletna:activity-create-open', setFabVisibility);
        document.addEventListener('rehletna:activity-create-close', setFabVisibility);
    }

    function boot() {
        if (!initElements()) return;
        bindEvents();
        syncFabVisibility();
    }

    document.addEventListener('DOMContentLoaded', boot);
    document.addEventListener('turbo:load', boot);
    if (document.readyState !== 'loading') boot();
})();



































































