            background: rgba(220, 38, 38, 0.94);
            color: #fff;
            font-size: 18px;
            line-height: 1;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 16px rgba(220, 38, 38, 0.28);
        }

        .activity-admin-delete-btn:hover {
