            background: rgba(255, 255, 255, 0.75);
            border: none;
            border-radius: 999px;
            color: #49617a;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .nav-tab:hover {
            background: #ffffff;
            color: #0FA5A2;
        }

        .nav-tab.active {
            background: linear-gradient(135deg, #0FA5A2 0%, #1788b6 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(15, 165, 162, 0.26);
        }

        .content-area {
            flex: 1;
            padding: 22px 28px 36px;
            background: transparent;
        }

        .welcome-section {
            margin-bottom: 24px;
            padding: 28px;
            border-radius: 24px;
            background: linear-gradient(120deg, #ffffff 0%, #f7fbff 100%);
            box-shadow: 0 16px 34px rgba(7, 57, 107, 0.09);
        }

        .welcome-title {
            font-size: clamp(2rem, 3.8vw, 3rem);
            font-weight: 800;
            color: #133f6a;
            margin-bottom: 8px;
            line-height: 1.06;
