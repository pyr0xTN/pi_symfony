{% extends 'base.html.twig' %}

{% block title %}Activity statistics – Rehletna.tn{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Satoshi:wght@400;500;700;900&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap');

        :root {
            --teal:    #00C9B1;
            --teal-2:  #00A896;
            --blue:    #3B82F6;
            --violet:  #8B5CF6;
            --amber:   #F59E0B;
            --rose:    #F43F5E;
            --mint:    #D1FAF4;
            --sky:     #E0F2FE;
            --lavender:#EDE9FE;
            --peach:   #FFF1F2;
            --page-bg: #F0F7FF;
        }

        .main-container {
            display: flex;
            min-height: 100vh;
            background: radial-gradient(1400px 500px at 10% -20%, rgba(10, 160, 159, 0.22), transparent 60%), radial-gradient(1000px 500px at 100% 0%, rgba(252, 186, 48, 0.20), transparent 55%), linear-gradient(180deg, #f4f9ff 0%, #eff6fb 100%);
            font-family: 'Satoshi', 'Segoe UI', sans-serif;
        }

        .side-menu {
            position: fixed;
            left: -300px;
            top: 0;
            width: 300px;
            height: 100vh;
            background: linear-gradient(180deg, #ffffff 0%, #f3f9ff 100%);
            box-shadow: 10px 0 32px rgba(3, 39, 75, 0.15);
            transition: left 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
        }

        .side-menu.open { left: 0; }
        .side-menu-content { padding: 28px 22px; }

        .user-info {
            text-align: center;
            padding-bottom: 18px;
            margin-bottom: 18px;
        }

        .avatar {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            margin: 0 auto 10px;
            background: linear-gradient(145deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(7, 57, 107, 0.25);
        }

        .user-name {
            font-size: 15px;
            font-weight: 700;
            color: #11406f;
            margin: 0;
        }

        .user-role {
            font-size: 12px;
            color: #d29a16;
            font-weight: 700;
            margin: 2px 0 0;
            text-transform: capitalize;
        }

        .side-menu-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: 0;
            border-radius: 12px;
            padding: 11px 13px;
            margin-bottom: 8px;
            cursor: pointer;
            text-align: left;
            font-weight: 700;
            color: #1d4d7c;
            background: rgba(15, 165, 162, 0.1);
            transition: transform .15s ease, background .15s ease;
        }

        .side-menu-btn:hover {
            transform: translateX(3px);
            background: rgba(15, 165, 162, 0.18);
        }

        .logout-btn {
            margin-top: 12px;
            background: rgba(244, 63, 94, 0.12);
            color: #be123c;
        }

        .menu-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 18, 36, .45);
            z-index: 900;
            opacity: 0;
            pointer-events: none;
            transition: opacity .2s ease;
        }

        .menu-overlay.show {
            opacity: 1;
            pointer-events: auto;
        }

        .top-bar {
            margin: 18px 20px 10px;
            border-radius: 18px;
            padding: 12px 16px;
            background: rgba(255,255,255,.92);
            box-shadow: 0 12px 30px rgba(3,39,75,.10);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .menu-toggle {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 0;
            background: rgba(15,165,162,.14);
            cursor: pointer;
            display: inline-flex;
            flex-direction: column;
            justify-content: center;
            gap: 4px;
            margin-right: 10px;
        }

        .menu-toggle span {
            width: 18px;
            height: 2px;
            background: #1d4d7c;
            border-radius: 2px;
            margin-left: 11px;
        }

        .logo img {
            width: 130px;
            height: auto;
            display: block;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile-name {
            margin: 0;
            color: #11406f;
            font-size: 13px;
            font-weight: 800;
            text-align: right;
        }

        .profile-role {
            margin: 0;
            color: #d29a16;
            font-size: 11px;
            font-weight: 700;
            text-align: right;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(145deg, #0FA5A2, #1D4D7C);
            color: #fff;
            font-weight: 800;
            position: relative;
        }

        .online-status {
            position: absolute;
            right: 2px;
            bottom: 2px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #22c55e;
            border: 2px solid #fff;
        }

        .nav-tabs {
            margin: 0 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 6px;
        }

        .nav-tab {
            border: 0;
            text-decoration: none;
            white-space: nowrap;
            border-radius: 999px;
            padding: 10px 14px;
            background: rgba(15,165,162,.10);
            color: #1d4d7c;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .nav-tab.active {
            background: linear-gradient(135deg, #0fa5a2, #1788b6);
            color: #fff;
        }

        .content-area {
            margin: 0 20px 20px;
        }

        /* Exact Activities shell styles */
        .main-container {
            font-family: 'Sora', 'Segoe UI', sans-serif;
        }

        .side-menu {
            border-right: none;
        }

        .user-info {
            border-bottom: none;
        }

        .side-menu-btn {
            width: 100%;
            text-align: left;
            padding: 12px 18px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 14px;
            color: #33506f;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            font-weight: 600;
            transform: none;
        }

        .side-menu-btn:hover {
            background: rgba(10, 160, 159, 0.10);
            border-color: rgba(10, 160, 159, 0.22);
            color: #0b8e8b;
            transform: none;
        }

        .logout-btn {
            margin-top: 18px;
            background: #fff2f2;
            color: #d94a5a;
            font-weight: 700;
            border-color: #ffd9de;
        }

        .logout-btn:hover {
            background: #ffe9ec;
            border-color: #ffccd4;
            color: #c03b4d;
        }

        .menu-overlay {
            display: none;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(3, 30, 58, 0.40);
            backdrop-filter: blur(2px);
            z-index: 999;
            opacity: 1;
            pointer-events: auto;
        }

        .menu-overlay.show {
            display: block;
        }

        .top-bar {
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(10px);
            padding: 16px 28px;
            box-shadow: 0 8px 24px rgba(10, 46, 88, 0.08);
            border-bottom: none;
            border-radius: 0;
            margin: 0;
        }

        .logo {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            height: 40px;
            width: auto;
            display: flex;
            align-items: center;
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        .menu-toggle {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            margin-right: 12px;
            border-radius: 10px;
            transition: background 0.2s ease;
            width: auto;
            height: auto;
            display: block;
        }

        .menu-toggle:hover {
            background: rgba(10, 160, 159, 0.10);
        }

        .menu-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: #1D4D7C;
            margin: 5px 0;
            transition: 0.3s;
            border-radius: 0;
            margin-left: 0;
        }

        .profile-section {
            gap: 12px;
            cursor: pointer;
            padding: 6px 8px 6px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(80, 149, 198, 0.16);
            transition: all 0.25s ease;
        }

        .profile-info {
            text-align: right;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 700;
            color: #1D4D7C;
        }

        .profile-role {
            font-size: 11px;
            color: #d19a1a;
            font-weight: 700;
            text-transform: capitalize;
        }

        .profile-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            position: relative;
            box-shadow: 0 8px 20px rgba(7, 57, 107, 0.20);
        }

        .online-status {
            position: absolute;
            bottom: 1px;
            right: 1px;
            width: 12px;
            height: 12px;
            background: #2ecc71;
            border-radius: 50%;
            border: 2px solid white;
        }

        .nav-tabs {
            background: transparent;
            padding: 10px 28px 0;
            border-bottom: 0;
            display: flex;
            gap: 10px;
            overflow-x: auto;
            scrollbar-width: none;
            margin: 0;
        }

        .nav-tabs::-webkit-scrollbar {
            display: none;
        }

        .nav-tab {
            padding: 10px 18px;
            background: rgba(255, 255, 255, 0.75);
            border: none;
            border-radius: 999px;
            color: #49617a;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .nav-tab:hover {
            background: #ffffff;
            color: #0FA5A2;
        }

        .nav-tab.active {
            background: linear-gradient(135deg, #0FA5A2 0%, #1788b6 100%);
            color: #fff;
            box-shadow: 0 8px 18px rgba(15, 165, 162, 0.26);
        }

        .content-area {
            flex: 1;
            padding: 22px 28px 36px;
            background: transparent;
            margin: 0;
        }

        body.dark-mode .main-container {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%) !important;
        }

        body.dark-mode .top-bar {
            background: rgba(30, 30, 50, 0.95) !important;
        }

        body.dark-mode .nav-tab {
            background: rgba(255, 255, 255, 0.05) !important;
            color: #b8d4f1 !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }

        body.dark-mode .nav-tab:hover {
            background: rgba(10, 160, 159, 0.2) !important;
            color: #0FA5A2 !important;
        }

        body.dark-mode .nav-tab.active {
            background: rgba(10, 160, 159, 0.3) !important;
            color: #0FA5A2 !important;
        }

        body.dark-mode .profile-section {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }

        body.dark-mode .profile-name {
            color: #e8f0f6 !important;
        }

        body.dark-mode .profile-role {
            color: #a8c5e0 !important;
        }

        body.dark-mode .side-menu {
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%) !important;
        }

        body.dark-mode .side-menu-btn {
            color: #a8c5e0 !important;
        }

        body.dark-mode .side-menu-btn:hover {
            background: rgba(10, 160, 159, 0.2) !important;
            border-color: rgba(10, 160, 159, 0.3) !important;
            color: #0FA5A2 !important;
        }

        body.dark-mode .user-name {
            color: #e8f0f6 !important;
        }

        body.dark-mode .user-role {
            color: #ffd89b !important;
        }

        @media (max-width: 992px) {
            .side-menu {
                box-shadow: none;
            }
        }

        * { box-sizing: border-box; }

        .s-shell {
            min-height: 100vh;
            padding: 28px 28px 60px;
            background:
                radial-gradient(ellipse 900px 560px at -5% -10%, rgba(0,201,177,.18) 0%, transparent 55%),
                radial-gradient(ellipse 700px 500px at 110%  10%, rgba(139,92,246,.14) 0%, transparent 50%),
                radial-gradient(ellipse 800px 400px at  50% 110%, rgba(59,130,246,.10) 0%, transparent 55%),
                #F0F7FF;
            font-family: 'Satoshi', 'Segoe UI', sans-serif;
        }

        .content-area .s-shell {
            min-height: auto;
            padding: 8px 0 30px;
            background: transparent;
        }

        /* ─── HERO ──────────────────────────────────────── */
        .s-hero {
            position: relative;
            overflow: hidden;
            border-radius: 32px;
            padding: 36px 40px;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 45%, #134e4a 100%);
            color: #fff;
            box-shadow:
                0 32px 64px rgba(0,0,0,.22),
                0 0 0 1px rgba(255,255,255,.06) inset;
        }

        .s-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 520px 320px at 80% 50%, rgba(0,201,177,.28), transparent 60%),
                radial-gradient(ellipse 340px 260px at 15% 80%, rgba(139,92,246,.22), transparent 55%);
            pointer-events: none;
        }

        .hero-blob {
            position: absolute;
            top: -60px; right: -60px;
            width: 340px; height: 340px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0,201,177,.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .s-hero-inner { position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }

        .s-hero h1 {
            margin: 0;
            font-family: 'Clash Display', sans-serif;
            font-size: clamp(2rem, 3.5vw, 3rem);
            font-weight: 700;
            letter-spacing: -1px;
            line-height: 1.05;
            background: linear-gradient(135deg, #fff 0%, rgba(0,201,177,.9) 80%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .s-hero p {
            margin: 12px 0 0;
            color: rgba(255,255,255,.72);
            font-size: 15px;
            max-width: 640px;
            line-height: 1.7;
        }

        .hero-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            border-radius: 999px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            backdrop-filter: blur(8px);
            transition: background .2s;
            flex-shrink: 0;
            align-self: flex-start;
        }

        .hero-back:hover { background: rgba(255,255,255,.18); }

        /* ─── LAYOUT ─────────────────────────────────────── */
        .s-layout {
            display: grid;
            grid-template-columns: minmax(0,1.2fr) minmax(310px,.8fr);
            gap: 20px;
            margin-top: 20px;
            align-items: start;
        }

        .s-col { display: grid; gap: 20px; min-width: 0; }
        .s-col-right { position: sticky; top: 20px; }

        /* ─── ANIMATIONS ─────────────────────────────────── */
        @keyframes fadeUp   { from { opacity:0; transform:translateY(18px) } to { opacity:1; transform:none } }
        @keyframes slideL   { from { opacity:0; transform:translateX(-22px) } to { opacity:1; transform:none } }
        @keyframes slideR   { from { opacity:0; transform:translateX(22px) } to { opacity:1; transform:none } }
        @keyframes popIn    { from { opacity:0; transform:scale(.94) } to { opacity:1; transform:none } }
        @keyframes spinDash { to   { stroke-dashoffset: 0 } }
        @keyframes pulse    { 0%,100% { opacity:1 } 50% { opacity:.6 } }
        @keyframes shimmer  {
            0%   { background-position: -400px 0 }
            100% { background-position:  400px 0 }
        }

        .s-col:first-child  { animation: slideL .55s .05s cubic-bezier(.22,1,.36,1) both }
        .s-col-right        { animation: slideR .55s .12s cubic-bezier(.22,1,.36,1) both }

        /* ─── CARDS ─────────────────────────────────────── */
        .s-panel {
            border-radius: 28px;
            padding: 26px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(255,255,255,.9);
            box-shadow:
                0 12px 32px rgba(0,0,0,.06),
                0 1px 0 rgba(255,255,255,.8) inset;
            backdrop-filter: blur(12px);
        }

        .s-panel h2 {
            margin: 0;
            font-family: 'Clash Display', sans-serif;
            font-size: 20px;
            font-weight: 600;
            color: #0f172a;
        }

        .s-panel-sub {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 13.5px;
        }

        /* ─── KPI GRID ───────────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .kpi-card {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            padding: 22px 20px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
            border: 1px solid rgba(255,255,255,.9);
            animation: popIn .45s cubic-bezier(.22,1,.36,1) both;
        }

        .kpi-card:nth-child(1) { animation-delay:.08s }
        .kpi-card:nth-child(2) { animation-delay:.13s }
        .kpi-card:nth-child(3) { animation-delay:.18s }
        .kpi-card:nth-child(4) { animation-delay:.23s }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            border-radius: 22px 22px 0 0;
        }

        .kpi-card.c-teal::before    { background: linear-gradient(90deg, #00C9B1, #00E5C9) }
        .kpi-card.c-blue::before    { background: linear-gradient(90deg, #3B82F6, #60A5FA) }
        .kpi-card.c-violet::before  { background: linear-gradient(90deg, #8B5CF6, #A78BFA) }
        .kpi-card.c-amber::before   { background: linear-gradient(90deg, #F59E0B, #FBBF24) }

        .kpi-icon {
            width: 42px; height: 42px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 14px;
            font-size: 20px;
        }

        .kpi-card.c-teal   .kpi-icon { background: var(--mint);    }
        .kpi-card.c-blue   .kpi-icon { background: var(--sky);     }
        .kpi-card.c-violet .kpi-icon { background: var(--lavender) }
        .kpi-card.c-amber  .kpi-icon { background: #FEF3C7;        }

        .kpi-label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            margin-bottom: 6px;
        }

        .kpi-value {
            font-family: 'Clash Display', sans-serif;
            font-size: 32px;
            font-weight: 700;
            color: #0f172a;
            line-height: 1;
        }

        .kpi-note {
            margin-top: 8px;
            font-size: 12.5px;
            color: #94a3b8;
        }

        /* ─── TOP ACTIVITY ──────────────────────────────── */
        .activity-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px;
            border-radius: 18px;
            background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
            border: 1px solid rgba(59,130,246,.12);
            margin-top: 18px;
        }

        .activity-card.activity-card--clickable {
            cursor: pointer;
        }

        .activity-card-thumb {
            width: 92px;
            height: 92px;
            border-radius: 16px;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid rgba(255,255,255,.22);
            box-shadow: 0 10px 18px rgba(2, 12, 27, .22);
        }

        .activity-card-thumb-fallback {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0fa5a2, #1d4d7c);
            color: #fff;
            font-size: 34px;
            font-weight: 800;
        }

        .activity-card-body {
            flex: 1;
            min-width: 0;
        }

        .activity-card-hint {
            margin-top: 10px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #64748b;
        }

        .activity-icon {
            width: 52px; height: 52px;
            border-radius: 16px;
            background: linear-gradient(135deg, #3B82F6, #8B5CF6);
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
            box-shadow: 0 8px 20px rgba(59,130,246,.3);
        }

        .activity-info { flex: 1; min-width: 0; }

        .activity-name {
            font-weight: 700;
            color: #0f172a;
            font-size: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .activity-meta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .meta-pill.teal   { background: var(--mint);    color: #0f766e }
        .meta-pill.blue   { background: var(--sky);     color: #1d4ed8 }
        .meta-pill.violet { background: var(--lavender); color: #6d28d9 }
        .meta-pill.amber  { background: #FEF3C7;         color: #92400e }

        .badge-active   { display:inline-flex; align-items:center; padding:5px 10px; border-radius:999px; font-size:12px; font-weight:700; background:rgba(16,185,129,.12); color:#065f46 }
        .badge-inactive { display:inline-flex; align-items:center; padding:5px 10px; border-radius:999px; font-size:12px; font-weight:700; background:rgba(245,158,11,.12); color:#92400e }

        .empty-state {
            padding: 24px;
            border-radius: 18px;
            border: 1.5px dashed rgba(100,116,139,.25);
            background: rgba(241,245,249,.7);
            color: #64748b;
            font-size: 13.5px;
            font-weight: 600;
            text-align: center;
            margin-top: 18px;
        }

        /* ─── POSTING CURVE ─────────────────────────────── */
        .curve-wrap {
            margin-top: 20px;
            border-radius: 20px;
            overflow: hidden;
            background: linear-gradient(180deg, #f8faff, #f1f5fb);
            border: 1px solid rgba(59,130,246,.10);
        }

        .curve-svg { display:block; width:100% }

        .curve-legend {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            padding: 14px 16px;
            border-top: 1px solid rgba(59,130,246,.08);
        }

        .legend-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 12px;
            border-radius: 999px;
            background: #fff;
            border: 1px solid rgba(100,116,139,.14);
            font-size: 12px;
            font-weight: 700;
            color: #475569;
        }

        .ldot { width:10px; height:10px; border-radius:50%; display:inline-block; }
        .ldot.teal   { background: #00C9B1 }
        .ldot.violet { background: #8B5CF6 }

        /* ─── CIRCULAR STATS ─────────────────────────────── */
        .circles-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
            margin-top: 20px;
        }

        .circle-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px 12px 18px;
            border-radius: 22px;
            background: #fff;
            border: 1px solid rgba(100,116,139,.1);
            box-shadow: 0 4px 16px rgba(0,0,0,.04);
            transition: transform .2s, box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

        .circle-item:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,.08) }

        .circle-item::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 3px;
        }

        .circle-item:nth-child(1)::after { background: linear-gradient(90deg, #00C9B1, #00E5C9) }
        .circle-item:nth-child(2)::after { background: linear-gradient(90deg, #8B5CF6, #A78BFA) }
        .circle-item:nth-child(3)::after { background: linear-gradient(90deg, #3B82F6, #60A5FA) }

        .circle-svg {
            width: 108px; height: 108px;
            display: block;
            overflow: visible;
        }

        .ring-track {
            fill: none;
            stroke-width: 10;
        }

        .ring-fill {
            fill: none;
            stroke-width: 10;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        .ring-glow {
            fill: none;
            stroke-width: 14;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            opacity: .25;
            filter: blur(4px);
        }

        .circle-pct {
            font-family: 'Clash Display', sans-serif;
            font-size: 22px;
            font-weight: 700;
            fill: #0f172a;
        }

        .circle-lbl {
            margin-top: 12px;
            font-size: 12.5px;
            font-weight: 700;
            color: #334155;
            text-align: center;
        }

        .circle-sub {
            margin-top: 4px;
            font-size: 11.5px;
            color: #94a3b8;
            text-align: center;
        }

        /* ─── SEASON BLOCK ───────────────────────────────── */
        .season-highlight {
            margin-top: 20px;
            padding: 22px;
            border-radius: 22px;
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            border: 1px solid rgba(16,185,129,.18);
            position: relative;
            overflow: hidden;
        }

        .season-highlight::before {
            content: '🌟';
            position: absolute;
            right: 20px; top: 50%;
            transform: translateY(-50%);
            font-size: 42px;
            opacity: .18;
        }

        .season-highlight-label {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: #059669;
            margin-bottom: 6px;
        }

        .season-highlight-name {
            font-family: 'Clash Display', sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #064e3b;
        }

        .season-highlight-avg {
            margin-top: 6px;
            font-size: 13px;
            color: #065f46;
            font-weight: 600;
        }

        .season-list { display: grid; gap: 12px; margin-top: 16px; }

        .season-row {
            border-radius: 18px;
            padding: 16px 18px;
            background: #fff;
            border: 1px solid rgba(100,116,139,.1);
            box-shadow: 0 2px 8px rgba(0,0,0,.03);
            transition: box-shadow .2s;
        }

        .season-row:hover { box-shadow: 0 6px 20px rgba(0,0,0,.07) }

        .season-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .season-name { font-weight: 700; color: #0f172a; }
        .season-range { font-size: 12.5px; color: #64748b; font-weight: 600; }

        .progress-track {
            margin-top: 12px;
            height: 8px;
            border-radius: 999px;
            background: rgba(0,0,0,.06);
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #00C9B1, #3B82F6);
            position: relative;
            transition: width .8s cubic-bezier(.22,1,.36,1);
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 12px; height: 100%;
            background: rgba(255,255,255,.5);
            border-radius: inherit;
        }

        .season-stat { margin-top: 8px; font-size: 12px; color: #64748b; }

        .activity-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 16, 30, 0.58);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 2500;
        }

        .activity-modal-overlay.show {
            display: flex;
        }

        .activity-modal {
            width: min(980px, 100%);
            max-height: calc(100vh - 36px);
            overflow: auto;
            border-radius: 28px;
            background:
                radial-gradient(760px 260px at 100% 0%, rgba(11, 164, 161, 0.12), transparent 60%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 250, 253, 0.98));
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.26);
            border: 1px solid rgba(137, 156, 174, 0.24);
        }

        .activity-modal-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(137, 156, 174, 0.16);
        }

        .activity-modal-title {
            margin: 0;
            font-size: 26px;
            color: #134563;
            font-weight: 800;
        }

        .activity-modal-close {
            border: 0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(13, 94, 138, 0.1);
            color: #0d5e8a;
            cursor: pointer;
            font-size: 18px;
            font-weight: 800;
        }

        .activity-modal-body {
            display: grid;
            grid-template-columns: minmax(280px, 360px) 1fr;
            gap: 22px;
            padding: 22px;
        }

        .activity-modal-image {
            width: 100%;
            height: 100%;
            max-height: 420px;
            object-fit: cover;
            border-radius: 22px;
            box-shadow: 0 14px 26px rgba(10, 34, 62, 0.14);
        }

        .activity-modal-info {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .activity-modal-desc {
            color: #5d7590;
            line-height: 1.7;
            margin: 0;
        }

        .activity-modal-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .activity-modal-item {
            border: 1px solid rgba(126, 152, 178, 0.22);
            border-radius: 16px;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.92);
        }

        .activity-modal-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6a8198;
            margin-bottom: 4px;
            font-weight: 800;
        }

        .activity-modal-value {
            color: #174a78;
            font-weight: 700;
        }

        .activity-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 0 22px 22px;
            flex-wrap: wrap;
        }

        .activity-modal-reserve {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 14px;
            padding: 12px 16px;
            color: #fff;
            background: linear-gradient(135deg, #0fa5a2, #1788b6);
            text-decoration: none;
            font-weight: 800;
            box-shadow: 0 10px 20px rgba(11, 154, 157, 0.22);
        }

        @media (max-width: 700px) {
            .activity-modal-body {
                grid-template-columns: 1fr;
            }

            .activity-card {
                flex-direction: column;
                align-items: stretch;
            }

            .activity-card-thumb {
                width: 100%;
                height: 180px;
            }
        }

        /* ─── RESPONSIVE ────────────────────────────────── */
        @media (max-width: 1100px) {
            .s-layout { grid-template-columns: 1fr }
            .s-col-right { position: static }
            .circles-grid { grid-template-columns: repeat(3,1fr) }
        }

        @media (max-width: 760px) {
            .s-shell { padding: 14px 14px 40px }
            .s-hero  { padding: 24px 22px }
            .kpi-grid { grid-template-columns: 1fr }
            .circles-grid { grid-template-columns: repeat(2,1fr) }
        }

        @media (max-width: 900px) {
            .top-bar,
            .nav-tabs,
            .content-area {
                margin-left: 12px;
                margin-right: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set userRoleLabel = 'main.role.member'|trans %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set userRoleLabel = 'main.role.administrator'|trans %}
    {% elseif is_granted('ROLE_GUIDE') %}
        {% set userRoleLabel = 'main.role.guide'|trans %}
    {% endif %}

    <div class="menu-overlay"></div>

    <div class="side-menu">
        <div class="side-menu-content">
            <div class="user-info">
                <div class="avatar">{{ app.user.username|first|upper }}</div>
                <p class="user-name">{{ app.user.fullName|default(app.user.username) }}</p>
                <p class="user-role">{{ userRoleLabel }}</p>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <button class="side-menu-btn" data-action="dashboard">🏠 {{ 'main.menu.dashboard'|trans }}</button>
            {% endif %}

            {% if is_granted('ROLE_GUIDE') %}
                <button class="side-menu-btn" data-action="guide-dashboard">👤 {{ 'main.menu.guide_dashboard'|trans }}</button>
            {% endif %}

            <button class="side-menu-btn" data-action="my-reservations">👤 {{ 'main.menu.my_reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="my-orders">🧾 {{ 'main.menu.my_orders'|trans }}</button>
            <button class="side-menu-btn" data-action="reservations">💻 {{ 'main.menu.reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="offers-grid">📋 {{ 'main.menu.offers_grid'|trans }}</button>

            <button class="side-menu-btn logout-btn" data-action="logout">Logout</button>
        </div>
    </div>

    <div class="main-container">
        <div style="flex: 1;">
            <div class="top-bar">
                <div style="display: flex; align-items: center;">
                    <button class="menu-toggle" type="button" aria-label="Toggle menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <div class="logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna.tn" title="Rehletna.tn" />
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="profile-section">
                        <div class="profile-info">
                            <p class="profile-name">{{ app.user.fullName|default(app.user.username) }}</p>
                            <p class="profile-role">{{ userRoleLabel }}</p>
                        </div>
                        <div class="profile-avatar">
                            {{ app.user.username|first|upper }}
                            <div class="online-status"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-tabs">
                <button class="nav-tab" data-view="services">💻 {{ 'main.tab.services'|trans }}</button>
                <a class="nav-tab" href="{{ path('app_activities') }}">🏞 {{ 'main.tab.activities'|trans }}</a>
                <button class="nav-tab" data-view="shop">🛒 {{ 'main.tab.shop'|trans }}</button>
                <button class="nav-tab" data-view="ai-guide">🤖 {{ 'main.tab.ai_guide'|trans }}</button>
                <button class="nav-tab" data-view="offers">🔖 {{ 'main.tab.offers'|trans }}</button>
                <button class="nav-tab" data-view="messenger">💬 {{ 'main.tab.messenger'|trans }}</button>
                <button class="nav-tab" data-view="post">✉️ Posts</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-tab" href="{{ path('app_admin_stats') }}">📊 {{ 'main.tab.stats'|trans }}</a>
                {% endif %}
            </div>

            <div class="content-area">
                <div class="s-shell">

        {# ── HERO ────────────────────────────────────────────── #}
        <section class="s-hero">
            <div class="hero-blob"></div>
            <div class="s-hero-inner">
                <div>
                    <h1>Activity statistics</h1>
                    <p>Track how your activities perform, where your reservations come from, and which season gives you the strongest response.</p>
                </div>
                <a class="hero-back" href="{{ path('app_activities') }}">← Back to activities</a>
            </div>
        </section>

        {% set monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] %}
        {% set maxMonthlyCreation = monthlyCreation|reduce((carry, item) => item > carry ? item : carry, 0) %}
        {% set chartPoints = [] %}
        {% for month, count in monthlyCreation %}
            {% set x = 28 + (loop.index0 * 48) %}
            {% set y = 145 - (maxMonthlyCreation > 0 ? ((count / maxMonthlyCreation) * 112) : 0) %}
            {% set chartPoints = chartPoints|merge([x ~ ',' ~ y]) %}
        {% endfor %}

        {% set activeRate      = totalActivities > 0 ? (activeActivities / totalActivities) : 0 %}
        {% set seasonStrength  = bestSeason and maxSeasonAverage > 0 ? (bestSeason.averageReservations / maxSeasonAverage) : 0 %}
        {% set reservationFill = totalBookedPlaces > 0 ? (totalReservations / totalBookedPlaces) : 0 %}
        {% set reservationFill = reservationFill > 1 ? 1 : reservationFill %}
        {% set C = 289.03 %}{# 2π × 46 #}

        <div class="s-layout">

            {# ── LEFT COLUMN ─────────────────────────────── #}
            <div class="s-col">

                {# KPI Cards #}
                <div class="kpi-grid">
                    
                    <div class="kpi-card c-amber">
                        <div class="kpi-icon">💰</div>
                        <div class="kpi-label">Revenue</div>
                        <div class="kpi-value">{{ totalRevenue|number_format(0, '.', ',') }}<span style="font-size:16px;font-weight:600;color:#94a3b8"> DT</span></div>
                        <div class="kpi-note">Based on total reservation amounts</div>
                    </div>
                </div>

                {# Top Activity #}
                <section class="s-panel">
                    <h2>Top activity</h2>
                    <p class="s-panel-sub">Your activity with the highest reservation volume.</p>

                    {% if topActivity %}
                        <div class="activity-card activity-card--clickable js-top-activity-card"
                             data-activity-id="{{ topActivity.idActivite }}"
                             data-title="{{ topActivity.titre|e('html_attr') }}"
                             data-description="{{ topActivity.description|default('No description available.')|e('html_attr') }}"
                             data-location="{{ topActivity.location|default('')|e('html_attr') }}"
                             data-category="{{ topActivity.category|default('')|e('html_attr') }}"
                             data-date="{{ topActivity.dateActivity|default('')|e('html_attr') }}"
                             data-duration="{{ topActivity.duration|default('')|e('html_attr') }}"
                             data-price="{{ topActivity.price|default(0) }}"
                             data-places="{{ topActivity.placesAvailable|default(0) }}"
                             data-image="{{ topActivity.imageUrl|default('/images/defaultact.jpg')|e('html_attr') }}"
                             data-reservations="{{ topActivity.reservationsCount }}"
                             data-booked-places="{{ topActivity.bookedPlaces }}"
                             data-revenue="{{ topActivity.revenue|number_format(2, '.', ',') }}"
                             data-status="{{ topActivity.statut|default('')|e('html_attr') }}">
                            {% if topActivity.imageUrl is not empty %}
                                <img class="activity-card-thumb" src="{{ topActivity.imageUrl }}" alt="{{ topActivity.titre|e('html_attr') }}">
                            {% else %}
                                <div class="activity-card-thumb activity-card-thumb-fallback">🏞</div>
                            {% endif %}
                            <div class="activity-card-body">
                                <div class="activity-name">{{ topActivity.titre }}</div>
                                <div class="activity-meta">
                                    <span class="{{ topActivity.statut|lower == 'actif' ? 'badge-active' : 'badge-inactive' }}">
                                        {{ topActivity.statut }}
                                    </span>
                                    <span class="meta-pill violet">🎫 {{ topActivity.reservationsCount }} reservations</span>
                                    <span class="meta-pill blue">🪑 {{ topActivity.bookedPlaces }} places</span>
                                    <span class="meta-pill amber">💰 {{ topActivity.revenue|number_format(2, '.', ',') }} DT</span>
                                </div>
                                <div class="activity-card-hint">Click to view activity details</div>
                            </div>
                        </div>
                    {% else %}
                        <div class="empty-state">No activities yet — your top performer will appear here once you publish some.</div>
                    {% endif %}
                </section>

                <section class="s-panel">
                    <h2>Best season to post</h2>
                    <p class="s-panel-sub">Based on average reservations per activity posted per season.</p>

                    {% if bestSeason and bestSeason.activityCount > 0 %}
                        <div class="season-highlight">
                            <div class="season-highlight-label">Recommended season</div>
                            <div class="season-highlight-name">{{ bestSeason.label }}</div>
                            <div class="season-highlight-avg">{{ bestSeason.range }} · {{ bestSeason.averageReservations|number_format(1, '.', ',') }} avg reservations/activity</div>
                        </div>
                    {% endif %}

                    <div class="season-list">
                        {% for season in seasonStats|filter((value) => value.activityCount > 0) %}
                            <div class="season-row">
                                <div class="season-head">
                                    <div>
                                        <div class="season-name">{{ season.label }}</div>
                                        <div class="season-range">{{ season.range }}</div>
                                    </div>
                                    <span class="meta-pill teal">{{ season.activityCount }} activities</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: {{ maxSeasonAverage > 0 ? ((season.averageReservations / maxSeasonAverage) * 100) : 0 }}%;"></div>
                                </div>
                                <div class="season-stat">{{ season.reservationCount }} reservations · {{ season.bookedPlaces }} booked places · {{ season.averageReservations|number_format(1, '.', ',') }} avg</div>
                            </div>
                        {% else %}
                            <div class="empty-state">No seasonal data yet. Post activities and the ranking will appear here.</div>
                        {% endfor %}
                    </div>
                </section>

            </div>

            {# ── RIGHT COLUMN ─────────────────────────────── #}
            <div class="s-col s-col-right">

                {# Posting Curve #}
                <section class="s-panel">
                    <h2>Posting curve</h2>
                    <section class="s-panel" style="cursor:pointer" id="curvePanelTrigger" title="Click for full breakdown">
    <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
            <h2>Posting curve</h2>
            <p class="s-panel-sub">Monthly activity creation over the year.</p>
        </div>
        <span style="font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;background:rgba(59,130,246,.08);color:#3B82F6;border:1px solid rgba(59,130,246,.15);white-space:nowrap">View details ↗</span>
    </div>
                    <div class="curve-wrap">
                        <svg class="curve-svg" viewBox="0 0 608 190" role="img" aria-label="Monthly posting curve">
                            <defs>
                                <linearGradient id="gFill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%"   stop-color="#00C9B1" stop-opacity=".4"/>
                                    <stop offset="100%" stop-color="#00C9B1" stop-opacity="0"/>
                                </linearGradient>
                                <linearGradient id="gLine" x1="0" y1="0" x2="1" y2="0">
                                    <stop offset="0%"   stop-color="#00C9B1"/>
                                    <stop offset="50%"  stop-color="#3B82F6"/>
                                    <stop offset="100%" stop-color="#8B5CF6"/>
                                </linearGradient>
                                <filter id="glowF">
                                    <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
                                    <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                                </filter>
                            </defs>

                            {# Grid lines #}
                            {% for i in [0,1,2,3] %}
                                <line x1="20" y1="{{ 30 + i*38 }}" x2="592" y2="{{ 30 + i*38 }}" stroke="rgba(100,116,139,.09)" stroke-width="1"/>
                            {% endfor %}

                            {# Fill area #}
                            <path d="M 28 145 L {{ chartPoints|join(' L ') }} L 556 145 L 28 145 Z" fill="url(#gFill)"/>

                            {# Glow line #}
                            <polyline points="{{ chartPoints|join(' ') }}" fill="none" stroke="#00C9B1" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" opacity=".15"/>

                            {# Main line #}
                            <polyline points="{{ chartPoints|join(' ') }}" fill="none" stroke="url(#gLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>

                            {# Data points #}
                            {% for point in chartPoints %}
                                {% set coords = point|split(',') %}
                                <circle cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="5" fill="#fff" stroke="url(#gLine)" stroke-width="2.5"/>
                            {% endfor %}

                            {# Month labels #}
                            {% for month, count in monthlyCreation %}
                                {% set x = 28 + (loop.index0 * 48) %}
                                <text x="{{ x }}" y="178" text-anchor="middle" font-size="10" fill="#94a3b8" font-weight="700" font-family="Satoshi, sans-serif">{{ monthNames[month - 1] }}</text>
                            {% endfor %}
                        </svg>

                        <div class="curve-legend">
                            <span class="legend-pill"><span class="ldot teal"></span> Posted activities</span>
                            <span class="legend-pill"><span class="ldot violet"></span> Gradient = months</span>
                        </div>
                    </div>
                </section>

                {# Circular Stats #}
                <section class="s-panel">
                    <h2>Performance rings</h2>
                    <p class="s-panel-sub">Key ratios visualised as animated rings.</p>

                    <div class="circles-grid">
 
                        {# Active rate #}
                        <div class="circle-item">
                            <svg class="circle-svg" viewBox="0 0 108 108">
                                <defs>
                                    <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%"   stop-color="#00C9B1"/>
                                        <stop offset="100%" stop-color="#00E5C9"/>
                                    </linearGradient>
                                </defs>
                                <circle class="ring-track" cx="54" cy="54" r="46" stroke="rgba(0,201,177,.12)"/>
                                <circle class="ring-glow"  cx="54" cy="54" r="46" stroke="#00C9B1"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - activeRate) }}"/>
                                <circle class="ring-fill"  cx="54" cy="54" r="46" stroke="url(#g1)"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - activeRate) }}"/>
                                <text class="circle-pct" x="54" y="59" text-anchor="middle" dominant-baseline="central" font-family="Clash Display, sans-serif" font-size="20" font-weight="700" fill="#0f172a">{{ (activeRate * 100)|round }}%</text>
                            </svg>
                            <div class="circle-lbl">Active rate</div>
                            <div class="circle-sub">{{ activeActivities }} / {{ totalActivities }}</div>
                        </div>

                        {# Season strength #}
                        <div class="circle-item">
                            <svg class="circle-svg" viewBox="0 0 108 108">
                                <defs>
                                    <linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%"   stop-color="#8B5CF6"/>
                                        <stop offset="100%" stop-color="#A78BFA"/>
                                    </linearGradient>
                                </defs>
                                <circle class="ring-track" cx="54" cy="54" r="46" stroke="rgba(139,92,246,.12)"/>
                                <circle class="ring-glow"  cx="54" cy="54" r="46" stroke="#8B5CF6"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - seasonStrength) }}"/>
                                <circle class="ring-fill"  cx="54" cy="54" r="46" stroke="url(#g2)"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - seasonStrength) }}"/>
                                <text class="circle-pct" x="54" y="59" text-anchor="middle" dominant-baseline="central" font-family="Clash Display, sans-serif" font-size="20" font-weight="700" fill="#0f172a">{{ (seasonStrength * 100)|round }}%</text>
                            </svg>
                            <div class="circle-lbl">Season power</div>
                            <div class="circle-sub">vs best season</div>
                        </div>

                        {# Fill ratio #}
                        <div class="circle-item">
                            <svg class="circle-svg" viewBox="0 0 108 108">
                                <defs>
                                    <linearGradient id="g3" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%"   stop-color="#3B82F6"/>
                                        <stop offset="100%" stop-color="#60A5FA"/>
                                    </linearGradient>
                                </defs>
                                <circle class="ring-track" cx="54" cy="54" r="46" stroke="rgba(59,130,246,.12)"/>
                                <circle class="ring-glow"  cx="54" cy="54" r="46" stroke="#3B82F6"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - reservationFill) }}"/>
                                <circle class="ring-fill"  cx="54" cy="54" r="46" stroke="url(#g3)"
                                    stroke-dasharray="{{ C }}"
                                    stroke-dashoffset="{{ C * (1 - reservationFill) }}"/>
                                <text class="circle-pct" x="54" y="59" text-anchor="middle" dominant-baseline="central" font-family="Clash Display, sans-serif" font-size="20" font-weight="700" fill="#0f172a">{{ (reservationFill * 100)|round }}%</text>
                            </svg>
                            <div class="circle-lbl">Place fill</div>
                            <div class="circle-sub">reservations / places</div>
                        </div>

                    </div>
                </section>

                {# Season Rankings #}
                

            </div>{# /right col #}
        </div>{# /layout #}

        <div class="activity-modal-overlay" id="activityDetailsModal" aria-hidden="true">
            <div class="activity-modal" role="dialog" aria-modal="true" aria-labelledby="activityDetailsTitle">
                <div class="activity-modal-head">
                    <h2 class="activity-modal-title" id="activityDetailsTitle">Activity details</h2>
                    <button type="button" class="activity-modal-close" id="activityDetailsClose" aria-label="Close">✕</button>
                </div>
                <div class="activity-modal-body">
                    <img class="activity-modal-image" id="activityDetailsImage" src="" alt="Activity image">
                    <div class="activity-modal-info">
                        <p class="activity-modal-desc" id="activityDetailsDescription"></p>
                        <div class="activity-modal-grid">
                            <div class="activity-modal-item"><span class="activity-modal-label">Location</span><div class="activity-modal-value" id="activityDetailsLocation"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Category</span><div class="activity-modal-value" id="activityDetailsCategory"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Date</span><div class="activity-modal-value" id="activityDetailsDate"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Duration</span><div class="activity-modal-value" id="activityDetailsDuration"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Price</span><div class="activity-modal-value" id="activityDetailsPrice"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Available places</span><div class="activity-modal-value" id="activityDetailsPlaces"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Reservations</span><div class="activity-modal-value" id="activityDetailsReservations"></div></div>
                            <div class="activity-modal-item"><span class="activity-modal-label">Revenue</span><div class="activity-modal-value" id="activityDetailsRevenue"></div></div>
                        </div>
                    </div>
                </div>
                <div class="activity-modal-actions">
                    <button type="button" class="activity-modal-reserve" id="activityDetailsOk">Close</button>
                </div>
            </div>
        </div>


        <div class="activity-modal-overlay" id="curveModal" aria-hidden="true">
    <div class="activity-modal" role="dialog" aria-modal="true" style="max-width:780px">
        <div class="activity-modal-head">
            <h2 class="activity-modal-title">Posting curve — monthly breakdown</h2>
            <button type="button" class="activity-modal-close" id="curveModalClose" aria-label="Close">✕</button>
        </div>
        <div style="padding:22px;display:grid;gap:20px;">

          
            <div style="border-radius:18px;overflow:hidden;background:linear-gradient(180deg,#f8faff,#f1f5fb);border:1px solid rgba(59,130,246,.10);">
                <svg style="display:block;width:100%" viewBox="0 0 680 240" role="img" aria-label="Monthly posting curve detailed">
                    <defs>
                        <linearGradient id="cmFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%"   stop-color="#00C9B1" stop-opacity=".45"/>
                            <stop offset="100%" stop-color="#00C9B1" stop-opacity="0"/>
                        </linearGradient>
                        <linearGradient id="cmLine" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0%"   stop-color="#00C9B1"/>
                            <stop offset="50%"  stop-color="#3B82F6"/>
                            <stop offset="100%" stop-color="#8B5CF6"/>
                        </linearGradient>
                    </defs>
                    {% for i in [0,1,2,3,4] %}
                        <line x1="40" y1="{{ 20 + i*40 }}" x2="660" y2="{{ 20 + i*40 }}" stroke="rgba(100,116,139,.09)" stroke-width="1"/>
                        <text x="32" y="{{ 24 + i*40 }}" text-anchor="end" font-size="9" fill="#94a3b8" font-family="Satoshi,sans-serif">{{ maxMonthlyCreation - (i * (maxMonthlyCreation / 4))|round }}</text>
                    {% endfor %}
                    {% set cmPoints = [] %}
                    {% for month, count in monthlyCreation %}
                        {% set cx = 40 + (loop.index0 * 53) %}
                        {% set cy = 180 - (maxMonthlyCreation > 0 ? ((count / maxMonthlyCreation) * 150) : 0) %}
                        {% set cmPoints = cmPoints|merge([cx ~ ',' ~ cy]) %}
                    {% endfor %}
                    <path d="M 40 180 L {{ cmPoints|join(' L ') }} L 613 180 L 40 180 Z" fill="url(#cmFill)"/>
                    <polyline points="{{ cmPoints|join(' ') }}" fill="none" stroke="#00C9B1" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" opacity=".12"/>
                    <polyline points="{{ cmPoints|join(' ') }}" fill="none" stroke="url(#cmLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    {% for point in cmPoints %}
                        {% set coords = point|split(',') %}
                        <circle cx="{{ coords[0] }}" cy="{{ coords[1] }}" r="5" fill="#fff" stroke="url(#cmLine)" stroke-width="2.5"/>
                    {% endfor %}
                    {% for month, count in monthlyCreation %}
                        {% set cx = 40 + (loop.index0 * 53) %}
                        {% set cy = 180 - (maxMonthlyCreation > 0 ? ((count / maxMonthlyCreation) * 150) : 0) %}
                        {% if count > 0 %}
                            <text x="{{ cx }}" y="{{ cy - 10 }}" text-anchor="middle" font-size="10" fill="#3B82F6" font-weight="700" font-family="Satoshi,sans-serif">{{ count }}</text>
                        {% endif %}
                        <text x="{{ cx }}" y="220" text-anchor="middle" font-size="10" fill="#94a3b8" font-weight="700" font-family="Satoshi,sans-serif">{{ monthNames[month - 1] }}</text>
                    {% endfor %}
                </svg>
            </div>

         
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
                {% for month, count in monthlyCreation %}
                    {% if count > 0 %}
                        <div style="border-radius:14px;padding:12px 14px;background:#fff;border:1px solid rgba(100,116,139,.1);box-shadow:0 2px 8px rgba(0,0,0,.03)">
                            <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:4px">{{ monthNames[month - 1] }}</div>
                            <div style="font-family:'Clash Display',sans-serif;font-size:22px;font-weight:700;color:#0f172a;line-height:1">{{ count }}</div>
                            <div style="margin-top:6px;height:5px;border-radius:999px;background:rgba(0,0,0,.06);overflow:hidden">
                                <div style="height:100%;border-radius:inherit;background:linear-gradient(90deg,#00C9B1,#3B82F6);width:{{ maxMonthlyCreation > 0 ? ((count / maxMonthlyCreation) * 100) : 0 }}%"></div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

           
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
                <div style="border-radius:16px;padding:16px;background:linear-gradient(135deg,#ecfdf5,#d1fae5);border:1px solid rgba(16,185,129,.18)">
                    <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#059669;margin-bottom:6px">Total posted</div>
                    <div style="font-family:'Clash Display',sans-serif;font-size:26px;font-weight:700;color:#064e3b">{{ totalActivities }}</div>
                </div>
                <div style="border-radius:16px;padding:16px;background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid rgba(59,130,246,.18)">
                    <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#1d4ed8;margin-bottom:6px">Peak month</div>
                    <div style="font-family:'Clash Display',sans-serif;font-size:26px;font-weight:700;color:#1e3a8a">
                        {% set peakMonth = 1 %}
                        {% set peakCount = 0 %}
                        {% for month, count in monthlyCreation %}
                            {% if count > peakCount %}
                                {% set peakCount = count %}
                                {% set peakMonth = month %}
                            {% endif %}
                        {% endfor %}
                        {{ monthNames[peakMonth - 1] }}
                    </div>
                </div>
                <div style="border-radius:16px;padding:16px;background:linear-gradient(135deg,#fdf4ff,#ede9fe);border:1px solid rgba(139,92,246,.18)">
                    <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#7c3aed;margin-bottom:6px">Active months</div>
                    <div style="font-family:'Clash Display',sans-serif;font-size:26px;font-weight:700;color:#4c1d95">{{ monthlyCreation|filter(c => c > 0)|length }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
                </div>{# /shell #}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            function initializeStatsShell() {
                var pageRoot = document.querySelector('.content-area .s-shell');
                if (!pageRoot) {
                    return;
                }
                if (pageRoot.getAttribute('data-shell-init') === '1') {
                    return;
                }
                pageRoot.setAttribute('data-shell-init', '1');

                // Curve modal
var curveTrigger = document.getElementById('curvePanelTrigger');
var curveModal   = document.getElementById('curveModal');
var curveClose   = document.getElementById('curveModalClose');

if (curveTrigger && curveModal) {
    curveTrigger.addEventListener('click', function () {
        curveModal.classList.add('show');
        curveModal.setAttribute('aria-hidden', 'false');
    });
}
if (curveClose) {
    curveClose.addEventListener('click', function () {
        curveModal.classList.remove('show');
        curveModal.setAttribute('aria-hidden', 'true');
    });
}
if (curveModal) {
    curveModal.addEventListener('click', function (e) {
        if (e.target === curveModal) {
            curveModal.classList.remove('show');
            curveModal.setAttribute('aria-hidden', 'true');
        }
    });
}

                var menuToggle = document.querySelector('.menu-toggle');
                var sideMenu = document.querySelector('.side-menu');
                var overlay = document.querySelector('.menu-overlay');

                if (menuToggle && sideMenu && overlay) {
                    menuToggle.addEventListener('click', function () {
                        sideMenu.classList.toggle('open');
                        overlay.classList.toggle('show');
                    });

                    overlay.addEventListener('click', function () {
                        sideMenu.classList.remove('open');
                        overlay.classList.remove('show');
                    });
                }

                document.querySelectorAll('.nav-tab[data-view]').forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        var view = tab.getAttribute('data-view');
                        if (!view) return;
                        window.location.href = '{{ path('app_mainpage') }}?module=' + encodeURIComponent(view);
                    });
                });

                document.querySelectorAll('.side-menu-btn').forEach(function (button) {
                    button.addEventListener('click', function () {
                        var action = button.getAttribute('data-action');
                        if (action === 'logout') {
                            window.location.href = '{{ path('app_logout') }}';
                        } else if (action === 'dashboard') {
                            window.location.href = '{{ path('app_dashboard') }}';
                        } else if (action === 'guide-dashboard') {
                            window.location.href = '{{ path('app_guide_dashboard') }}';
                        } else if (action === 'reservations') {
                            window.location.href = '{{ path('app_reservations') }}';
                        } else if (action === 'my-reservations') {
                            window.location.href = '{{ path('app_my_reservations') }}';
                        } else if (action === 'my-orders') {
                            window.location.href = '{{ path('app_my_orders') }}';
                        } else if (action === 'offers-grid') {
                            window.location.href = '{{ path('app_offers_grid') }}';
                        }
                    });
                });

                var topActivityCard = document.querySelector('.js-top-activity-card');
                var detailsModal = document.getElementById('activityDetailsModal');
                var detailsClose = document.getElementById('activityDetailsClose');
                var detailsOk = document.getElementById('activityDetailsOk');

                function setDetailsText(id, value, fallback) {
                    var element = document.getElementById(id);
                    if (element) {
                        element.textContent = value && String(value).trim() !== '' ? value : (fallback || '-');
                    }
                }

                function openDetails(card) {
                    if (!card || !detailsModal) {
                        return;
                    }

                    var image = document.getElementById('activityDetailsImage');
                    if (image) {
                        image.src = card.dataset.image || '/images/defaultact.jpg';
                        image.alt = card.dataset.title || 'Activity image';
                    }

                    setDetailsText('activityDetailsTitle', card.dataset.title || 'Activity details', 'Activity details');
                    setDetailsText('activityDetailsDescription', card.dataset.description, 'No description available.');
                    setDetailsText('activityDetailsLocation', card.dataset.location, '-');
                    setDetailsText('activityDetailsCategory', card.dataset.category, '-');
                    setDetailsText('activityDetailsDate', card.dataset.date, '-');
                    setDetailsText('activityDetailsDuration', card.dataset.duration ? (card.dataset.duration + ' h') : '', '-');
                    setDetailsText('activityDetailsPrice', card.dataset.price ? (card.dataset.price + ' coins') : '', '-');
                    setDetailsText('activityDetailsPlaces', card.dataset.places, '-');
                    setDetailsText('activityDetailsReservations', card.dataset.reservations ? (card.dataset.reservations + ' reservations') : '', '-');
                    setDetailsText('activityDetailsRevenue', card.dataset.revenue ? (card.dataset.revenue + ' DT') : '', '-');

                    detailsModal.classList.add('show');
                    detailsModal.setAttribute('aria-hidden', 'false');
                }

                function closeDetails() {
                    if (!detailsModal) {
                        return;
                    }
                    detailsModal.classList.remove('show');
                    detailsModal.setAttribute('aria-hidden', 'true');
                }

                if (topActivityCard) {
                    topActivityCard.addEventListener('click', function (event) {
                        if (event.target.closest('button, a, form, input, select, textarea, label')) {
                            return;
                        }
                        openDetails(topActivityCard);
                    });
                }

                if (detailsClose) {
                    detailsClose.addEventListener('click', closeDetails);
                }

                if (detailsOk) {
                    detailsOk.addEventListener('click', closeDetails);
                }

                if (detailsModal) {
                    detailsModal.addEventListener('click', function (event) {
                        if (event.target === detailsModal) {
                            closeDetails();
                        }
                    });
                }

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        closeDetails();
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', initializeStatsShell);
            document.addEventListener('turbo:load', initializeStatsShell);
            if (document.readyState !== 'loading') {
                initializeStatsShell();
            }
        })();
    </script>
{% endblock %}
