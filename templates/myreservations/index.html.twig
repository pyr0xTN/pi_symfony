{% extends 'base.html.twig' %}
{% block stylesheets %}
    <!-- Favicon -->
    <link rel="icon" href="{{asset('assets/legacy/img/core-img/favicon.ico')}}">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="{{ asset('assets/legacy/style.css') }}">
    
    <style>
        .sidebar-logo img { height: 45px; }
        .palatin-main-menu { height: 85px; display: flex; align-items: center; }
        .classynav ul li a { font-weight: 700; color: #1f2b5b; text-transform: uppercase; }
        .classynav ul li.active a { color: #fbbe30; }
        
        .reservation-card { background: #fff; border: 1px solid #ebebeb; border-radius: 10px; transition: all 0.4s; overflow: hidden; }
        .reservation-card:hover { box-shadow: 0 10px 40px rgba(0,0,0,0.1); border-color: transparent; }
        .rc-header { border-bottom: 1px solid #f0f0f0; margin-bottom: 15px; padding-bottom: 15px; }
        .rc-name { font-size: 18px; color: #1f2b5b; font-weight: 700; margin-bottom: 5px; }
        .rc-detail-item { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; color: #666; font-size: 14px; }
        .badge-pending { background: #FCBE31; color: white; border-radius: 50px; padding: 4px 12px; }
        .badge-success { background: #27ae60; color: white; border-radius: 50px; padding: 4px 12px; }
        .badge-danger { background: #e74c3c; color: white; border-radius: 50px; padding: 4px 12px; }
        .rc-btn { display: inline-block; padding: 10px 15px; text-align: center; border-radius: 5px; font-weight: 700; font-size: 13px; transition: 0.3s; text-decoration: none; border: none; cursor: pointer; }
        .rc-btn-primary { background: #00BFFF; color: #fff; }
        .rc-btn-danger { background: #ff5e62; color: #fff; }
        .rc-btn-info { background: #1f2b5b; color: #fff; }
    </style>
{% endblock %}

{% block body %}
    <!-- ##### Header Area Start ##### -->
    <header class="header-area">
        <div class="palatin-main-menu">
            <div class="classy-nav-container breakpoint-off">
                <div class="container">
                    <nav class="classy-navbar justify-content-between" id="palatinNav">
                        <div class="sidebar-logo">
                            <img src="{{ asset('images/logo.png') }}" alt="Rehletna Logo" />
                        </div>
                        <div class="classy-menu">
                            <div class="classynav">
                                <ul>
                                    <li><a href="{{path('ourservices_index')}}">Services</a></li>
                                    <li class="active"><a href="{{path('myreservations_index')}}">My reservations</a></li>
                                </ul>
                                <div class="menu-btn">
                                    <a href="{{ path('app_mainpage') }}" class="btn palatin-btn" data-turbo="false">HOME</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>

    <!-- ##### Breadcumb Area Start ##### -->
    <section class="breadcumb-area bg-img d-flex align-items-center justify-content-center" style="background-image: url({{asset('assets/legacy/img/bg-img/bg-3.jpg')}});">
        <div class="bradcumbContent">
            <h2>My Reservations</h2>
        </div>
    </section>

    <!-- ##### Core Features Start ##### -->
    <section class="core-features-area section-padding-100-0">
        <div class="container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'danger' or type == 'error' ? 'danger' : (type == 'success' ? 'success' : 'info') }} alert-dismissible fade show mb-4" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="row">
                {% if pagination is empty %}
                    <div class="col-12 text-center py-5">
                        <span style="font-size: 3rem;">📄</span>
                        <p class="mt-3">Aucune réservation trouvée.</p>
                        <a href="{{ path('ourservices_index') }}" class="btn palatin-btn mt-3">Browse Services</a>
                    </div>
                {% else %}
                    {% for reservation in pagination %}
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-30">
                            <div class="reservation-card h-100 d-flex flex-column p-4">
                                <div class="rc-header">
                                    <h3 class="rc-name">{{ reservation.nom }}</h3>
                                    {% set status = reservation.statut|lower %}
                                    {% set badgeClass = 'badge-info' %}
                                    {% if status == 'confirmée' or status == 'confirmed' %} {% set badgeClass = 'badge-success' %}
                                    {% elseif status == 'en attente' or status == 'pending' %} {% set badgeClass = 'badge-pending' %}
                                    {% elseif status == 'annulée' or status == 'cancelled' %} {% set badgeClass = 'badge-danger' %}
                                    {% endif %}
                                    <span class="badge {{ badgeClass }}">{{ reservation.statut|upper }}</span>
                                </div>

                                <div class="rc-body flex-grow-1">
                                    <div class="rc-detail-item">
                                        <span style="font-size: 16px;">📅</span>
                                        <span>{{ reservation.dateReservation|date('d/m/Y') }}</span>
                                    </div>
                                    <div class="rc-detail-item">
                                        <span style="font-size: 16px;">🛎️</span>
                                        <span>{{ reservation.idService.nom }}</span>
                                    </div>
                                    <div class="rc-detail-item">
                                        <span style="font-size: 16px;">💳</span>
                                        <span>{{ reservation.modePaiement|capitalize }}</span>
                                    </div>
                                    {% if reservation.seatNb > 0 %}
                                        <div class="rc-detail-item">
                                            <span style="font-size: 16px;">💺</span>
                                            <span>Siège : <strong>{{ reservation.seatNb }}</strong></span>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="rc-footer mt-4 pt-3" style="border-top: 1px solid #eee;">
                                    {% if status == 'confirmée' or status == 'confirmed' %}
                                        <a href="{{ path('reservation_pdf_front', { id: reservation.idReservation }) }}" class="rc-btn rc-btn-info w-100 mb-2" target="_blank">📄 Download PDF</a>
                                    {% elseif reservation.modePaiement != 'cash' %}
                                        <a href="{{ path('reservation_payment_front', { id: reservation.idReservation }) }}" class="rc-btn rc-btn-primary w-100 mb-2">💳 Pay Now</a>
                                    {% endif %}

                                    <form method="post" action="{{ path('myreservation_delete', { id: reservation.idReservation }) }}" onsubmit="return confirm('Confirmer la suppression ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_resa_' ~ reservation.idReservation) }}">
                                        <button type="submit" class="rc-btn rc-btn-danger w-100">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <div class="col-12 mt-50 mb-50">
                        <div class="pagination-wrapper d-flex justify-content-center">
                            {{ knp_pagination_render(pagination) }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <!-- ##### Footer Area Area Start ##### -->
    <footer class="footer-area">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-5">
                    <div class="footer-widget-area mt-50">
                      <div class="sidebar-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna Logo" style="height: 40px; margin-bottom: 20px;" />
                      </div>
                      <p>Track and manage your travel bookings with ease. Rehletna provides a seamless experience for confirming and managing your reservations.</p>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="footer-widget-area mt-50">
                        <h6 class="widget-title mb-30">Find us on the map</h6>
                        <img src="{{asset('assets/legacy/img/bg-img/footer-map.png')}}" alt="">
                    </div>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- ##### All Javascript Script ##### -->
    <script src="{{asset('assets/legacy/js/jquery/jquery-2.2.4.min.js')}}"></script>
    <script src="{{asset('assets/legacy/js/bootstrap/popper.min.js')}}"></script>
    <script src="{{asset('assets/legacy/js/bootstrap/bootstrap.min.js')}}"></script>
    <script src="{{asset('assets/legacy/js/active.js')}}"></script>
{% endblock %}
