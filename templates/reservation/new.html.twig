{# templates/reservation/new.html.twig #}
{# Converted from: ReservationForm.fxml #}
{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Nouvelle Réservation{% endblock %}

{% block content %}

<div class="form-wrapper">
    <div class="form-card">

        <h2 class="form-title">📅 Nouvelle Réservation</h2>

        {% if custom_errors is defined and custom_errors|length > 0 %}
            <div class="alert alert-danger" style="margin-bottom: 20px;">
                <strong>Oups ! Une erreur s'est produite :</strong>
                <ul style="margin-top: 10px; margin-bottom: 0; padding-left: 20px;">
                {% for msg in custom_errors %}
                    <li>{{ msg }}</li>
                {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, { attr: { novalidate: 'novalidate', id: 'reservationForm' } }) }}

            <div class="form-grid form-grid-1col">

                {# Nom du Client #}
                <div class="form-group">
                    <label class="form-label">Nom du Client :</label>
                    {{ form_widget(form.nom, { attr: { class: 'form-input', placeholder: 'Prénom et Nom' } }) }}
                    {% if form.nom.vars.errors|length %}
                        <span class="error-label">{{ form_errors(form.nom) }}</span>
                    {% endif %}
                </div>

                {# Date de Réservation #}
                <div class="form-group">
                    <label class="form-label">Date de Réservation :</label>
                    {{ form_widget(form.dateReservation, { attr: { class: 'form-input' } }) }}
                    {% if form.dateReservation.vars.errors|length %}
                        <span class="error-label">{{ form_errors(form.dateReservation) }}</span>
                    {% endif %}
                </div>

                {# Mode de Paiement #}
                <div class="form-group">
                    <label class="form-label">Mode de Paiement :</label>
                    {{ form_widget(form.modePaiement, { attr: { class: 'form-input', placeholder: 'Choisir une méthode...' } }) }}
                    {% if form.modePaiement.vars.errors|length %}
                        <span class="error-label">{{ form_errors(form.modePaiement) }}</span>
                    {% endif %}
                </div>

            </div>

            {# ===== SEAT MAP (only shown for Vols) ===== #}
            {% if serviceType == 'vol' %}
            <div class="seat-map-container" id="seatMapContainer">

                {# Plane nose #}
                <div class="plane-nose">✈ AVANT DE L'AVION ✈</div>

                {# Legend #}
                <div class="seat-legend">
                    <span class="legend-item legend-available">Disponible</span>
                    <span class="legend-item legend-occupied">Occupé</span>
                    <span class="legend-item legend-selected">Sélectionné</span>
                </div>

                {# Hidden input that stores the selected seat value #}
{# Hide the Symfony field — we'll sync to a plain hidden input instead #}
<div style="display:none">
    {{ form_widget(form.siege, { attr: { id: 'sfSiegeInput' } }) }}
</div>
<input type="hidden" id="selectedSeatInput" name="{{ form.siege.vars.full_name }}" value="" />                {# Seat grid — 6 seats per row with aisle gap between col 3 and 4 #}
                <div class="seat-grid" id="seatGrid">
                    {% for seat in seats %}
                        {# Add row label at the start of each row (every 6 seats) #}
                        {% if loop.index0 % 6 == 0 %}
                            <div class="seat-row-label">{{ (loop.index0 // 6) + 1 }}</div>
                        {% endif %}

                        {# colPos: 0-2 = left side, 3-5 = right side #}
                        {% set colPos = loop.index0 % 6 %}

                        <button
                            type="button"
                            class="seat-btn {% if seat.occupied %}seat-occupied{% else %}seat-available{% endif %}{% if colPos == 3 %} seat-aisle{% endif %}"
                            data-seat="{{ seat.number }}"
                            data-number="{{ seat.number }}"
                            {% if seat.occupied %}disabled{% endif %}
                        >
                            {{ seat.number }}
                        </button>
                    {% endfor %}
                </div>

                {# Selected seat display #}
                <div class="seat-selected-label" id="lblSelectedSeat">
                    Aucun siège sélectionné
                </div>

                {% if form.siege.vars.errors|length %}
                    <span class="error-label">{{ form_errors(form.siege) }}</span>
                {% endif %}

            </div>
            {% endif %}

            {# Buttons #}
            <div class="form-actions">
            
                <button type="submit" class="btn-submit">✔ Créer la Réservation</button>
                <a href="{{ path('services_index') }}" class="btn-back">← Retour</a>
            </div>

        {{ form_end(form) }}

    </div>
</div>

{# Inline script - executed immediately after form is rendered #}
{% if serviceType == 'vol' %}
<script>
(function() {
    'use strict';
    
    console.log('[SEAT MAP] Script loading...');
    
    function initSeatMap() {
        const seatGrid      = document.getElementById('seatGrid');
        const selectedInput = document.getElementById('selectedSeatInput');
        const lblSelected   = document.getElementById('lblSelectedSeat');
        const form          = document.getElementById('reservationForm');

        console.log('[SEAT MAP] Elements check:');
        console.log('  - seatGrid:', seatGrid ? 'FOUND ✓' : 'NOT FOUND ✗');
        console.log('  - selectedInput:', selectedInput ? 'FOUND ✓' : 'NOT FOUND ✗');
        console.log('  - lblSelected:', lblSelected ? 'FOUND ✓' : 'NOT FOUND ✗');
        console.log('  - form:', form ? 'FOUND ✓' : 'NOT FOUND ✗');

        if (!seatGrid  || !lblSelected || !form) {
            console.error('[SEAT MAP] ERROR: Missing required elements!');
            return;
        }

        // Get all available seat buttons
        const availableSeats = seatGrid.querySelectorAll('.seat-btn.seat-available');
        console.log('[SEAT MAP] Available seats found:', availableSeats.length);

        if (availableSeats.length === 0) {
            console.warn('[SEAT MAP] WARNING: No available seats found!');
            return;
        }

        // Attach click handlers to available seats
        let handlerCount = 0;
        availableSeats.forEach(function(btn) {
            const seatNum = btn.dataset.number;
            
            btn.onclick = function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                console.log('[SEAT MAP] ✓ Seat clicked:', seatNum);

                // Deselect all seats
                seatGrid.querySelectorAll('.seat-btn').forEach(function(b) {
                    b.classList.remove('seat-selected');
                   
                });

                // Select this seat
                this.classList.add('seat-selected');

                // Update hidden input
                selectedInput.value = seatNum;
                console.log('[SEAT MAP] ✓ Hidden input updated to:', selectedInput.value);

                // Update label
                lblSelected.textContent = '💺 Siège sélectionné : #' + seatNum;
                lblSelected.classList.add('seat-selected-active');
                lblSelected.classList.remove('error-label');
                
                return false;
            };
            
            handlerCount++;
        });
        
        console.log('[SEAT MAP] ✓ Attached', handlerCount, 'click handlers');

        // Validate seat selection on form submit
        form.onsubmit = function(e) {
            console.log('[SEAT MAP] Form submit triggered');
            console.log('[SEAT MAP] Selected input value:', selectedInput.value);
            
            if (!selectedInput.value || selectedInput.value === '' || selectedInput.value === '0') {
                e.preventDefault();
                e.stopPropagation();
                
                console.log('[SEAT MAP] ✗ No seat selected - preventing submit');
                
                lblSelected.textContent = '❌ Erreur : Veuillez sélectionner un siège';
                lblSelected.classList.remove('seat-selected-active');
                lblSelected.classList.add('error-label');
                
                // Scroll to seat map
                var seatMapContainer = document.getElementById('seatMapContainer');
                if (seatMapContainer) {
                    seatMapContainer.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'center' 
                    });
                }
                
                return false;
            } else {
                console.log('[SEAT MAP] ✓ Seat selected, allowing form submit with seat:', selectedInput.value);
                return true;
            }
        };
        
        console.log('[SEAT MAP] ✓✓✓ Initialization complete!');
    }

    // Initialize immediately or when DOM is ready
    if (document.readyState === 'loading') {
        console.log('[SEAT MAP] Waiting for DOM...');
        document.addEventListener('DOMContentLoaded', initSeatMap);
    } else {
        console.log('[SEAT MAP] DOM already loaded, initializing now...');
        initSeatMap();
    }
})();
</script>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
