{% extends 'base.html.twig' %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/styles/style.css') }}">
{% endblock %}

{% block body %}
<body>

<div class="detail-wrapper">
    <div class="detail-card">

        {# ── Banner ── #}
        <div class="detail-hero" style="background: linear-gradient(135deg, #1a2b4a, #2c4a7c);
             height:160px; display:flex; align-items:center; justify-content:center;
             flex-direction:column; gap:8px;">
            <span style="font-size:40px;">💳</span>
            <h2 style="color:white; margin:0; font-size:22px;">Paiement</h2>
            <span style="color:rgba(255,255,255,0.6); font-size:13px;">
                Réf #{{ reservation.idReservation }}
            </span>
        </div>

        {# ── Summary ── #}
        <div class="detail-title-row">
            <div>
                <h3 class="detail-name">{{ reservation.idService.nom }}</h3>
                <p class="detail-location">👤 {{ reservation.nom }}</p>
            </div>
            <div class="detail-price-box">
                <span class="detail-price">{{ amount }}</span>
                <span class="detail-price-label">TND</span>
            </div>
        </div>

        <hr class="detail-divider" />

        <div style="padding: 0 32px 40px; display:flex; flex-direction:column; gap:20px;">

            {# Flash messages #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

           
{# ── Stripe Card ── #}
{% if modePaiement == 'stripe' or modePaiement == 'carte' %}
<div class="payment-option">
      <h4 class="payment-option-title">💳 Payer par Carte Bancaire (Stripe)</h4>
                <form id="stripeForm"
                      action="{{ path('reservation_pay_stripe', { id: reservation.idReservation, origin: origin }) }}"
                      method="POST">
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label class="form-label">Informations de carte</label>
                        <div id="card-element"
                             style="padding:12px; border:1px solid #dde1e7;
                                    border-radius:7px; background:#f9fafb;">
                        </div>
                        <div id="card-errors"
                             style="color:#d9534f; font-size:12px; margin-top:6px;">
                        </div>
                    </div>
                    <button type="submit" class="btn-submit" style="width:100%;">
                        Payer {{ amount }} TND par Carte
                    </button>
                </form>
</div>
{% endif %}



{# ── PayPal ── #}
{% if modePaiement == 'paypal' %}
<div class="payment-option">
       <h4 class="payment-option-title">🅿 Payer par PayPal</h4>
                <form action="{{ path('reservation_paypal_create', { id: reservation.idReservation, origin: origin }) }}"
                      method="POST">
                    <button type="submit" class="btn-paypal">
                        <img src="https://www.paypalobjects.com/webstatic/mktg/logo/pp_cc_mark_37x23.jpg"
                             alt="PayPal"
                             style="height:20px; vertical-align:middle; margin-right:8px;">
                        Payer {{ amount }} TND via PayPal
                    </button>
                </form>
</div>
{% endif %}
            {# ── Cancel — deletes the pending reservation from DB ── #}
            <a href="{{ path('reservation_paypal_cancel', { id: reservation.idReservation, origin: origin }) }}"
               class="btn-back"
               style="text-align:center;"
               onclick="return confirm('Annuler la réservation ? Elle sera supprimée.');">
                ✖ Annuler la réservation
            </a>

        </div>
    </div>
</div>

</body>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://js.stripe.com/v3/"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Only initialize Stripe if the stripe form is present in the DOM
    var stripeFormEl = document.getElementById('stripeForm');
    if (!stripeFormEl) {
        return; // PayPal mode or no Stripe form rendered — nothing to do
    }

    var stripe   = Stripe('{{ stripe_pub_key }}');
    var elements = stripe.elements();
    var card     = elements.create('card', {
        style: {
            base: {
                fontSize: '16px',
                color: '#333',
                fontFamily: '"Segoe UI", Helvetica, sans-serif',
                '::placeholder': { color: '#aaa' }
            },
            invalid: { color: '#d9534f' }
        }
    });

    card.mount('#card-element');

    card.on('change', function(e) {
        document.getElementById('card-errors').textContent =
            e.error ? e.error.message : '';
    });

    stripeFormEl.addEventListener('submit', async function(e) {
        e.preventDefault();
        var btn = this.querySelector('button[type=submit]');
        btn.disabled    = true;
        btn.textContent = '⏳ Traitement...';

        try {
            var result = await stripe.createToken(card);

            if (result.error) {
                document.getElementById('card-errors').textContent = result.error.message;
                btn.disabled    = false;
                btn.textContent = 'Payer {{ amount }} TND par Carte';
                return;
            }

            // Remove any old token input
            var existing = document.getElementById('stripeTokenInput');
            if (existing) existing.remove();

            // Append the Stripe token as a hidden field
            var input   = document.createElement('input');
            input.type  = 'hidden';
            input.name  = 'stripeToken';
            input.id    = 'stripeTokenInput';
            input.value = result.token.id;
            stripeFormEl.appendChild(input);

            console.log('Stripe token created:', result.token.id);

            // Submit the form natively to avoid re-triggering the listener
            HTMLFormElement.prototype.submit.call(stripeFormEl);

        } catch(err) {
            document.getElementById('card-errors').textContent = 'Erreur: ' + err.message;
            btn.disabled    = false;
            btn.textContent = 'Payer {{ amount }} TND par Carte';
        }
    });
});
</script>
{% endblock %}