{% extends 'base.html.twig' %}
{% block stylesheets %}
    <!-- Favicon -->
    <link rel="icon" href="{{asset('assets/legacy/img/core-img/favicon.ico')}}">

    <!-- Core Stylesheet -->
    <link rel="stylesheet" href="{{ asset('assets/legacy/style.css') }}">
    
    <style>
        .sidebar-logo img { height: 45px; }
        .palatin-main-menu { height: 85px; display: flex; align-items: center; }
        .classynav ul li a { font-weight: 700; color: #1f2b5b; text-transform: uppercase; }
        .classynav ul li.active a { color: #fbbe30; }
        
        .form-wrapper { padding: 50px 0; background: #f8f9fa; }
        .form-card { background: #fff; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); max-width: 800px; margin: 0 auto; }
        .form-title { color: #1f2b5b; font-weight: 700; margin-bottom: 30px; border-bottom: 2px solid #fbbe30; padding-bottom: 10px; }
        .form-label { font-weight: 700; color: #1f2b5b; margin-bottom: 8px; display: block; }
        .form-input { width: 100%; padding: 12px 15px; border: 1px solid #ddd; border-radius: 8px; transition: 0.3s; }
        .form-input:focus { border-color: #00BFFF; outline: none; box-shadow: 0 0 5px rgba(0, 191, 255, 0.2); }
        .error-label { color: #e74c3c; font-size: 13px; margin-top: 5px; display: block; }

        /* Seat Map Styling */
        .seat-map-container { margin-top: 40px; padding: 30px; background: #1f2b5b; border-radius: 12px; color: #fff; text-align: center; }
        .plane-nose { margin-bottom: 25px; font-weight: 700; letter-spacing: 2px; color: #fbbe30; }
        .seat-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; max-width: 400px; margin: 0 auto; }
        .seat-btn { width: 40px; height: 40px; border-radius: 5px; border: none; font-size: 11px; font-weight: 700; cursor: pointer; transition: 0.3s; }
        .seat-available { background: #fff; color: #1f2b5b; }
        .seat-occupied { background: #555; color: #888; cursor: not-allowed; }
        .seat-selected { background: #fbbe30 !important; color: #1f2b5b !important; transform: scale(1.1); box-shadow: 0 0 15px rgba(251, 190, 48, 0.5); }
        .seat-aisle { margin-right: 20px; }
        .seat-row-label { display: flex; align-items: center; justify-content: center; font-weight: 700; color: #888; }
        .seat-legend { display: flex; justify-content: center; gap: 20px; margin-bottom: 25px; font-size: 12px; }
        .legend-item::before { content: ''; display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 5px; vertical-align: middle; }
        .legend-available::before { background: #fff; }
        .legend-occupied::before { background: #555; }
        .legend-selected::before { background: #fbbe30; }
        
        .seat-selected-label { margin-top: 25px; font-weight: 700; color: #fbbe30; min-height: 24px; }
    </style>
{% endblock %}

{% block body %}
    <!-- ##### Header Area Start ##### -->
    <header class="header-area">
        <div class="palatin-main-menu">
            <div class="classy-nav-container breakpoint-off">
                <div class="container">
                    <nav class="classy-navbar justify-content-between" id="palatinNav">
                        <div class="sidebar-logo">
                            <img src="{{ asset('images/logo.png') }}" alt="Rehletna Logo" />
                        </div>
                        <div class="classy-menu">
                            <div class="classynav">
                                <ul>
                                    <li><a href="{{path('ourservices_index')}}">Services</a></li>
                                    <li><a href="{{path('myreservations_index')}}">My reservations</a></li>
                                </ul>
                                <div class="menu-btn">
                                    <a href="{{ path('app_mainpage') }}" class="btn palatin-btn" data-turbo="false">HOME</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>

    <!-- ##### Breadcumb Area Start ##### -->
    <section class="breadcumb-area bg-img d-flex align-items-center justify-content-center" style="background-image: url({{asset('assets/legacy/img/bg-img/bg-2.jpg')}});">
        <div class="bradcumbContent">
            <h2>Make a Reservation</h2>
        </div>
    </section>

    <!-- ##### Form Area Start ##### -->
    <div class="form-wrapper">
        <div class="container">
            <div class="form-card">
                <h2 class="form-title">🛎️ Réservation : {{ service.nom }}</h2>

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'danger' or type == 'error' ? 'danger' : (type == 'success' ? 'success' : 'info') }} mb-4">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {{ form_start(form, { attr: { novalidate: 'novalidate', id: 'reservationForm', 'data-turbo': 'false' } }) }}

                    <div class="row">
                        <div class="col-12 mb-4">
                            <label class="form-label">Nom du Client :</label>
                            {{ form_widget(form.nom, { attr: { class: 'form-input', placeholder: 'Votre nom complet' } }) }}
                            {{ form_errors(form.nom) }}
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="form-label">Date de Réservation :</label>
                            {{ form_widget(form.dateReservation, { attr: { class: 'form-input' } }) }}
                            {{ form_errors(form.dateReservation) }}
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="form-label">Mode de Paiement :</label>
                            {{ form_widget(form.modePaiement, { attr: { class: 'form-input' } }) }}
                            {{ form_errors(form.modePaiement) }}
                        </div>
                    </div>

                    {# ===== SEAT MAP (only shown for Vols) ===== #}
                    {% if serviceType == 'vol' %}
                    <div class="seat-map-container" id="seatMapContainer">
                        <div class="plane-nose">✈ SELECTION DU SIEGE ✈</div>

                        <div class="seat-legend">
                            <span class="legend-item legend-available">Disponible</span>
                            <span class="legend-item legend-occupied">Occupé</span>
                            <span class="legend-item legend-selected">Sélectionné</span>
                        </div>

                        {# Sync internal Siege field from form #}
                        <div style="display:none">
                            {{ form_widget(form.siege, { attr: { id: 'selectedSeatInput' } }) }}
                        </div>

                        <div class="seat-grid" id="seatGrid">
                            {% for seat in seats %}
                                {# Row label #}
                                {% if loop.index0 % 6 == 0 %}
                                    <div class="seat-row-label">{{ (loop.index0 // 6) + 1 }}</div>
                                {% endif %}

                                {# colPos: aisle gap #}
                                {% set colPos = loop.index0 % 6 %}
                                <button
                                    type="button"
                                    class="seat-btn {% if seat.occupied %}seat-occupied{% else %}seat-available{% endif %}{% if colPos == 3 %} seat-aisle{% endif %}"
                                    data-number="{{ seat.number }}"
                                    {% if seat.occupied %}disabled{% endif %}
                                >
                                    {{ seat.number }}
                                </button>
                            {% endfor %}
                        </div>

                        <div class="seat-selected-label" id="lblSelectedSeat">
                            Aucun siège sélectionné
                        </div>

                        {{ form_errors(form.siege) }}
                    </div>
                    {% endif %}

                    <div class="form-actions mt-5 pt-4" style="border-top: 1px solid #eee;">
                        <button type="submit" class="btn palatin-btn w-100 mb-3" style="font-size: 16px;">✔ Créer ma Réservation</button>
                        <a href="{{ path('ourservices_index') }}" class="text-muted d-block text-center text-decoration-none">← Retour aux services</a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- ##### Footer Area Area Start ##### -->
    <footer class="footer-area">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-5">
                    <div class="footer-widget-area mt-50">
                      <div class="sidebar-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna Logo" style="height: 40px; margin-bottom: 20px;" />
                      </div>
                      <p>Book your next adventure with Rehletna.tn. We offer premium services and easy reservation management.</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{asset('assets/legacy/js/jquery/jquery-2.2.4.min.js')}}"></script>
    <script src="{{asset('assets/legacy/js/bootstrap/popper.min.js')}}"></script>
    <script src="{{asset('assets/legacy/js/bootstrap/bootstrap.min.js')}}"></script>
    {% if serviceType == 'vol' %}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var seatGrid = document.getElementById('seatGrid');
        var lblSelected = document.getElementById('lblSelectedSeat');
        var form = document.getElementById('reservationForm');

        // Find the hidden siege input by its name attribute (Symfony always generates this reliably)
        var selectedInput = document.querySelector('input[name="reservation[siege]"]');

        if (!seatGrid || !lblSelected || !selectedInput || !form) {
            console.error('Seat map elements not found:', {
                seatGrid: !!seatGrid,
                lblSelected: !!lblSelected,
                selectedInput: !!selectedInput,
                form: !!form
            });
            return;
        }

        var availableSeats = seatGrid.querySelectorAll('.seat-btn.seat-available');
        
        availableSeats.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                // Deselect all
                seatGrid.querySelectorAll('.seat-btn').forEach(function(b) {
                    b.classList.remove('seat-selected');
                });
                
                // Select this
                this.classList.add('seat-selected');
                
                var seatNum = this.getAttribute('data-number');
                selectedInput.value = seatNum;
                lblSelected.textContent = '💺 Siège sélectionné : #' + seatNum;
                lblSelected.style.color = '#fbbe30';
            });
        });

        form.addEventListener('submit', function(e) {
            if (!selectedInput.value || selectedInput.value === '') {
                e.preventDefault();
                lblSelected.textContent = '❌ Veuillez sélectionner un siège';
                lblSelected.style.color = '#e74c3c';
                document.getElementById('seatMapContainer').scrollIntoView({ behavior: 'smooth' });
            }
        });
    });
    </script>
    {% endif %}
{% endblock %}

