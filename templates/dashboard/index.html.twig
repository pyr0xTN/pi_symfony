{# templates/dashboard/index.html.twig #}
{# Converted from: DashboardServices.fxml #}
{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Dashboard Overview{% endblock %}

{% block content %}

    {# ===== STAT CARDS ===== #}
    <div class="stat-cards-row">

        <div class="stat-card card-teal">
            <span class="card-title">Hôtels</span>
            <span class="card-value">{{ hotel_count }}</span>
        </div>

        <div class="stat-card card-yellow">
            <span class="card-title">Vols</span>
            <span class="card-value">{{ vol_count }}</span>
        </div>

        <div class="stat-card card-teal">
            <span class="card-title">Réservations</span>
            <span class="card-value">{{ reservation_count }}</span>
        </div>

    </div>

    {# ===== SERVICES SECTION ===== #}
    <section class="dashboard-section">

        <div class="section-header-row">
            <h2 class="section-header">Services</h2>
            <div class="section-actions">
                <a href="{{ path('vol_new') }}" class="btn-add">+ Add Vol</a>
                <a href="{{ path('hotel_new') }}" class="btn-add">+ Add Hôtel</a>

                <form method="GET" action="{{ path('dashboard') }}" class="filter-form">
                    <select name="filter" class="btn-add" onchange="this.form.submit()">
                        <option value="">Filter By</option>
                        <option value="hotel" {% if filter == 'hotel' %}selected{% endif %}>Hôtels</option>
                        <option value="vol" {% if filter == 'vol' %}selected{% endif %}>Vols</option>
                    </select>
                </form>
            </div>
        </div>

        {# Services Table #}
        <div class="table-header">
            <span class="col-wide">Service Name</span>
            <span class="col">Type</span>
            <span class="col">Price</span>
            <span class="col">Capacity</span>
            <span class="col">Status</span>
            <span class="col">Actions</span>
        </div>

        <div class="table-body">
            {% for service in services %}
                <div class="table-row">
                    <span class="col-wide">{{ service.nom }}</span>
                    <span class="col">{{ service.type }}</span>
                    <span class="col">{{ service.prix }} TND</span>
                    <span class="col">{{ service.capacite }}</span>
                    <span class="col badge {% if service.disponibilite %}badge-success{% else %}badge-danger{% endif %}">
                        {{ service.disponibilite ? 'Disponible' : 'Indisponible' }}
                    </span>
                    <span class="col"></span>
                </div>
            {% else %}
                <p class="empty-state">Aucun service trouvé.</p>
            {% endfor %}
        </div>

    </section>

    {# ===== RESERVATIONS SECTION ===== #}
    <section class="dashboard-section">

        <h2 class="section-header">Réservations</h2>

        <div class="table-header">
            <span class="col">Nom</span>
            <span class="col-wide">Date Réservation</span>
            <span class="col">Paiement</span>
            <span class="col">Service</span>
            <span class="col">Statut</span>
        </div>

        <div class="table-body">
            {% for reservation in reservations %}
                <div class="table-row">
                    <span class="col">{{ reservation.nom }}</span>
                    <span class="col-wide">{{ reservation.dateReservation|date('d/m/Y') }}</span>
                    <span class="col">{{ reservation.modePaiement }}</span>
                    <span class="col">{{ reservation.idService.nom }}</span>
                    <span class="col badge badge-info">{{ reservation.statut }}</span>
                </div>
            {% else %}
                <p class="empty-state">Aucune réservation trouvée.</p>
            {% endfor %}
        </div>

    </section>

{% endblock %}
