    <!-- ##### AI Smart Search Area Start ##### -->
    <div class="book-now-area">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="book-now-form" style="background: linear-gradient(135deg, #1f2b5b, #00BFFF); padding: 30px; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,0.2);">
                        <form action="{{ path('ourservices_index') }}" method="get" class="d-flex align-items-center" style="gap: 15px;">
                            <div class="flex-grow-1">
                                <input type="text" name="ai_q" class="form-control" placeholder="✨ Type what you are looking for (e.g. 'A 5-star hotel in Paris under 200 euros')..." value="{{ aiQuery|default('') }}" style="height: 55px; font-size: 1.1rem; border-radius: 8px; border: none; padding-left: 20px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.1);">
                            </div>
                            <button type="submit" class="btn palatin-btn" style="height: 55px; padding: 0 40px; font-weight: bold; letter-spacing: 1px; color:#fff; border-radius: 8px;">✨ Ask AI</button>
                            
                            {% if aiQuery is defined and aiQuery is not empty %}
                                <a href="{{ path('ourservices_index') }}" class="btn" style="height: 55px; line-height: 40px; padding: 0 30px; font-weight: bold; border-radius: 8px; background-color: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.5);">↺ Reset</a>
                            {% endif %}
                        </form>
                    </div>
                    
                    {% if aiFilters is defined and aiFilters %}
                    <div class="ai-filters-alert mt-4" style="background-color: rgba(0, 191, 255, 0.1); border-left: 4px solid #00BFFF; padding: 15px 20px; border-radius: 6px;">
                        <h5 style="color: #1f2b5b; margin-bottom: 10px;">✨ AI Understood:</h5>
                        <div class="d-flex flex-wrap" style="gap: 10px;">
                            {% if aiFilters.type %}
                                <span class="badge badge-pill" style="background-color: #1f2b5b; color: white; padding: 8px 15px; font-size: 0.9rem;">Type: {{ aiFilters.type|capitalize }}</span>
                            {% endif %}
                            {% if aiFilters.localisation %}
                                <span class="badge badge-pill" style="background-color: #1f2b5b; color: white; padding: 8px 15px; font-size: 0.9rem;">📍 {{ aiFilters.localisation|capitalize }}</span>
                            {% endif %}
                            {% if aiFilters.nombre_etoiles %}
                                <span class="badge badge-pill" style="background-color: #f1c40f; color: #333; padding: 8px 15px; font-size: 0.9rem;">⭐ {{ aiFilters.nombre_etoiles }} Stars+</span>
                            {% endif %}
                            {% if aiFilters.max_prix %}
                                <span class="badge badge-pill" style="background-color: #27ae60; color: white; padding: 8px 15px; font-size: 0.9rem;">💰 Max {{ aiFilters.max_prix | format_currency | raw }}</span>
                            {% endif %}
                            {% if aiFilters.ville_depart %}
                                <span class="badge badge-pill" style="background-color: #1f2b5b; color: white; padding: 8px 15px; font-size: 0.9rem;">🛫 {{ aiFilters.ville_depart|capitalize }}</span>
                            {% endif %}
                            {% if aiFilters.ville_arrivee %}
                                <span class="badge badge-pill" style="background-color: #1f2b5b; color: white; padding: 8px 15px; font-size: 0.9rem;">🛬 {{ aiFilters.ville_arrivee|capitalize }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <!-- ##### AI Smart Search Area End ##### -->

