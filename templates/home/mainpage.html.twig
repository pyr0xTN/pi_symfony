        }

        .birthday-gift-banner {
            margin-bottom: 18px;
            padding: 18px 20px;
            border-radius: 22px;
            background:
                radial-gradient(260px 120px at 10% 0%, rgba(255, 238, 188, 0.78), transparent 70%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 248, 232, 0.84));
            border: 1px solid rgba(252, 186, 48, 0.42);
            box-shadow: 0 16px 30px rgba(7, 57, 107, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.84);
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            overflow: hidden;
            animation: birthdayGiftIntro 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        .birthday-gift-banner::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.04) 40%, rgba(255, 255, 255, 0.16) 62%, rgba(255, 255, 255, 0.02));
            pointer-events: none;
        }

        .birthday-gift-icon {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            font-size: 2rem;
            background: linear-gradient(135deg, rgba(252, 186, 48, 0.24), rgba(10, 160, 159, 0.18));
            border: 1px solid rgba(252, 186, 48, 0.38);
        }

        .birthday-gift-content {
            position: relative;
            z-index: 1;
            flex: 1 1 auto;
            min-width: 0;
        }

        .birthday-gift-kicker {
            margin: 0 0 4px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9b5d00;
        }

        .birthday-gift-title {
            margin: 0 0 6px;
            color: #173e63;
            font-size: clamp(1.15rem, 2vw, 1.45rem);
            font-weight: 800;
            line-height: 1.15;
        }

        .birthday-gift-text {
            margin: 0;
            color: #51667a;
            font-size: 14px;
            line-height: 1.5;
        }

        .birthday-gift-action {
            position: relative;
            z-index: 1;
            flex: 0 0 auto;
        }

        .birthday-gift-btn {
            border: 0;
            border-radius: 14px;
            padding: 13px 18px;
            font-weight: 800;
            color: #fff;
            background: linear-gradient(135deg, #0AA09F 0%, #07396B 100%);
            box-shadow: 0 10px 22px rgba(7, 57, 107, 0.24);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
            white-space: nowrap;
        }

        .birthday-gift-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(7, 57, 107, 0.28);
            filter: brightness(1.04);
        }

        .birthday-gift-btn.is-collected,
        .birthday-gift-btn:disabled {
            background: linear-gradient(135deg, #9fb5c7 0%, #6f879c 100%);
            cursor: not-allowed;
            box-shadow: none;
        }

        @keyframes birthdayGiftIntro {
            from {
                opacity: 0;
                transform: translateY(-10px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .birthday-gift-banner {
                animation: none;
            }
        }

        body.dark-mode .birthday-gift-banner {
            background:
                radial-gradient(260px 120px at 10% 0%, rgba(252, 186, 48, 0.18), transparent 70%),
                linear-gradient(135deg, rgba(12, 26, 42, 0.94), rgba(16, 40, 61, 0.92));
            border-color: rgba(252, 186, 48, 0.38);
            box-shadow: 0 18px 34px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }

        body.dark-mode .birthday-gift-title,
        body.dark-mode .birthday-gift-text {
            color: #e7f3ff;
        }

        body.dark-mode .birthday-gift-kicker {
            color: #ffd27e;
        }

        .trust-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin: 22px 0 0;
        }

        .metric-card {
            border-radius: 16px;
            padding: 14px 14px 12px;
            background:
                radial-gradient(130px 70px at 10% 0%, rgba(56, 203, 220, 0.2), transparent 78%),
                linear-gradient(145deg, rgba(255, 255, 255, 0.5), rgba(243, 250, 255, 0.32));
            border: 1px solid rgba(132, 201, 242, 0.36);
            box-shadow: 0 10px 24px rgba(7, 57, 107, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.62);
            position: relative;
            overflow: hidden;
        }

        .metric-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.06) 38%, rgba(255, 255, 255, 0.26) 70%, rgba(255, 255, 255, 0.04) 100%);
            pointer-events: none;
            opacity: 0.72;
        }

        .metric-value,
        .metric-label {
            position: relative;
            z-index: 1;
        }

        .metric-value {
            font-size: 1.12rem;
            font-weight: 800;
            color: #143f6a;
            line-height: 1.1;
            margin-bottom: 3px;
        }

        .metric-label {
            font-size: 0.76rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            color: #597189;
            text-transform: uppercase;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
        }

        .feature-card {
            background:
                radial-gradient(190px 90px at 10% 0%, rgba(20, 191, 210, 0.14), transparent 78%),
                linear-gradient(155deg, rgba(255, 255, 255, 0.5), rgba(248, 252, 255, 0.34));
            border: 1px solid rgba(141, 207, 245, 0.34);
            padding: 24px 20px;
            border-radius: 18px;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            cursor: pointer;
            text-decoration: none;
            display: block;
            box-shadow: 0 10px 22px rgba(7, 57, 107, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(115deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.1) 34%, rgba(255, 255, 255, 0.2) 64%, rgba(255, 255, 255, 0.05) 100%);
            pointer-events: none;
            opacity: 0.72;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 30px rgba(7, 57, 107, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.74);
            border-color: rgba(122, 200, 245, 0.5);
        }

        .feature-icon {
            font-size: 36px;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .feature-title {
            font-size: 17px;
            font-weight: 700;
            color: #173f69;
            margin-bottom: 6px;
            position: relative;
            z-index: 1;
        }

        .feature-text {
            font-size: 12px;
            color: #5c7087;
            position: relative;
            z-index: 1;
        }

        /* Chat Button */
        .chat-button {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            border-radius: 30px;
            background: linear-gradient(135deg, #0FA5A2, #1788b6);
            border: none;
            cursor: pointer;
            box-shadow: 0 10px 24px rgba(6, 44, 82, 0.2);
            transition: transform 0.3s ease;
            z-index: 100;
        }

        .chat-button:hover {
            transform: scale(1.05);
        }

        .chat-button span {
            font-size: 24px;
            color: white;
        }

        .chat-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ff5e62;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
        }

        .chat-modal {
            position: fixed;
            right: 20px;
            bottom: 94px;
            width: min(380px, calc(100vw - 24px));
            height: min(560px, calc(100vh - 140px));
            background: rgba(255, 255, 255, 0.98);
            border-radius: 18px;
            box-shadow: 0 22px 46px rgba(6, 44, 82, 0.26);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1200;
        }

        .chat-modal.show {
            display: flex;
            animation: chatPopupIn 0.2s ease;
        }

        .chat-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            background: linear-gradient(135deg, #0FA5A2, #1788b6);
            color: #fff;
        }

        .chat-modal-title {
            font-size: 15px;
            font-weight: 700;
            margin: 0;
        }

        .chat-admin-row {
            width: 100%;
            margin-top: 8px;
        }

        .chat-admin-select {
            width: 100%;
            border: 1px solid rgba(255, 255, 255, 0.35);
            background: rgba(7, 45, 79, 0.36);
            color: #eaf7ff;
            border-radius: 9px;
            padding: 7px 10px;
            font-size: 12px;
            outline: none;
        }

        .chat-admin-select option {
            color: #143a5e;
            background: #f4fbff;
        }

        .chat-modal-close {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
        }

        .chat-modal-actions {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .chat-modal-call {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
        }

        .chat-modal-call:hover,
        .chat-modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .chat-user-call-picker {
            width: 100%;
            margin-top: 8px;
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .chat-user-call-picker select {
            flex: 1;
            border: 1px solid rgba(255, 255, 255, 0.35);
            background: rgba(7, 45, 79, 0.36);
            color: #eaf7ff;
            border-radius: 9px;
            padding: 6px 8px;
            font-size: 12px;
            outline: none;
        }

        .chat-user-call-picker select option {
            color: #143a5e;
            background: #f4fbff;
        }

        .chat-user-call-btn {
            border: none;
            border-radius: 9px;
            padding: 6px 8px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            color: #fff;
        }

        .chat-user-call-btn.start {
            background: rgba(18, 201, 124, 0.86);
        }

        .chat-user-call-btn.cancel {
            background: rgba(255, 255, 255, 0.26);
        }

        .chat-modal-messages {
            flex: 1;
            overflow-y: auto;
            padding: 14px;
            background: linear-gradient(180deg, #f7fbff 0%, #eef6fd 100%);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .chat-message {
            max-width: 85%;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 13px;
            line-height: 1.4;
            word-break: break-word;
        }

        .chat-message.mine {
            align-self: flex-end;
            background: linear-gradient(135deg, #0FA5A2, #1788b6);
            color: #fff;
            border-bottom-right-radius: 6px;
        }

        .chat-message.other {
            align-self: flex-start;
            background: #ffffff;
            color: #2a4460;
            border-bottom-left-radius: 6px;
            box-shadow: 0 6px 14px rgba(7, 57, 107, 0.1);
        }

        .chat-message-meta {
            margin-top: 6px;
            font-size: 10px;
            opacity: 0.75;
        }

        .chat-message-actions {
            margin-top: 6px;
            display: flex;
            justify-content: flex-end;
            gap: 6px;
        }

        .chat-action-btn {
            border: 1px solid rgba(255, 255, 255, 0.36);
            background: rgba(255, 255, 255, 0.16);
            color: #f2fbff;
            border-radius: 7px;
            font-size: 11px;
            line-height: 1;
            padding: 4px 6px;
            cursor: pointer;
        }

        .chat-action-btn:hover {
            background: rgba(255, 255, 255, 0.28);
        }

        .chat-message.other .chat-action-btn {
            border-color: rgba(32, 75, 109, 0.25);
            background: rgba(20, 62, 95, 0.06);
            color: #27557f;
        }

        .chat-message.other .chat-action-btn:hover {
            background: rgba(20, 62, 95, 0.12);
        }

        .chat-message-content.deleted {
            opacity: 0.72;
            font-style: italic;
        }

        .chat-inline-editor {
            margin-top: 6px;
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .chat-inline-input {
            flex: 1;
            border-radius: 8px;
            border: 1px solid rgba(18, 120, 168, 0.25);
            padding: 7px 9px;
            font-size: 12px;
            outline: none;
            background: rgba(255, 255, 255, 0.9);
            color: #1d3f5e;
        }

        .chat-inline-input:focus {
            border-color: rgba(18, 152, 210, 0.6);
            box-shadow: 0 0 0 2px rgba(18, 152, 210, 0.18);
        }

        .chat-inline-btn {
            border: 1px solid rgba(255, 255, 255, 0.36);
            background: rgba(255, 255, 255, 0.18);
            color: #f2fbff;
            border-radius: 7px;
            font-size: 11px;
            line-height: 1;
            padding: 6px 7px;
            cursor: pointer;
        }

        .chat-inline-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .chat-message.other .chat-inline-btn {
            border-color: rgba(32, 75, 109, 0.25);
            background: rgba(20, 62, 95, 0.08);
            color: #27557f;
        }

        .chat-delivery {
            font-weight: 800;
            letter-spacing: 0.2px;
            display: inline-block;
            min-width: 10px;
            text-align: center;
        }

        .chat-delivery-sent,
        .chat-delivery-delivered {
            color: rgba(245, 255, 255, 0.88);
        }

        .chat-message.other .chat-delivery-sent,
        .chat-message.other .chat-delivery-delivered {
            color: rgba(40, 73, 102, 0.8);
        }

        .chat-delivery-seen {
            color: #5dd6ff;
        }

        .chat-empty {
            margin: auto;
            text-align: center;
            color: #6a7f95;
            font-size: 13px;
        }

        .chat-modal-input {
            display: flex;
            gap: 8px;
            padding: 12px;
            background: #fff;
            border-top: 1px solid rgba(15, 80, 128, 0.12);
        }

        .chat-attach-btn {
            width: 36px;
            min-width: 36px;
            border: 1px solid rgba(10, 118, 160, 0.28);
            border-radius: 10px;
            background: #f3f9ff;
            color: #1f78aa;
            font-size: 20px;
            font-weight: 700;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chat-attach-btn:hover {
            background: #e8f4ff;
        }

        .chat-input {
            flex: 1;
            border: 1px solid rgba(10, 118, 160, 0.2);
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 13px;
            outline: none;
        }

        .chat-input:focus {
            border-color: rgba(10, 160, 159, 0.6);
            box-shadow: 0 0 0 3px rgba(10, 160, 159, 0.14);
        }

        .chat-send-btn {
            border: none;
            border-radius: 10px;
            padding: 0 14px;
            background: linear-gradient(135deg, #0FA5A2, #1788b6);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .chat-status {
            min-height: 18px;
            font-size: 11px;
            color: #d94a5a;
            padding: 0 12px 8px;
            background: #fff;
        }

        .chat-selected-file {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 12px 8px;
            background: #fff;
            border-top: 1px dashed rgba(15, 80, 128, 0.15);
            font-size: 12px;
            color: #2a4460;
        }

        .chat-selected-file-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .chat-selected-file-clear {
            width: 22px;
            height: 22px;
            border: 1px solid rgba(10, 118, 160, 0.26);
            border-radius: 50%;
            background: #eef7ff;
            color: #1f78aa;
            cursor: pointer;
            line-height: 1;
            font-size: 14px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chat-selected-file-clear:hover {
            background: #dff1ff;
        }

        .chat-attachment-preview {
            margin-top: 6px;
            max-width: 180px;
            max-height: 120px;
            border-radius: 8px;
            display: block;
            object-fit: cover;
            border: 1px solid rgba(164, 211, 240, 0.5);
            box-shadow: 0 6px 14px rgba(10, 56, 94, 0.14);
        }

        .chat-attachment-link {
            color: #0c6fa4;
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            gap: 5px;
            align-items: center;
        }

        .chat-call-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .chat-message.other .chat-call-card {
            background: rgba(12, 108, 154, 0.1);
            border-color: rgba(13, 96, 139, 0.2);
        }

        .chat-call-title {
            font-weight: 700;
            font-size: 13px;
        }

        .chat-call-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .chat-call-action-btn {
            border: none;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .chat-call-action-btn.join {
            background: #0db582;
            color: #fff;
        }

        .chat-call-action-btn.decline {
            background: #f4d9dd;
            color: #943747;
        }

        .chat-attachment-link:hover {
            text-decoration: underline;
        }

        .chat-attachment-name {
            margin-top: 5px;
            font-size: 11px;
            opacity: 0.9;
            word-break: break-word;
        }

        @keyframes chatPopupIn {
            from {
                transform: translateY(12px) scale(0.98);
                opacity: 0;
            }
            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        /* Profile Popup */
        .profile-popup {
            position: absolute;
            background:
                radial-gradient(260px 120px at 100% 0%, rgba(123, 233, 255, 0.34), transparent 72%),
                linear-gradient(145deg, rgba(245, 253, 255, 0.99), rgba(222, 247, 255, 0.97));
            border-radius: 16px;
            padding: 14px;
            min-width: 248px;
            border: 1px solid rgba(86, 218, 255, 0.72);
            box-shadow:
                0 0 0 1px rgba(164, 240, 255, 0.7),
                0 14px 28px rgba(8, 67, 104, 0.2),
                0 0 24px rgba(95, 222, 255, 0.32);
            z-index: 1000;
            display: none;
        }

        .profile-popup.show {
            display: block;
        }

        .profile-popup .popup-username {
            margin: 0 0 10px;
            color: #0f3f63;
            font-size: 18px;
            line-height: 1.1;
        }

        .profile-popup .popup-stats {
            display: grid;
            gap: 7px;
        }

        .profile-popup .popup-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            padding: 7px 9px;
            border-radius: 10px;
            border: 1px solid rgba(130, 221, 246, 0.42);
            background: rgba(255, 255, 255, 0.56);
            color: #194a71;
            font-size: 13px;
        }

        .profile-popup .popup-label {
            font-weight: 700;
            color: #4a6d89;
        }

        .profile-popup .popup-value {
            font-weight: 800;
            color: #0e3f67;
            text-align: right;
        }

        body.dark-mode .profile-popup {
            background:
                radial-gradient(260px 120px at 100% 0%, rgba(84, 218, 255, 0.34), transparent 72%),
                linear-gradient(145deg, rgba(8, 28, 42, 0.98), rgba(11, 44, 63, 0.98));
            border-color: rgba(98, 227, 255, 0.8);
            box-shadow:
                0 0 0 1px rgba(98, 227, 255, 0.54),
                0 14px 28px rgba(0, 0, 0, 0.5),
                0 0 24px rgba(60, 198, 255, 0.32);
        }

        body.dark-mode .profile-popup .popup-username,
        body.dark-mode .profile-popup .popup-value {
            color: #ddf6ff;
        }

        body.dark-mode .profile-popup .popup-row {
            background: rgba(7, 31, 44, 0.75);
            border-color: rgba(96, 222, 255, 0.34);
            color: #bee8fb;
        }

        body.dark-mode .profile-popup .popup-label {
            color: #9ccde3;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .airport-background {
                opacity: 0.7;
            }

            .airport-map,
            .airport-routes {
                inset: 0;
                border-radius: 0;
            }

            .airport-point-label {
                font-size: 10px;
                left: 12px;
            }

            .airport-point.point-dubai {
                display: none;
            }

            .airport-terminal {
                display: none;
            }

            .airport-apron {
                display: none;
            }

            .airport-control-tower {
                display: none;
            }

            .airport-beacon {
                display: none;
            }

            .airport-plane {
                width: 150px;
                top: 20%;
            }

            .airport-plane.plane-one {
                width: 140px;
                height: 48px;
            }

            .airport-clouds {
                animation-duration: 60s;
            }

            .depth-orb.one {
                width: 280px;
                height: 280px;
                left: -110px;
                top: 230px;
            }

            .depth-orb.two {
                width: 320px;
                height: 320px;
                right: -120px;
                top: 160px;
            }

            .depth-orb.three {
                width: 240px;
                height: 240px;
                right: -50px;
                bottom: -70px;
            }

            .trust-metrics {
                grid-template-columns: 1fr;
                gap: 10px;
                margin-top: -2px;
            }

            .airport-layer {
                transition: transform 0.12s ease-out;
            }

            .airport-background {
                --parallax-x: 0px !important;
                --parallax-y: 0px !important;
            }

            .top-bar {
                padding: 10px 15px;
            }

            .profile-info {
                display: none;
            }

            .nav-tabs {
                padding: 0 15px 10px 15px;
            }

            .content-area {
                padding: 15px;
            }

            .welcome-title {
                font-size: 24px;
            }

            .feature-grid {
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            }

            .chat-modal {
                right: 12px;
                bottom: 86px;
                width: calc(100vw - 24px);
                height: min(560px, calc(100vh - 120px));
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
    <script>
        $(document).ready(function() {
            initializeAirportParallax();
            initializeRealAtlasMap();

            function updateProfileCoinsValue(coins) {
                const $coinsValue = $('[data-profile-coins-value]');
                if ($coinsValue.length) {
                    $coinsValue.text(String(coins));
                }
            }

            $(document).on('submit', '.birthday-gift-form', function (event) {
                event.preventDefault();

                const $form = $(this);
                const $button = $form.find('.birthday-gift-btn');
                const originalText = $button.text();

                if ($button.prop('disabled')) {
                    return;
                }

                $button.prop('disabled', true).text('Collecting...');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    dataType: 'json',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function (response) {
                        if (response && response.success) {
                            updateProfileCoinsValue(response.coins);
                            $form.closest('.birthday-gift-banner').fadeOut(220, function () {
                                $(this).remove();
                            });
                            return;
                        }

                        $button.prop('disabled', false).text(originalText);
                        alert((response && response.message) ? response.message : 'Unable to collect birthday gift.');
                    },
                    error: function (xhr) {
                        $button.prop('disabled', false).text(originalText);
                        const message = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Unable to collect birthday gift.';
                        alert(message);
                    }
                });
            });

            function initializeAirportParallax() {
                const airportBackground = document.querySelector('.airport-background');
                if (!airportBackground) {
                    return;
                }

                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (prefersReducedMotion || window.innerWidth <= 768) {
                    airportBackground.style.setProperty('--parallax-x', '0px');
                    airportBackground.style.setProperty('--parallax-y', '0px');
                    return;
                }

                let targetX = 0;
                let targetY = 0;
                let currentX = 0;
                let currentY = 0;

                const animate = function() {
                    currentX += (targetX - currentX) * 0.08;
                    currentY += (targetY - currentY) * 0.08;

                    airportBackground.style.setProperty('--parallax-x', currentX.toFixed(2) + 'px');
                    airportBackground.style.setProperty('--parallax-y', currentY.toFixed(2) + 'px');

                    window.requestAnimationFrame(animate);
                };

                document.addEventListener('mousemove', function (event) {
                    const centerX = window.innerWidth / 2;
                    const centerY = window.innerHeight / 2;
                    const deltaX = (event.clientX - centerX) / centerX;
                    const deltaY = (event.clientY - centerY) / centerY;

                    targetX = deltaX * -6;
                    targetY = deltaY * -5;
                });

                animate();
            }

            function initializeRealAtlasMap() {
                const airportMap = document.querySelector('.airport-map');
                if (!airportMap || airportMap.dataset.realMapInitialized === '1') {
                    return;
                }

                if (typeof window.d3 === 'undefined' || typeof window.topojson === 'undefined') {
                    return;
                }

                airportMap.dataset.realMapInitialized = '1';

                const atlasUrl = 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json';

                const renderAtlas = function(worldData) {
                    const width = Math.max(320, Math.round(airportMap.clientWidth));
                    const height = Math.max(180, Math.round(airportMap.clientHeight));

                    const existing = airportMap.querySelector('.airport-map-svg');
                    if (existing) {
                        existing.remove();
                    }

                    const countries = window.topojson.feature(worldData, worldData.objects.countries).features;
                    const borders = window.topojson.mesh(worldData, worldData.objects.countries, function(a, b) { return a !== b; });

                    const projection = window.d3.geoEquirectangular().fitExtent(
                        [[8, 8], [width - 8, height - 8]],
                        { type: 'Sphere' }
                    );
                    const path = window.d3.geoPath(projection);

                    const svg = window.d3.select(airportMap)
                        .append('svg')
                        .attr('class', 'airport-map-svg')
                        .attr('viewBox', '0 0 ' + width + ' ' + height)
                        .attr('preserveAspectRatio', 'none')
                        .attr('aria-hidden', 'true');

                    // expose projection and svg for radar layer (used by client-side radar polling)
                    window.__airportProjection = projection;
                    window.__airportMapSVG = svg;

                    svg.append('path')
                        .datum({ type: 'Sphere' })
                        .attr('class', 'airport-map-sphere')
                        .attr('d', path);

                    svg.append('path')
                        .datum(window.d3.geoGraticule10())
                        .attr('class', 'airport-map-graticule')
                        .attr('d', path);

                    svg.append('g')
                        .selectAll('path')
                        .data(countries)
                        .join('path')
                        .attr('class', 'airport-map-country')
                        .attr('d', path);

                    svg.append('path')
                        .datum(borders)
                        .attr('class', 'airport-map-borders')
                        .attr('d', path);

                    // add a dedicated radar layer group for flights on top of the map
                    const radarLayer = svg.append('g')
                        .attr('class', 'airport-map-radar-layer')
                        .attr('aria-hidden', 'true');

                    window.__airportRadarLayer = radarLayer;

                    airportMap.classList.add('has-real-map');
                };

                window.fetch(atlasUrl)
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('Unable to load world atlas');
                        }
                        return response.json();
                    })
                    .then(function(worldData) {
                        renderAtlas(worldData);

                        let resizeTimer = null;
                        window.addEventListener('resize', function() {
                            window.clearTimeout(resizeTimer);
                            resizeTimer = window.setTimeout(function() {
                                renderAtlas(worldData);
                            }, 180);
                        });
                    })
                    .catch(function() {
                        airportMap.dataset.realMapInitialized = '0';
                    });

                    // Initialize client-side radar layer (polls /api/radar/flights)
                    function initializeRadarLayer() {
                        const airportMapEl = document.querySelector('.airport-map');
                        if (!airportMapEl) return;

                        // Prevent duplicate poll loops if this initializer runs more than once.
                        if (window.__airportRadarLoopStarted) {
                            return;
                        }
                        window.__airportRadarLoopStarted = true;

                        const pollInterval = 5000; // ms (live refresh cadence)

                        // history store for flight trails: keyed by flight id -> array of [lon, lat]
                        window.__airportRadarHistory = window.__airportRadarHistory || {};
                        const TRAIL_LENGTH = 12;
                        const PIXEL_MAX = 38; // approx 0.5cm visual trail cap
                        // line generator produces pixel-space path from projected points
                        const lineGen = d3.line().x(d => d[0]).y(d => d[1]).curve(d3.curveCatmullRom.alpha(0.85));

                        function getFlightId(d) {
                            return d.icao24 || d.callsign || `${d.latitude}-${d.longitude}`;
                        }

                        function getMapBounds() {
                            const proj = window.__airportProjection;
                            if (!proj || typeof proj.invert !== 'function') return null;

                            const airportMapEl = document.querySelector('.airport-map');
                            if (!airportMapEl) return null;

                            const width = Math.max(320, Math.round(airportMapEl.clientWidth));
                            const height = Math.max(180, Math.round(airportMapEl.clientHeight));
                            const topLeft = proj.invert([0, 0]);
                            const bottomRight = proj.invert([width, height]);
                            if (!topLeft || !bottomRight) return null;

                            return {
                                minLat: Math.min(topLeft[1], bottomRight[1]),
                                maxLat: Math.max(topLeft[1], bottomRight[1]),
                                minLon: Math.min(topLeft[0], bottomRight[0]),
                                maxLon: Math.max(topLeft[0], bottomRight[0]),
                            };
                        }

                        function clamp(value, min, max) {
                            return Math.max(min, Math.min(max, value));
                        }

                        function createSeededRandom(seed) {
                            let t = seed >>> 0;
                            return function() {
                                t += 0x6D2B79F5;
                                let r = Math.imul(t ^ (t >>> 15), t | 1);
                                r ^= r + Math.imul(r ^ (r >>> 7), r | 61);
                                return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
                            };
                        }

                        function pickHourlyFlights(list, hourBucket, maxCount) {
                            const items = (list || []).slice();
                            if (items.length <= maxCount) {
                                return items;
                            }

                            const seed = (hourBucket ^ (items.length << 5) ^ 0x9E3779B9) >>> 0;
                            const rand = createSeededRandom(seed);

                            for (let i = items.length - 1; i > 0; i -= 1) {
                                const j = Math.floor(rand() * (i + 1));
                                const tmp = items[i];
                                items[i] = items[j];
                                items[j] = tmp;
                            }

                            return items.slice(0, maxCount);
                        }

                        function stampLiveFlight(d) {
                            d._motion = {
                                longitude: Number(d.longitude || 0),
                                latitude: Number(d.latitude || 0),
                                velocity: Number(d.velocity || d.speed || 0),
                                heading: Number(d.true_track || d.dir || 0),
                                updatedAt: Date.now(),
                            };
                            return d;
                        }

                        function getLiveFlightPoint(d, nowMs) {
                            const motion = d._motion || {};
                            const lon = Number(motion.longitude ?? d.longitude ?? 0);
                            const lat = Number(motion.latitude ?? d.latitude ?? 0);
                            const velocity = Number(motion.velocity ?? d.velocity ?? d.speed ?? 0);
                            const heading = Number(motion.heading ?? d.true_track ?? d.dir ?? 0);
                            const updatedAt = Number(motion.updatedAt ?? Date.now());
                            const elapsedSeconds = Math.max(0, (nowMs - updatedAt) / 1000);
                            const travelSeconds = Math.min(elapsedSeconds, pollInterval / 1000);

                            if (!velocity || !heading) {
                                return [lon, lat];
                            }

                            const speedKmPerSecond = (velocity * 1.852) / 3600;
                            const distanceKm = speedKmPerSecond * travelSeconds;
                            const headingRad = heading * Math.PI / 180;
                            const latDelta = (distanceKm * Math.cos(headingRad)) / 111.32;
                            const lonScale = Math.max(0.15, Math.cos(lat * Math.PI / 180));
                            const lonDelta = (distanceKm * Math.sin(headingRad)) / (111.32 * lonScale);

                            const bounds = getMapBounds();
                            const nextLon = lon + lonDelta;
                            const nextLat = lat + latDelta;

                            if (!bounds) {
                                return [nextLon, nextLat];
                            }

                            return [
                                clamp(nextLon, bounds.minLon, bounds.maxLon),
                                clamp(nextLat, bounds.minLat, bounds.maxLat),
                            ];
                        }

                        function renderLiveFlightPositions(nowMs) {
                            const svg = window.__airportMapSVG;
                            const radarLayer = window.__airportRadarLayer;
                            const proj = window.__airportProjection;
                            if (!svg || !proj || !radarLayer) return;

                            radarLayer.selectAll('g.flight').each(function(d) {
                                if (!d || d.latitude == null || d.longitude == null) return;

                                const $g = d3.select(this);
                                const id = getFlightId(d);
                                const [lon, lat] = getLiveFlightPoint(d, nowMs);
                                const pt = proj([lon, lat]);
                                if (!pt) return;

                                const heading = d.true_track || d.dir || 0;
                                $g.attr('transform', 'translate(' + pt[0] + ',' + pt[1] + ')')
                                    .attr('data-heading', heading);

                                const hist = window.__airportRadarHistory[id] || [];
                                hist.push([lon, lat]);
                                if (hist.length > 12) hist.splice(0, hist.length - 12);
                                window.__airportRadarHistory[id] = hist;

                                const ptsRaw = hist.map(function(p) { const pp = proj([p[0], p[1]]); return pp; }).filter(Boolean);
                                const ptsPx = ptsRaw.filter(function(p) { return Math.hypot(p[0] - pt[0], p[1] - pt[1]) <= PIXEL_MAX; });
                                if (ptsPx.length >= 2) {
                                    const rel = ptsPx.map(function(p) { return [p[0] - pt[0], p[1] - pt[1]]; });
                                    $g.select('path.flight-trail').attr('d', lineGen(rel)).style('display', null);
                                } else {
                                    $g.select('path.flight-trail').attr('d', null).style('display', 'none');
                                }

                                $g.select('path.flight-plane-path')
                                    .attr('transform', 'rotate(' + heading + ')')
                                    .style('display', null);

                                $g.select('circle.flight-dot').style('display', 'none');
                            });
                        }

                        function getBBoxQuery() {
                            const width = Math.max(320, Math.round(airportMapEl.clientWidth));
                            const height = Math.max(180, Math.round(airportMapEl.clientHeight));
                            const proj = window.__airportProjection;
                            if (!proj || typeof proj.invert !== 'function') return null;
                            const topLeft = proj.invert([0, 0]); // [lon, lat]
                            const bottomRight = proj.invert([width, height]);
                            if (!topLeft || !bottomRight) return null;
                            const minLat = Math.min(topLeft[1], bottomRight[1]);
                            const maxLat = Math.max(topLeft[1], bottomRight[1]);
                            const minLon = Math.min(topLeft[0], bottomRight[0]);
                            const maxLon = Math.max(topLeft[0], bottomRight[0]);
                            return [minLat, maxLat, minLon, maxLon].join(',');
                        }

                        async function fetchAndRender() {
                            const bbox = getBBoxQuery();
                            if (!bbox) return;
                            try {
                                const url = '{{ path('api_radar_flights') }}' + '?bbox=' + encodeURIComponent(bbox) + '&count=500';
                                const res = await fetch(url, { cache: 'no-store' });
                                if (!res.ok) return;
                                const payload = await res.json();
                                const flights = payload.flights || [];
                                const svg = window.__airportMapSVG;
                                const radarLayer = window.__airportRadarLayer;
                                const proj = window.__airportProjection;
                                if (!svg || !proj || !radarLayer) return;


                                // Prefer recent flights (last hour). If too few, fall back to all flights.
                                const nowSec = Math.floor(Date.now() / 1000);
                                const recentFlights = (flights || []).filter(function(f) {
                                    const last = parseInt(f.last_contact || f.time_position || 0, 10) || 0;
                                    return last > 0 && (nowSec - last) <= 3600;
                                });
                                const sourceFlights = ((recentFlights.length >= 80 ? recentFlights : (flights || []))).slice(0, 500);
                                const hourBucket = Math.floor(Date.now() / 3600000);

                                // Keep one stable random set of 100 IDs for the full hour.
                                const sampleState = window.__airportHourlySampleState || { hourBucket: -1, ids: [] };
                                if (sampleState.hourBucket !== hourBucket) {
                                    const sampled = pickHourlyFlights(sourceFlights, hourBucket, 100);
                                    sampleState.hourBucket = hourBucket;
                                    sampleState.ids = sampled.map(getFlightId);
                                    window.__airportHourlySampleState = sampleState;

                                    // Drop previous hour graphics immediately.
                                    if (window.__airportRadarLayer) {
                                        window.__airportRadarLayer.selectAll('g.flight').remove();
                                    }
                                }

                                const selectedIds = new Set(sampleState.ids);
                                const visibleFlights = sourceFlights.filter(function(f) {
                                    return selectedIds.has(getFlightId(f));
                                }).slice(0, 100).map(stampLiveFlight);

                                const groups = radarLayer.selectAll('g.flight').data(visibleFlights, getFlightId);

                                const enter = groups.enter().append('g').attr('class', 'airport-flight-marker flight');
                                // trail path
                                enter.append('path').attr('class', 'flight-trail').attr('d', null);
                                // plane icon (small path) — will be rotated by heading
                                // compact aircraft shape (nose points right)
                                const planePath = 'M-10,0 L-3,-2 L1,-8 L3,-8 L4,-2 L10,-2 L12,-4 L13,-3 L11,0 L13,3 L12,4 L10,2 L4,2 L3,8 L1,8 L-3,2 L-10,0 Z';
                                // small dot for simplified markers
                                enter.append('circle').attr('class', 'flight-dot').attr('r', 2).style('display', 'none');
                                enter.append('path').attr('class', 'flight-plane-path').attr('d', planePath).attr('transform', 'translate(0,0)');
                                enter.append('text').attr('class', 'flight-label').attr('font-size', 11).attr('x', 16).attr('y', -8).attr('text-anchor', 'start');

                                const merged = groups.merge(enter);
                                merged.select('text').each(function(d) {
                                    const label = d3.select(this);
                                    label.selectAll('tspan').remove();

                                    const callsign = (d.flight_icao || d.callsign || d.flight_iata || 'FLIGHT').toString().trim();
                                    label.append('tspan').attr('x', 16).attr('dy', 0).text(callsign);
                                });
                                renderLiveFlightPositions(performance.now());
                                merged.raise();

                                groups.exit().remove();

                                // Hard safety cap: never allow more than 100 rendered flights in DOM.
                                radarLayer.selectAll('g.flight').filter(function(d, i) {
                                    return i >= 100;
                                }).remove();

                                // Remove history for flights no longer displayed to avoid stale memory growth.
                                const visibleIds = new Set(visibleFlights.map(getFlightId));
                                Object.keys(window.__airportRadarHistory).forEach(function(id) {
                                    if (!visibleIds.has(id)) {
                                        delete window.__airportRadarHistory[id];
                                    }
                                });

                                if (!window.__airportRadarAnimationStarted) {
                                    window.__airportRadarAnimationStarted = true;
                                    (function animateRadar() {
                                        renderLiveFlightPositions(performance.now());
                                        window.requestAnimationFrame(animateRadar);
                                    })();
                                }
                            } catch (e) {
                                console.warn('Radar layer error', e);
                            }
                        }

                        // Poll loop
                        (function pollLoop() {
                            fetchAndRender().finally(() => setTimeout(pollLoop, pollInterval));
                        })();

                        window.addEventListener('resize', function() { setTimeout(fetchAndRender, 400); });
                    }

                    // start radar after atlas may initialize; safe to call repeatedly
                    setTimeout(initializeRadarLayer, 1200);
            }

            // Menu toggle
            let isMenuOpen = false;
            
            $('.menu-toggle').click(function() {
                if (isMenuOpen) {
                    $('.side-menu').removeClass('open');
                    $('.menu-overlay').removeClass('show');
                } else {
                    $('.side-menu').addClass('open');
                    $('.menu-overlay').addClass('show');
                }
                isMenuOpen = !isMenuOpen;
            });
            
            $('.menu-overlay').click(function() {
                $('.side-menu').removeClass('open');
                $('.menu-overlay').removeClass('show');
                isMenuOpen = false;
            });
            
            // Profile popup on hover
            let hoverTimer;
            const $profileSection = $('.profile-section');
            const $profilePopup = $('.profile-popup');
            
            $profileSection.hover(
                function() {
                    hoverTimer = setTimeout(function() {
                        $profilePopup.addClass('show');
                        // Position popup near avatar
                        const offset = $profileSection.offset();
                        $profilePopup.css({
                            top: offset.top + 60,
                            right: 20
                        });
                    }, 120);
                },
                function() {
                    clearTimeout(hoverTimer);
                    $profilePopup.removeClass('show');
                }
            );
            
            // Nav tab switching (load content dynamically)
            $('.nav-tab').click(function() {
                if ($(this).is('a') && $(this).attr('href')) {
                    return;
                }
                $('.nav-tab').removeClass('active');
                $(this).addClass('active');
                
                const view = $(this).data('view');
                loadContentView(view);
            });
            
            function loadContentView(view) {
                $.ajax({
                    url: '{{ path('app_load_content') }}',
                    type: 'POST',
                    data: { view: view },
                    success: function(response) {
                        $('.content-area').html(response);
                        if (view === 'shop') {
                            initializeShopModule();
                        }
                        if (view === 'messenger') {
                            initializeMessengerModule();
                        }
                    },
                    error: function() {
                        console.error('Failed to load content');
                    }
                });
            }

            function loadModuleFromUrl() {
                const params = new URLSearchParams(window.location.search);
                const moduleView = params.get('module');
                if (!moduleView) {
                    return;
                }

                const $targetTab = $('.nav-tab[data-view="' + moduleView + '"]');
                if ($targetTab.length) {
                    $('.nav-tab').removeClass('active');
                    $targetTab.addClass('active');
                }

                loadContentView(moduleView);
            }

            loadModuleFromUrl();

            window.loadMainpageModule = loadContentView;

            function initializeShopModule() {
                const $module = $('.shop-module');
                if (!$module.length) {
                    return;
                }

                const $productCards = $module.find('.shop-grid .product-card');
                const $pagination = $module.find('.shop-pagination');
                const itemsPerPage = Math.max(1, Number($pagination.data('itemsPerPage') || 25));
                let currentPage = 1;

                function renderShopPagination() {
                    if (!$pagination.length || !$productCards.length) {
                        return;
                    }

                    const totalPages = Math.ceil($productCards.length / itemsPerPage);
                    if (totalPages <= 1) {
                        $pagination.empty().hide();
                        $productCards.show();
                        return;
                    }

                    currentPage = Math.min(Math.max(1, currentPage), totalPages);
                    $productCards.each(function (index) {
                        const page = Math.floor(index / itemsPerPage) + 1;
                        $(this).toggle(page === currentPage);
                    });

                    let buttonsHtml = '';
                    for (let page = 1; page <= totalPages; page += 1) {
                        buttonsHtml += '<button type="button" class="shop-page-btn' + (page === currentPage ? ' is-active' : '') + '" data-page="' + page + '">' + page + '</button>';
                    }

                    $pagination.html(buttonsHtml).show();
                }

                $(document).off('click.shopPagination').on('click.shopPagination', '.shop-module .shop-page-btn', function () {
                    const nextPage = Number($(this).data('page') || 1);
                    if (!Number.isFinite(nextPage) || nextPage < 1) {
                        return;
                    }

                    currentPage = nextPage;
                    renderShopPagination();
                });

                renderShopPagination();

                const availableCoins = Number($module.data('availableCoins') || 0);
                const mapboxToken = String($module.data('mapboxToken') || '');
                const mapHintNoToken = String($module.data('mapHintNoToken') || '');
                const mapHintError = String($module.data('mapHintError') || '');
                const $overlay = $module.find('.shop-order-modal');
                const $productId = $module.find('.js-product-id');
                const $productName = $module.find('.js-product-name');
                const $productPrice = $module.find('.js-product-price');
                const $totalCoins = $module.find('.js-total-coins');
                const $locationText = $module.find('.js-location-text');
                const $locationLat = $module.find('.js-location-lat');
                const $locationLng = $module.find('.js-location-lng');
                const mapContainer = $module.find('.js-order-map')[0];
                const $mapHint = $module.find('.map-hint');
                const $submitButton = $module.find('.btn-submit');
                let currentPrice = 0;
                let currentStock = 1;
                let map = null;
                let marker = null;

                function updateTotal() {
                    const total = currentPrice;
                    $totalCoins.text(String(total));
                    $submitButton.prop('disabled', total > availableCoins || currentStock <= 0);
                }

                function closeModal() {
                    $overlay.removeClass('show').attr('aria-hidden', 'true');
                }

                function openModal() {
                    $overlay.addClass('show').attr('aria-hidden', 'false');
                    if (map && typeof map.resize === 'function') {
                        setTimeout(function () {
                            map.resize();
                        }, 120);
                    } else if (map && typeof map.invalidateSize === 'function') {
                        setTimeout(function () {
                            map.invalidateSize();
                        }, 120);
                    }
                }

                function setLocation(lat, lng, label) {
                    $locationLat.val(lat.toFixed(6));
                    $locationLng.val(lng.toFixed(6));
                    $locationText.val(label || (lat.toFixed(6) + ', ' + lng.toFixed(6)));
                }

                function loadLeafletAssets() {
                    return new Promise(function (resolve, reject) {
                        if (typeof window.L !== 'undefined') {
                            resolve();
                            return;
                        }

                        const existingScript = document.getElementById('leaflet-js');
                        if (existingScript) {
                            existingScript.addEventListener('load', function () { resolve(); }, { once: true });
                            existingScript.addEventListener('error', function () { reject(new Error('Leaflet failed to load.')); }, { once: true });
                            return;
                        }

                        if (!document.getElementById('leaflet-css')) {
                            const leafletCss = document.createElement('link');
                            leafletCss.id = 'leaflet-css';
                            leafletCss.rel = 'stylesheet';
                            leafletCss.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                            leafletCss.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
                            leafletCss.crossOrigin = '';
                            document.head.appendChild(leafletCss);
                        }

                        const leafletScript = document.createElement('script');
                        leafletScript.id = 'leaflet-js';
                        leafletScript.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                        leafletScript.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
                        leafletScript.crossOrigin = '';
                        leafletScript.onload = function () { resolve(); };
                        leafletScript.onerror = function () { reject(new Error('Leaflet failed to load.')); };
                        document.body.appendChild(leafletScript);
                    });
                }

                function initMap() {
                    if (map || !mapContainer) {
                        return;
                    }

                    if (mapboxToken && typeof window.mapboxgl !== 'undefined') {
                        window.mapboxgl.accessToken = mapboxToken;
                        map = new window.mapboxgl.Map({
                            container: mapContainer,
                            style: 'mapbox://styles/mapbox/streets-v12',
                            center: [10.1815, 36.8065],
                            zoom: 10,
                        });

                        map.on('click', function (event) {
                            const lng = event.lngLat.lng;
                            const lat = event.lngLat.lat;

                            if (!marker) {
                                marker = new window.mapboxgl.Marker({ color: '#0fa5a2' }).setLngLat([lng, lat]).addTo(map);
                            } else {
                                marker.setLngLat([lng, lat]);
                            }

                            fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/' + lng + ',' + lat + '.json?access_token=' + mapboxToken)
                                .then((response) => response.ok ? response.json() : null)
                                .then((payload) => {
                                    const place = payload && payload.features && payload.features[0] ? payload.features[0].place_name : '';
                                    setLocation(lat, lng, place);
                                })
                                .catch(() => {
                                    setLocation(lat, lng, '');
                                });
                        });

                        return;
                    }

                    $mapHint.text(mapHintNoToken);

                    loadLeafletAssets()
                        .then(function () {
                            if (map || typeof window.L === 'undefined') {
                                return;
                            }

                            map = window.L.map(mapContainer).setView([36.8065, 10.1815], 10);

                            window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                maxZoom: 19,
                                attribution: '&copy; OpenStreetMap contributors'
                            }).addTo(map);

                            map.on('click', function (event) {
                                const lat = event.latlng.lat;
                                const lng = event.latlng.lng;

                                if (!marker) {
                                    marker = window.L.marker([lat, lng]).addTo(map);
                                } else {
                                    marker.setLatLng([lat, lng]);
                                }

                                fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=' + lat + '&lon=' + lng)
                                    .then((response) => response.ok ? response.json() : null)
                                    .then((payload) => {
                                        const label = payload && payload.display_name ? payload.display_name : '';
                                        setLocation(lat, lng, label);
                                    })
                                    .catch(() => {
                                        setLocation(lat, lng, '');
                                    });
                            });
                        })
                        .catch(function () {
                            $mapHint.text(mapHintError);
                        });
                }

                $(document).off('click.shopModule').on('click.shopModule', '.shop-module .order-btn', function () {
                    const $button = $(this);
                    currentPrice = Number($button.data('productPrice') || 0);
                    currentStock = Math.max(1, Number($button.data('productStock') || 1));

                    $productId.val(String($button.data('productId') || ''));
                    $productName.text(String($button.data('productName') || 'Product'));
                    $productPrice.text(String(currentPrice));
                    $locationLat.val('');
                    $locationLng.val('');
                    $locationText.val('');
                    updateTotal();
                    openModal();
                    initMap();
                });

                $(document).off('click.shopModuleClose').on('click.shopModuleClose', '.shop-module .order-close', function () {
                    closeModal();
                });

                $(document).off('click.shopModuleOverlay').on('click.shopModuleOverlay', '.shop-module .shop-order-modal', function (event) {
                    if (event.target === this) {
                        closeModal();
                    }
                });

                $(document).off('input.shopModule').on('input.shopModule', '.shop-module .js-location-text', function () {
                    $locationText.val($(this).val());
                });

                if (!mapboxToken) {
                    $mapHint.text(mapHintNoToken);
                }
            }

            let messengerPoller = null;
            let currentConversationId = null;

            function initializeMessengerModule() {
                const messagesArea = document.getElementById('messagesArea');
                const messageInput = document.getElementById('messageInput');
                const sendMessageBtn = document.getElementById('sendMessageBtn');
                const inputStatus = document.getElementById('inputStatus');
                const conversationViewContent = document.getElementById('conversationViewContent');
                const noConversationView = document.getElementById('noConversationView');
                const selectedConvName = document.getElementById('selectedConvName');
                const selectedConvStatus = document.getElementById('selectedConvStatus');

                if (!messagesArea) return;

                function escapeHtml(val) {
                    const div = document.createElement('div');
                    div.textContent = val;
                    return div.innerHTML;
                }

                function loadMessages() {
                    if (!currentConversationId) return;

                    $.ajax({
                        url: '{{ path('app_chat_messages') }}',
                        type: 'GET',
                        success: function(response) {
                            if (!Array.isArray(response.messages) || response.messages.length === 0) {
                                messagesArea.innerHTML = '<div class="messages-empty">Aucun message. Commencez la conversation!</div>';
                                return;
                            }

                            const html = response.messages.map(function(msg) {
                                const groupClass = msg.isMine ? 'sent' : 'received';
                                const bubbleClass = msg.isMine ? 'sent' : 'received';
                                const senderLabel = msg.isMine ? 'Vous' : escapeHtml(msg.senderName || 'Support');
                                const timestamp = escapeHtml(msg.timestamp || '');
                                const content = escapeHtml(msg.message || '');

                                return `
                                    <div class="message-group ${groupClass}">
                                        <div class="message-bubble ${bubbleClass}">${content}</div>
                                        <div class="message-time">${timestamp}</div>
                                    </div>
                                `;
                            }).join('');

                            messagesArea.innerHTML = html;
                            messagesArea.scrollTop = messagesArea.scrollHeight;
                        }
                    });
                }

                function sendMessage() {
                    const text = (messageInput.value || '').trim();
                    if (!text) {
                        return;
                    }

                    inputStatus.textContent = '';
                    messageInput.disabled = true;
                    sendMessageBtn.disabled = true;

                    $.ajax({
                        url: '{{ path('app_chat_send') }}',
                        type: 'POST',
                        data: { message: text },
                        success: function() {
                            messageInput.value = '';
                            messageInput.disabled = false;
                            sendMessageBtn.disabled = false;
                            loadMessages();
                            messageInput.focus();
                        },
                        error: function(xhr) {
                            messageInput.disabled = false;
                            sendMessageBtn.disabled = false;
                            const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                            inputStatus.textContent = payload && payload.error ? payload.error : 'Erreur lors de l\'envoi.';
                        }
                    });
                }

                if (sendMessageBtn) {
                    sendMessageBtn.addEventListener('click', sendMessage);
                }

                if (messageInput) {
                    messageInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            sendMessage();
                        }
                    });
                }

                // Afficher la conversation et charger les messages
                if (conversationViewContent && noConversationView) {
                    conversationViewContent.style.display = 'flex';
                    noConversationView.style.display = 'none';
                    currentConversationId = 1;
                    selectedConvName.textContent = 'Support Admin';
                    selectedConvStatus.textContent = 'En ligne';
                    loadMessages();
                }

                if (messengerPoller) {
                    clearInterval(messengerPoller);
                }
                messengerPoller = setInterval(loadMessages, 8000);
            }
            
            // Refresh unread badge periodically
            function refreshBadge() {
                $.ajax({
                    url: '{{ path('app_unread_count') }}',
                    type: 'GET',
                    dataType: 'json',
                    success: function(response) {
                        const rawCount = response && (response.unreadCount ?? response.unread_count ?? 0);
                        const count = Number(rawCount || 0);
                        if (count > 0) {
                            $('.chat-badge').text(count > 99 ? '99+' : count).show();
                        } else {
                            $('.chat-badge').hide();
                        }
                    },
                    error: function() {
                        $('.chat-badge').hide();
                    }
                });
            }
            
            refreshBadge();
            setInterval(refreshBadge, 10000);

            const $chatModal = $('#chatModal');
            const $chatMessages = $('#chatMessages');
            const $chatInput = $('#chatInput');
            const $chatStatus = $('#chatStatus');
            const $chatAdminRow = $('#chatAdminConversationRow');
            const $chatAdminSelect = $('#chatAdminConversationSelect');
            const $chatCallBtn = $('#chatCallBtn');
            const $chatUserCallPicker = $('#chatUserCallPicker');
            const $chatUserCallAdminSelect = $('#chatUserCallAdminSelect');
            const $chatUserCallStartBtn = $('#chatUserCallStartBtn');
            const $chatUserCallCancelBtn = $('#chatUserCallCancelBtn');
            const $chatAttachBtn = $('#chatAttachBtn');
            const $chatAttachmentInput = $('#chatAttachmentInput');
            const $chatSelectedFile = $('#chatSelectedFile');
            const $chatSelectedFileName = $('#chatSelectedFileName');
            const $chatSelectedFileClear = $('#chatSelectedFileClear');
            let chatPoller = null;
            let lastMessagesSignature = '';
            let chatIsAdmin = false;
            let activeChatUserId = 0;
            let chatSupportAdmins = [];
            let pendingAttachmentFile = null;
            const chatLabels = {
                you: '{{ 'main.chat.you'|trans }}',
                admin: '{{ 'main.chat.admin'|trans }}',
                deleted: '{{ 'main.chat.deleted_text'|trans }}',
                edited: '{{ 'main.chat.edited'|trans }}',
                edit: '{{ 'main.chat.edit'|trans }}',
                delete: '{{ 'main.chat.delete'|trans }}',
                editPrompt: '{{ 'main.chat.edit_prompt'|trans }}',
                deleteConfirm: '{{ 'main.chat.delete_confirm'|trans }}',
                editFailed: '{{ 'main.chat.edit_failed'|trans }}',
                deleteFailed: '{{ 'main.chat.delete_failed'|trans }}',
                emptyAdmin: '{{ 'main.chat.empty_admin'|trans }}',
                emptyUser: '{{ 'main.chat.empty_user'|trans }}',
                attachmentSelected: '{{ 'main.chat.attachment_selected'|trans }}'
            };
            const chatCurrentUserId = Number('{{ app.user.id|default(0) }}') || 0;
            const chatCallerName = '{{ app.user.fullName|default(app.user.username)|e('js') }}';
            const chatCallBase = 'rehletna-support';
            const chatCallPrefix = '[call]:';

            function buildSupportCallRoom() {
                if (chatIsAdmin) {
                    if (activeChatUserId <= 0) {
                        return '';
                    }

                    return chatCallBase + '-u' + String(activeChatUserId);
                }

                return chatCurrentUserId > 0
                    ? chatCallBase + '-u' + String(chatCurrentUserId)
                    : chatCallBase;
            }

            function sendCallSignal(signal, options) {
                const payload = new FormData();
                payload.append('message', chatCallPrefix + JSON.stringify(signal));

                if (options && options.userId) {
                    payload.append('userId', String(options.userId));
                }

                if (options && options.adminId) {
                    payload.append('adminId', String(options.adminId));
                }

                return $.ajax({
                    url: '{{ path('app_chat_send') }}',
                    type: 'POST',
                    data: payload,
                    processData: false,
                    contentType: false
                });
            }

            function openSupportCall() {
                $chatStatus.text('');

                if (chatIsAdmin) {
                    const room = buildSupportCallRoom();
                    if (!room || activeChatUserId <= 0) {
                        $chatStatus.text('Choose a user conversation first.');
                        return;
                    }

                    sendCallSignal(
                        { type: 'invite', room: room, fromName: chatCallerName },
                        { userId: activeChatUserId }
                    ).done(function () {
                        $chatStatus.text('Call invitation sent to user.');
                        loadChatMessages();
                    }).fail(function (xhr) {
                        const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                        $chatStatus.text(payload && payload.error ? payload.error : 'Unable to send call invitation.');
                    });

                    return;
                }

                if (!Array.isArray(chatSupportAdmins) || chatSupportAdmins.length === 0) {
                    $chatStatus.text('No admin available to call right now.');
                    return;
                }

                $chatUserCallPicker.show();
                $chatUserCallAdminSelect.trigger('focus');
            }

            function clearSelectedAttachment() {
                pendingAttachmentFile = null;
                $chatAttachmentInput.val('');
                $chatSelectedFile.hide();
                $chatSelectedFileName.text('');
            }

            function escapeHtml(value) {
                return $('<div>').text(value || '').html();
            }

            function deliveryBadge(state) {
                if (!state) {
                    return '';
                }

                if (state === 'seen') {
                    return '<span class="chat-delivery chat-delivery-seen">✓✓</span>';
                }

                if (state === 'delivered') {
                    return '<span class="chat-delivery chat-delivery-delivered">✓✓</span>';
                }

                return '<span class="chat-delivery chat-delivery-sent">✓</span>';
            }

            function renderAdminConversations(response) {
                chatIsAdmin = !!(response && response.isAdmin);

                if (!chatIsAdmin) {
                    $chatAdminRow.hide();
                    activeChatUserId = 0;
                    return;
                }

                $chatUserCallPicker.hide();

                const conversations = Array.isArray(response.conversations) ? response.conversations : [];
                const nextActive = Number(response.activeUserId || activeChatUserId || 0);
                activeChatUserId = Number.isFinite(nextActive) ? nextActive : 0;

                if (conversations.length === 0) {
                    $chatAdminRow.show();
                    $chatAdminSelect.html('<option value="">No user conversations</option>').prop('disabled', true);
                    return;
                }

                const options = conversations.map(function (conversation) {
                    const id = Number(conversation.userId || 0);
                    const username = String(conversation.username || 'user');
                    const displayName = String(conversation.userName || username);
                    const unreadCount = Number(conversation.unreadCount || 0);
                    const onlineDot = conversation.isOnline ? '●' : '○';
                    const unreadPart = unreadCount > 0 ? ' [' + unreadCount + ']' : '';
                    const selected = id === activeChatUserId ? ' selected' : '';

                    return '<option value="' + id + '"' + selected + '>'
                        + onlineDot + ' ' + escapeHtml(displayName) + ' (@' + escapeHtml(username) + ')' + unreadPart
                        + '</option>';
                }).join('');

                $chatAdminSelect.html(options).prop('disabled', false);
                $chatAdminRow.show();

                if (!activeChatUserId) {
                    const firstId = Number(conversations[0].userId || 0);
                    activeChatUserId = Number.isFinite(firstId) ? firstId : 0;
                }
            }

            function renderUserCallAdmins(response) {
                if (chatIsAdmin) {
                    $chatUserCallPicker.hide();
                    chatSupportAdmins = [];
                    return;
                }

                const admins = Array.isArray(response.admins) ? response.admins : [];
                chatSupportAdmins = admins;
                if (admins.length === 0) {
                    $chatUserCallPicker.hide();
                    $chatUserCallAdminSelect.html('<option value="">No admin available</option>');
                    return;
                }

                const options = admins.map(function (admin) {
                    const id = Number(admin.id || 0);
                    const username = String(admin.username || 'admin');
                    const name = String(admin.name || username);
                    const dot = admin.isOnline ? '●' : '○';
                    return '<option value="' + id + '">' + dot + ' ' + escapeHtml(name) + ' (@' + escapeHtml(username) + ')</option>';
                }).join('');

                $chatUserCallAdminSelect.html(options);
            }

            function renderChatMessages(messages) {
                if (!Array.isArray(messages) || messages.length === 0) {
                    const emptyText = chatIsAdmin
                        ? chatLabels.emptyAdmin
                        : chatLabels.emptyUser;
                    $chatMessages.html('<div class="chat-empty">' + escapeHtml(emptyText) + '</div>');
                    lastMessagesSignature = 'empty';
                    return;
                }

                const signature = messages.map(m => `${m.id}:${m.isRead ? 1 : 0}`).join('|');
                if (signature === lastMessagesSignature) {
                    return;
                }
                lastMessagesSignature = signature;

                const html = messages.map(function(msg) {
                    const sideClass = msg.isMine ? 'mine' : 'other';
                    const senderLabel = msg.isMine ? chatLabels.you : escapeHtml(msg.senderName || msg.senderUsername || chatLabels.admin);
                    const timeLabel = escapeHtml(msg.timestamp || '');
                    const callSignal = msg.callSignal && typeof msg.callSignal === 'object' ? msg.callSignal : null;
                    const content = msg.isDeleted ? escapeHtml(chatLabels.deleted) : escapeHtml(msg.message || '');
                    const contentClass = msg.isDeleted ? 'chat-message-content deleted' : 'chat-message-content';
                    const attachment = msg.attachment && typeof msg.attachment === 'object' ? msg.attachment : null;
                    let attachmentHtml = '';
                    let callHtml = '';
                    if (!msg.isDeleted && attachment && attachment.url) {
                        const fileUrl = escapeHtml(attachment.url);
                        const fileName = escapeHtml(attachment.name || 'attachment');
                        if ((attachment.kind || '') === 'image') {
                            attachmentHtml = `
                                <a class="chat-attachment-link" href="${fileUrl}" target="_blank" rel="noopener noreferrer">
                                    <img class="chat-attachment-preview" src="${fileUrl}" alt="${fileName}" />
                                </a>
                                <div class="chat-attachment-name">📎 ${fileName}</div>
                            `;
                        } else {
                            attachmentHtml = `
                                <a class="chat-attachment-link" href="${fileUrl}" target="_blank" rel="noopener noreferrer">📄 ${fileName}</a>
                            `;
                        }
                    }

                    if (!msg.isDeleted && !attachment && callSignal && callSignal.type) {
                        const room = escapeHtml(callSignal.room || '');
                        if (callSignal.type === 'invite') {
                            if (msg.isMine) {
                                callHtml = `
                                    <div class="chat-call-card">
                                        <div class="chat-call-title">Call invitation sent.</div>
                                        <div class="chat-call-actions">
                                            <button class="chat-call-action-btn join chat-call-join" data-room="${room}">Join</button>
                                        </div>
                                    </div>
                                `;
                            } else {
                                callHtml = `
                                    <div class="chat-call-card">
                                        <div class="chat-call-title">Incoming call from ${senderLabel}</div>
                                        <div class="chat-call-actions">
                                            <button class="chat-call-action-btn join chat-call-join" data-room="${room}" data-sender-id="${msg.senderId}">Join</button>
                                            <button class="chat-call-action-btn decline chat-call-decline" data-room="${room}" data-sender-id="${msg.senderId}">Decline</button>
                                        </div>
                                    </div>
                                `;
                            }
                        } else if (callSignal.type === 'accept') {
                            callHtml = `
                                <div class="chat-call-card">
                                    <div class="chat-call-title">Call accepted.</div>
                                    <div class="chat-call-actions">
                                        <button class="chat-call-action-btn join chat-call-join" data-room="${room}">Join</button>
                                    </div>
                                </div>
                            `;
                        } else if (callSignal.type === 'decline') {
                            callHtml = '<div class="chat-call-card"><div class="chat-call-title">Call declined.</div></div>';
                        }
                    }

                    const status = msg.isMine ? deliveryBadge(msg.deliveryState || (msg.isRead ? 'seen' : 'sent')) : '';
                    const editedTag = msg.isEdited ? ' • ' + escapeHtml(chatLabels.edited) : '';
                    const metaTail = (status ? ' • ' + status : '') + editedTag;
                    const canEdit = msg.isMine && !msg.isDeleted && !attachment && !callSignal;
                    const actionHtml = canEdit
                        ? `<div class="chat-message-actions">
                               <button class="chat-action-btn chat-action-edit" data-message-id="${msg.id}" data-message-text="${escapeHtml(msg.message || '')}" title="${escapeHtml(chatLabels.edit)}">✎</button>
                               <button class="chat-action-btn chat-action-delete" data-message-id="${msg.id}" title="${escapeHtml(chatLabels.delete)}">🗑</button>
                           </div>
                           <div class="chat-inline-editor" data-message-id="${msg.id}" style="display:none;">
                               <input class="chat-inline-input" type="text" maxlength="1000" value="${escapeHtml(msg.message || '')}" />
                               <button class="chat-inline-btn chat-action-save-edit" type="button" title="Save">✓</button>
                               <button class="chat-inline-btn chat-action-cancel-edit" type="button" title="Cancel">✕</button>
                           </div>`
                        : '';

                    return `
                        <div class="chat-message ${sideClass}">
                            ${callHtml || `<div class="${contentClass}">${content}</div>`}
                            ${attachmentHtml}
                            <div class="chat-message-meta">${senderLabel} • ${timeLabel}${metaTail}</div>
                            ${actionHtml}
                        </div>
                    `;
                }).join('');

                $chatMessages.html(html);
                $chatMessages.scrollTop($chatMessages[0].scrollHeight);
            }

            function loadChatMessages() {
                const queryData = {};
                if (chatIsAdmin && activeChatUserId > 0) {
                    queryData.userId = activeChatUserId;
                }

                $.ajax({
                    url: '{{ path('app_chat_messages') }}',
                    type: 'GET',
                    data: queryData,
                    success: function(response) {
                        renderAdminConversations(response || {});
                        renderUserCallAdmins(response || {});
                        renderChatMessages(response.messages || []);
                        refreshBadge();
                    },
                    error: function() {
                        $chatStatus.text('Unable to load chat messages right now.');
                    }
                });
            }

            function openChatModal() {
                $chatStatus.text('');
                $chatModal.addClass('show');
                if (!chatIsAdmin) {
                    $chatAdminRow.hide();
                }
                loadChatMessages();
                if (chatPoller) {
                    clearInterval(chatPoller);
                }
                chatPoller = setInterval(loadChatMessages, 5000);
                setTimeout(function() {
                    $chatInput.trigger('focus');
                }, 50);
            }

            function closeChatModal() {
                $chatModal.removeClass('show');
                if (chatPoller) {
                    clearInterval(chatPoller);
                    chatPoller = null;
                }
            }

            window.showChatPopup = openChatModal;

            $('#chatCloseBtn').on('click', closeChatModal);
            $chatCallBtn.on('click', openSupportCall);

            $chatUserCallStartBtn.on('click', function () {
                const adminId = Number($chatUserCallAdminSelect.val() || 0);
                if (adminId <= 0) {
                    $chatStatus.text('Choose an admin first.');
                    return;
                }

                const room = buildSupportCallRoom();
                sendCallSignal(
                    { type: 'invite', room: room, fromName: chatCallerName },
                    { adminId: adminId }
                ).done(function () {
                    $chatUserCallPicker.hide();
                    $chatStatus.text('Call invitation sent to selected admin.');
                    loadChatMessages();
                }).fail(function (xhr) {
                    const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                    $chatStatus.text(payload && payload.error ? payload.error : 'Unable to send call invitation.');
                });
            });

            $chatUserCallCancelBtn.on('click', function () {
                $chatUserCallPicker.hide();
            });

            $(document).on('click', '.chat-call-join', function () {
                const room = String($(this).data('room') || '').trim();
                const senderId = Number($(this).data('senderId') || 0);
                if (!room) {
                    return;
                }

                const meetingUrl = 'https://meet.jit.si/' + encodeURIComponent(room);

                if (senderId <= 0) {
                    window.open(meetingUrl, '_blank', 'noopener,noreferrer');
                    return;
                }

                const options = chatIsAdmin ? { userId: senderId } : { adminId: senderId };

                sendCallSignal(
                    { type: 'accept', room: room, fromName: chatCallerName },
                    options
                ).always(function () {
                    window.open(meetingUrl, '_blank', 'noopener,noreferrer');
                    loadChatMessages();
                });
            });

            $(document).on('click', '.chat-call-decline', function () {
                const room = String($(this).data('room') || '').trim();
                const senderId = Number($(this).data('senderId') || 0);
                if (!room || senderId <= 0) {
                    return;
                }

                const options = chatIsAdmin ? { userId: senderId } : { adminId: senderId };
                sendCallSignal(
                    { type: 'decline', room: room, fromName: chatCallerName },
                    options
                ).always(function () {
                    loadChatMessages();
                });
            });

            $(document).on('keydown', function(event) {
                if (event.key === 'Escape') {
                    closeChatModal();
                }
            });

            $('#chatSendBtn').on('click', function() {
                const text = ($chatInput.val() || '').trim();
                if (!text && !pendingAttachmentFile) {
                    return;
                }

                if (chatIsAdmin && activeChatUserId <= 0) {
                    $chatStatus.text('Choose a user conversation first.');
                    return;
                }

                const payload = new FormData();
                payload.append('message', text);
                if (chatIsAdmin && activeChatUserId > 0) {
                    payload.append('userId', String(activeChatUserId));
                }

                if (pendingAttachmentFile) {
                    payload.append('attachment', pendingAttachmentFile);
                }

                $chatStatus.text('');
                $.ajax({
                    url: '{{ path('app_chat_send') }}',
                    type: 'POST',
                    data: payload,
                    processData: false,
                    contentType: false,
                    success: function() {
                        $chatInput.val('');
                        clearSelectedAttachment();
                        $chatStatus.text('');
                        loadChatMessages();
                    },
                    error: function(xhr) {
                        const fallback = 'Unable to send message now.';
                        const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                        $chatStatus.text(payload && payload.error ? payload.error : fallback);
                    }
                });
            });

            $chatInput.on('keydown', function(event) {
                if (event.key === 'Enter' && !event.shiftKey) {
                    event.preventDefault();
                    $('#chatSendBtn').trigger('click');
                }
            });

            $chatAttachBtn.on('click', function () {
                $chatAttachmentInput.trigger('click');
            });

            $chatAttachmentInput.on('change', function () {
                const file = this.files && this.files[0] ? this.files[0] : null;
                pendingAttachmentFile = file;
                if (file) {
                    $chatStatus.text('');
                    $chatSelectedFileName.text(chatLabels.attachmentSelected + ': ' + file.name);
                    $chatSelectedFile.show();
                } else {
                    clearSelectedAttachment();
                }
            });

            $chatSelectedFileClear.on('click', function () {
                clearSelectedAttachment();
            });

            $(document).on('click', '.chat-action-edit', function () {
                const messageId = Number($(this).data('messageId') || 0);
                if (messageId <= 0) {
                    return;
                }

                const $message = $(this).closest('.chat-message');
                const $content = $message.find('.chat-message-content').first();
                const $actions = $message.find('.chat-message-actions').first();
                const $editor = $message.find('.chat-inline-editor').first();
                const $input = $editor.find('.chat-inline-input').first();

                $chatMessages.find('.chat-inline-editor').hide();
                $chatMessages.find('.chat-message-content').show();
                $chatMessages.find('.chat-message-actions').show();

                $content.hide();
                $actions.hide();
                $editor.show();
                $input.trigger('focus');
                const rawValue = String($input.val() || '');
                $input[0].setSelectionRange(rawValue.length, rawValue.length);
            });

            $(document).on('click', '.chat-action-cancel-edit', function () {
                const $message = $(this).closest('.chat-message');
                $message.find('.chat-inline-editor').hide();
                $message.find('.chat-message-content').show();
                $message.find('.chat-message-actions').show();
            });

            $(document).on('click', '.chat-action-save-edit', function () {
                const $editor = $(this).closest('.chat-inline-editor');
                const messageId = Number($editor.data('messageId') || 0);
                const trimmed = String($editor.find('.chat-inline-input').val() || '').trim();

                if (messageId <= 0 || trimmed === '') {
                    return;
                }

                $.ajax({
                    url: '{{ path('app_chat_edit') }}',
                    type: 'POST',
                    data: { id: messageId, message: trimmed },
                    success: function () {
                        lastMessagesSignature = '';
                        loadChatMessages();
                    },
                    error: function (xhr) {
                        const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                        $chatStatus.text(payload && payload.error ? payload.error : chatLabels.editFailed);
                    }
                });
            });

            $(document).on('keydown', '.chat-inline-input', function (event) {
                if (event.key === 'Enter' && !event.shiftKey) {
                    event.preventDefault();
                    $(this).closest('.chat-inline-editor').find('.chat-action-save-edit').trigger('click');
                }
                if (event.key === 'Escape') {
                    event.preventDefault();
                    $(this).closest('.chat-inline-editor').find('.chat-action-cancel-edit').trigger('click');
                }
            });

            $(document).on('click', '.chat-action-delete', function () {
                const messageId = Number($(this).data('messageId') || 0);
                if (messageId <= 0) {
                    return;
                }

                if (!window.confirm(chatLabels.deleteConfirm)) {
                    return;
                }

                $.ajax({
                    url: '{{ path('app_chat_delete') }}',
                    type: 'POST',
                    data: { id: messageId },
                    success: function () {
                        lastMessagesSignature = '';
                        loadChatMessages();
                    },
                    error: function (xhr) {
                        const payload = xhr && xhr.responseJSON ? xhr.responseJSON : null;
                        $chatStatus.text(payload && payload.error ? payload.error : chatLabels.deleteFailed);
                    }
                });
            });

            $chatAdminSelect.on('change', function () {
                const selected = Number($(this).val() || 0);
                activeChatUserId = Number.isFinite(selected) ? selected : 0;
                lastMessagesSignature = '';
                loadChatMessages();
            });
            
            // Side menu actions
            $('.side-menu-btn').click(function() {
                const action = $(this).data('action');
                if (action === 'logout') {
                    if (typeof window.showGlobalLoader === 'function') {
                        window.showGlobalLoader('Signing you out...');
                    }
                    setTimeout(function() {
                        window.location.href = '{{ path('app_logout') }}';
                    }, 120);
                } else if (action === 'dashboard') {
                    window.location.href = '{{ path('app_dashboard') }}';
                } else if (action === 'guide-dashboard') {
                    window.location.href = '{{ path('app_guide_dashboard') }}';
                } else if (action === 'reservations') {
                    window.location.href = '{{ path('app_reservations') }}';
                } else if (action === 'face-id-enroll') {
                    window.location.href = '{{ path('app_face_id_enroll_page') }}';
                } else if (action === 'my-reservations') {
                    window.location.href = '{{ path('app_my_reservations') }}';
                } else if (action === 'my-orders') {
                    window.location.href = '{{ path('app_my_orders') }}';
                } else if (action === 'offers-grid') {
                    window.location.href = '{{ path('app_offers_grid') }}';
                }else if (action === 'dashboardMessenger') {
                    window.location.href = '{{ path('app_dashboard') }}';
                }
            });

            window.addEventListener('pageshow', function () {
                $('.side-menu').removeClass('open');
                $('.menu-overlay').removeClass('show');
                isMenuOpen = false;
            });
        });
        
        function showChatPopup() {
            // This global function is replaced in document.ready with modal opening logic.
        }
    </script>
{% endblock %}

{% block body %}
    {% set membershipTier = profile.member_premium|default('standard')|lower|trim %}
    {% set hasPremiumCrown = membershipTier in ['premium', 'premuim', 'vip', 'vip+', 'vip plus', 'vip_plus'] %}

    <!-- Menu Overlay -->
    <div class="menu-overlay"></div>
    
    <!-- Side Menu -->
    <div class="side-menu">
        <div class="side-menu-content">
            <div class="user-info">
                {% if app.user %}
                    <div class="avatar">
                        {{ app.user.username|first|upper }}
                    </div>
                    <p class="user-name">{{ app.user.fullName|default(app.user.username) }}</p>
                    <p class="user-role">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                            {{ 'main.role.administrator'|trans }}
                        {% elseif 'ROLE_GUIDE' in app.user.roles %}
                            {{ 'main.role.guide'|trans }}
                        {% else %}
                            {{ 'main.role.member'|trans }}
                        {% endif %}
                    </p>
                {% endif %}
            </div>
            
            {% if is_granted('ROLE_ADMIN') %}
                <button class="side-menu-btn" data-action="dashboard">🏠 {{ 'main.menu.dashboard'|trans }}</button>
            {% endif %}
            
            {% if is_granted('ROLE_GUIDE') %}
                <button class="side-menu-btn" data-action="guide-dashboard">👤 {{ 'main.menu.guide_dashboard'|trans }}</button>
            {% endif %}

            <button class="side-menu-btn" data-action="face-id-enroll">🫥 Face ID Scan</button>
            <button class="side-menu-btn" data-action="my-reservations">👤 {{ 'main.menu.my_reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="my-orders">🧾 {{ 'main.menu.my_orders'|trans }}</button>
            <button class="side-menu-btn" data-action="reservations">💻 {{ 'main.menu.reservations'|trans }}</button>
            <button class="side-menu-btn" data-action="reservation-details">📋 {{ 'main.menu.reservation_details'|trans }}</button>
            
            {% if is_granted('ROLE_AGENCY') %}
                <button class="side-menu-btn" data-action="offers-grid">📋 {{ 'main.menu.offers_grid'|trans }}</button>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <button class="side-menu-btn" data-action="dashboardMessenger">📊 {{ 'main.menu.dashboard_messenger'|trans }}</button>
            {% endif %}
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="main-container theme-{{ visionTheme|default('default') }}{% if visionAccessibleMode|default(false) %} vision-support{% endif %}">
        <div class="depth-background" aria-hidden="true">
            <div class="depth-orb one"></div>
            <div class="depth-orb two"></div>
            <div class="depth-orb three"></div>
        </div>

        <div class="airport-background" aria-hidden="true">
            <div class="airport-skyglow airport-layer" style="--depth: 0.05;"></div>
            <div class="airport-map airport-layer" style="--depth: 0.08;"></div>
            <div class="airport-routes airport-layer" style="--depth: 0.12;"></div>
            <div class="airport-point point-newyork airport-layer" style="--depth: 0.16;"></div>
        </div>

        <div class="main-content-shell">
            <!-- Top Bar -->
            <div class="top-bar">
                <div style="display: flex; align-items: center;">
                    <button class="menu-toggle">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <div class="logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Rehletna.tn" title="Rehletna.tn" />
                    </div>
                </div>
                
                <div style="display: flex; align-items: center; gap: 12px;">
                    <a href="{{ path('app_settings') }}" class="profile-section" aria-label="Open profile settings" title="Settings" data-no-loader="true" data-turbo="false">
                        <div class="profile-info">
                            <p class="profile-name">{{ app.user.fullName|default(app.user.username) }}</p>
                            <p class="profile-role">
                                {% if 'ROLE_ADMIN' in app.user.roles %}
                                    {{ 'main.role.administrator'|trans }}
                                {% elseif 'ROLE_GUIDE' in app.user.roles %}
                                    {{ 'main.role.guide'|trans }}
                                {% else %}
                                    {{ 'main.role.member'|trans }}
                                {% endif %}
                            </p>
                        </div>
                        <div class="profile-avatar">
                            <img src="{{ profile.image_url|default(asset('images/default_image.png')) }}" alt="Profile" class="profile-img" />
                            {% if hasPremiumCrown %}
                                <div class="premium-crown-badge" title="Premium Member">👑</div>
                            {% endif %}
                            <div class="online-status"></div>
                        </div>
                    </a>
                </div>
            </div>
            
            <!-- Navigation Tabs -->
            <div class="nav-tabs">
                <button class="nav-tab active" data-view="services">💻 {{ 'main.tab.services'|trans }}</button>
                                <a class="nav-tab" href="{{ path('app_activities') }}">🏞 {{ 'main.tab.activities'|trans }}</a>
                <button class="nav-tab" data-view="shop">🛒 {{ 'main.tab.shop'|trans }}</button>
<button class="nav-tab" type="button" onclick="window.location.href='{{ path('app_offer_index') }}'">
    🔖 {{ 'main.tab.offers'|trans }}
</button>                <button class="nav-tab" data-view="messenger">💬 {{ 'main.tab.messenger'|trans }}</button>
                <button class="nav-tab" data-view="post">✉️ Posts</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-tab" href="{{ path('app_admin_stats') }}">📊 {{ 'main.tab.stats'|trans }}</a>
                {% endif %}
            </div>

            <!-- Content Area -->
            <div class="content-area">
                {% if birthdayGift and birthdayGift.showBanner %}
                    <section class="birthday-gift-banner" aria-label="Birthday gift">
                        <div class="birthday-gift-icon" aria-hidden="true">🎁</div>
                        <div class="birthday-gift-content">
                            <p class="birthday-gift-kicker">Happy Birthday {{ app.user.name|default(app.user.username) }}</p>
                            <h2 class="birthday-gift-title">You have a birthday gift waiting for you</h2>
                            <p class="birthday-gift-text">Collect 7 coins for your birthday and enjoy the day. This gift is available now.</p>
                        </div>
                        <div class="birthday-gift-action">
                            {% if birthdayGift.canCollect %}
                                        <form method="post" action="{{ path('app_collect_birthday_gift') }}" class="birthday-gift-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('birthday-gift-collect') }}">
                                    <button type="submit" class="birthday-gift-btn">Collect this gift</button>
                                </form>
                            {% else %}
                                <button type="button" class="birthday-gift-btn is-collected" disabled>Collected</button>
                            {% endif %}
                        </div>
                    </section>
                {% endif %}

            </div>
        </div>
    </div>
    
    <!-- Chat Button -->
    <button class="chat-button" onclick="showChatPopup()">
        <span>💬</span>
        <span class="chat-badge" style="display: none;">0</span>
    </button>

    <div id="chatModal" class="chat-modal" aria-live="polite" aria-label="{{ 'main.chat.popup'|trans }}">
        <div class="chat-modal-header">
            <div style="flex: 1; min-width: 0;">
                <p class="chat-modal-title">{{ 'main.chat.title'|trans }}</p>
                <div id="chatAdminConversationRow" class="chat-admin-row" style="display: none;">
                    <select id="chatAdminConversationSelect" class="chat-admin-select" aria-label="Select user conversation">
                        <option value="">No user conversations</option>
                    </select>
                </div>
                <div id="chatUserCallPicker" class="chat-user-call-picker" style="display:none;">
                    <select id="chatUserCallAdminSelect" aria-label="Choose admin to call">
                        <option value="">Choose admin</option>
                    </select>
                    <button id="chatUserCallStartBtn" type="button" class="chat-user-call-btn start">Call</button>
                    <button id="chatUserCallCancelBtn" type="button" class="chat-user-call-btn cancel">Cancel</button>
                </div>
            </div>
            <div class="chat-modal-actions">
                <button id="chatCallBtn" class="chat-modal-call" type="button" title="Call Admin/User" aria-label="Call Admin/User">📞</button>
                <button id="chatCloseBtn" class="chat-modal-close" type="button" aria-label="{{ 'main.chat.close'|trans }}">×</button>
            </div>
        </div>
        <div id="chatMessages" class="chat-modal-messages">
            <div class="chat-empty">{{ 'main.chat.loading'|trans }}</div>
        </div>
        <div class="chat-modal-input">
            <button id="chatAttachBtn" class="chat-attach-btn" type="button" title="{{ 'main.chat.attach'|trans }}">+</button>
            <input id="chatInput" class="chat-input" type="text" maxlength="1000" placeholder="{{ 'main.chat.placeholder'|trans }}" />
            <input id="chatAttachmentInput" type="file" accept="image/*,.pdf,application/pdf" style="display:none;" />
            <button id="chatSendBtn" class="chat-send-btn" type="button">{{ 'main.chat.send'|trans }}</button>
        </div>
        <div id="chatSelectedFile" class="chat-selected-file" style="display:none;">
            <span id="chatSelectedFileName" class="chat-selected-file-name"></span>
            <button id="chatSelectedFileClear" class="chat-selected-file-clear" type="button" title="Clear attachment">×</button>
        </div>
        <div id="chatStatus" class="chat-status"></div>
    </div>
    
    <!-- Profile Popup -->
    <div class="profile-popup">
        <strong class="popup-username">{{ app.user.fullName|default(app.user.username) }}</strong>
        <div class="popup-stats">
            <div class="popup-row">
                <span class="popup-label">{{ 'main.popup.membership'|trans }}</span>
                <span class="popup-value">{{ profile.member_premium|default('Standard') }}</span>
            </div>
            <div class="popup-row">
                <span class="popup-label">{{ 'main.popup.coins'|trans }}</span>
                <span class="popup-value" data-profile-coins-value>{{ profile.coins|default(0) }}</span>
            </div>
            <div class="popup-row">
                <span class="popup-label">{{ 'main.popup.rate'|trans }}</span>
                <span class="popup-value">
                    {% set membership = profile.member_premium|default('Standard') %}
                    {% if membership in ['Administrator', 'VIP', 'VIP+'] %}
                        {{ 'main.popup.rate_vip'|trans }}
                    {% elseif membership == 'Premium' %}
                        {{ 'main.popup.rate_premium'|trans }}
                    {% else %}
                        {{ 'main.popup.rate_standard'|trans }}
                    {% endif %}
                </span>
            </div>
        </div>
    </div>
{% endblock %}