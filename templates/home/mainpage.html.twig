{# templates/home/mainpage.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Main Page - Rehletna.tn{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap');

        .main-container {
            display: flex;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background: var(--vision-main-background, radial-gradient(1400px 500px at 10% -20%, rgba(10, 160, 159, 0.22), transparent 60%), radial-gradient(1000px 500px at 100% 0%, rgba(252, 186, 48, 0.20), transparent 55%), linear-gradient(180deg, #f4f9ff 0%, #eff6fb 100%));
            font-family: 'Sora', 'Segoe UI', sans-serif;
        }

        .main-content-shell {
            flex: 1;
            position: relative;
            z-index: 2;
        }

        .airport-background {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            opacity: 0.9;
            --parallax-x: 0px;
            --parallax-y: 0px;
            --airport-map-route: rgba(36, 146, 198, 0.5);
            --airport-map-point: #1d8fbb;
            --airport-map-point-ring: rgba(29, 143, 187, 0.2);
            --airport-map-label: #10395a;
        }

        .depth-background {
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .depth-orb {
            position: absolute;
            border-radius: 50%;
            opacity: 0.42;
            animation: depthFloat 16s ease-in-out infinite alternate;
        }

        .depth-orb.one {
            width: 420px;
            height: 420px;
            left: -140px;
            top: 210px;
            background: radial-gradient(circle at 35% 35%, rgba(85, 206, 255, 0.54), rgba(85, 206, 255, 0.06) 68%, transparent 100%);
        }

        .depth-orb.two {
            width: 500px;
            height: 500px;
            right: -160px;
            top: 130px;
            background: radial-gradient(circle at 50% 45%, rgba(134, 219, 255, 0.4), rgba(134, 219, 255, 0.07) 68%, transparent 100%);
            animation-delay: 2.8s;
        }

        .depth-orb.three {
            width: 360px;
            height: 360px;
            right: 16%;
            bottom: -110px;
            background: radial-gradient(circle at 45% 45%, rgba(255, 194, 111, 0.34), rgba(255, 194, 111, 0.05) 68%, transparent 100%);
            animation-delay: 1.2s;
        }


        .airport-layer {
            will-change: transform;
            transition: transform 0.18s ease-out;
            transform: translate3d(
                calc(var(--parallax-x) * var(--depth, 0)),
                calc(var(--parallax-y) * var(--depth, 0)),
                0
            );
        }

        .airport-skyglow {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(860px 320px at 88% 8%, rgba(106, 204, 255, 0.34), transparent 70%),
                radial-gradient(940px 380px at 12% 12%, rgba(110, 228, 255, 0.2), transparent 74%),
                linear-gradient(180deg, rgba(17, 41, 77, 0.06), rgba(10, 33, 66, 0.34));
            animation: skyPulse 9s ease-in-out infinite alternate;
        }

        .airport-clouds {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(130px 34px at 14% 15%, rgba(231, 248, 255, 0.48), rgba(231, 248, 255, 0) 72%),
                radial-gradient(170px 40px at 32% 10%, rgba(231, 248, 255, 0.37), rgba(231, 248, 255, 0) 72%),
                radial-gradient(142px 38px at 57% 18%, rgba(231, 248, 255, 0.45), rgba(231, 248, 255, 0) 72%),
                radial-gradient(190px 42px at 80% 12%, rgba(231, 248, 255, 0.4), rgba(231, 248, 255, 0) 72%);
            opacity: 0.72;
            animation: cloudDrift 60s linear infinite;
        }

        .airport-map {
            position: absolute;
            inset: 0;
            border-radius: 0;
            background: rgba(76, 151, 201, 0.22);
            box-shadow: inset 0 0 0 1px rgba(30, 93, 136, 0.26), 0 10px 24px rgba(8, 54, 90, 0.08);
            overflow: hidden;
        }

        .airport-map.has-real-map::before {
            display: none;
        }

        .airport-map.has-real-map::after {
            opacity: 0.06;
        }

        .airport-map-svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .airport-map-sphere {
            fill: #3f90cd;
        }

        .airport-map-graticule {
            fill: none;
            stroke: #1f5f8e;
            stroke-width: 0.9;
            opacity: 0.65;
        }

        .airport-map-country {
            fill: #f3f5f6;
        }

        .airport-map-borders {
            fill: none;
            stroke: #cdd4d8;
            stroke-width: 0.55;
            opacity: 0.9;
        }

        .airport-map-radar-layer {
            pointer-events: none;
        }

        .airport-flight-marker {
            transition: transform 20s linear, opacity 0.18s ease;
        }

        .airport-flight-marker circle {
            fill: #39ff14;
            stroke: rgba(0, 0, 0, 0.95);
            stroke-width: 1.2;
            filter: drop-shadow(0 0 6px rgba(57, 255, 20, 0.75));
        }

        .flight-trail {
            fill: none;
            stroke: rgba(57, 255, 20, 0.78);
            stroke-width: 1.2;
            opacity: 0.72;
            stroke-linecap: round;
            stroke-linejoin: round;
            filter: drop-shadow(0 0 6px rgba(57, 255, 20, 0.2));
        }

        .flight-plane-path {
            fill: rgba(57, 255, 20, 0.98);
            stroke: rgba(0, 0, 0, 0.96);
            stroke-width: 1.1;
            filter: drop-shadow(0 0 5px rgba(57, 255, 20, 0.45));
        }

        .airport-flight-marker text {
            fill: #39ff14;
            font-weight: 800;
            font-size: 11px;
            opacity: 0.98;
            paint-order: stroke;
            stroke: rgba(0, 0, 0, 0.95);
            stroke-width: 3px;
            stroke-linejoin: round;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        .airport-map::before,
        .airport-map::after {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .airport-map::before {
            background: url('{{ asset('images/world-map-2d.svg') }}') center/cover no-repeat;
            opacity: 0.96;
            filter: none;
        }

        .airport-map::after {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
            opacity: 1;
        }

        .airport-routes {
            position: absolute;
            inset: 0;
            border-radius: 0;
            background:
                radial-gradient(128% 160% at 20% 118%, transparent 0 58.24%, var(--airport-map-route) 58.3% 58.55%, transparent 58.65%),
                radial-gradient(146% 155% at 64% 112%, transparent 0 61.26%, var(--airport-map-route) 61.32% 61.58%, transparent 61.68%),
                radial-gradient(130% 164% at 92% 106%, transparent 0 54.2%, var(--airport-map-route) 54.26% 54.54%, transparent 54.64%);
            opacity: 0.26;
        }

        .airport-point {
            position: absolute;
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: var(--airport-map-point);
            box-shadow: 0 0 0 5px var(--airport-map-point-ring), 0 2px 7px rgba(10, 69, 98, 0.25);
            animation: airportPointPulse 3.4s ease-in-out infinite;
        }

        .airport-point::after {
            content: '';
            position: absolute;
            width: 7px;
            height: 7px;
            right: -7px;
            top: -6px;
            border-top: 1.5px solid var(--airport-map-point);
            border-right: 1.5px solid var(--airport-map-point);
            border-radius: 1px;
            transform: rotate(35deg);
            opacity: 0.9;
        }

        .airport-point-label {
            display: none;
        }

        .airport-point.point-tunis {
            left: 52%;
            top: 47%;
            animation-delay: -0.2s;
        }

        .airport-point.point-paris {
            left: 48%;
            top: 34%;
            animation-delay: -0.9s;
        }

        .airport-point.point-dubai {
            left: 59%;
            top: 48%;
            animation-delay: -1.5s;
        }

        .airport-point.point-istanbul {
            left: 54%;
            top: 39%;
            animation-delay: -2.1s;
        }

        .airport-terminal {
            display: none;
        }

        .airport-apron {
            display: none;
        }

        .airport-control-tower {
            display: none;
        }

        .airport-control-tower::after {
            content: none;
        }

        .airport-control-tower::before {
            content: none;
        }

        .airport-runway {
            display: none;
        }

        .airport-runway-lights {
            display: none;
        }

        .airport-plane {
            position: absolute;
            width: 260px;
            height: 6px;
            left: -28%;
            top: 24%;
            border-radius: 999px;
            background: linear-gradient(90deg, rgba(145, 227, 255, 0) 0%, rgba(145, 227, 255, 0.4) 46%, rgba(224, 247, 255, 0.92) 82%, rgba(255, 255, 255, 0.98) 100%);
            filter: drop-shadow(0 0 10px rgba(123, 217, 255, 0.64));
        }

        .airport-plane::before {
            content: '';
            position: absolute;
            right: 18px;
            top: -8px;
            width: 36px;
            height: 18px;
            border-top: 2px solid rgba(214, 244, 255, 0.9);
            border-bottom: 2px solid rgba(214, 244, 255, 0.9);
            border-radius: 12px;
            opacity: 0.95;
        }

        .airport-plane::after {
            content: '';
            position: absolute;
            right: -12px;
            top: -7px;
            border-left: 14px solid rgba(247, 252, 255, 0.95);
            border-top: 10px solid transparent;
            border-bottom: 10px solid transparent;
        }

        .airport-plane.plane-one {
            width: 210px;
            height: 72px;
            background: none;
            border-radius: 0;
            filter: drop-shadow(0 0 12px rgba(123, 217, 255, 0.42));
            animation: flyAcross 16s linear infinite;
        }

        .airport-plane.plane-one::before,
        .airport-plane.plane-one::after {
            content: none;
        }

        .airport-plane-svg {
            display: block;
            width: 100%;
            height: 100%;
            overflow: visible;
            filter: drop-shadow(0 0 8px rgba(167, 232, 255, 0.45));
        }

        .airport-plane-svg .plane-body {
            fill: rgba(237, 248, 255, 0.94);
        }

        .airport-plane-svg .plane-wing {
            fill: rgba(201, 232, 248, 0.88);
        }

        .airport-plane-svg .plane-window {
            fill: rgba(132, 196, 224, 0.72);
        }

        .airport-plane-svg .plane-light {
            fill: #ff4d57;
            filter: drop-shadow(0 0 4px rgba(255, 77, 87, 0.8));
            animation: wingLightBlink 1.1s steps(2) infinite;
        }

        .airport-plane.plane-two {
            top: 42%;
            width: 170px;
            opacity: 0.52;
            transform: scaleX(-1);
            animation: flyAcrossReverse 19s linear infinite;
            animation-delay: 5s;
        }

        .airport-plane.plane-three {
            top: 14%;
            width: 130px;
            opacity: 0.36;
            animation: flyAcross 26s linear infinite;
            animation-delay: 10s;
        }

        .airport-beacon {
            display: none;
        }

        @keyframes flyAcross {
            0% {
                transform: translateX(0) translateY(0);
                opacity: 0;
            }
            10% {
                opacity: 0.95;
            }
            75% {
                opacity: 0.94;
            }
            100% {
                transform: translateX(136vw) translateY(-62px);
                opacity: 0;
            }
        }

        @keyframes flyAcrossReverse {
            0% {
                transform: translateX(112vw) translateY(0) scaleX(-1);
                opacity: 0;
            }
            10% {
                opacity: 0.58;
            }
            75% {
                opacity: 0.54;
            }
            100% {
                transform: translateX(-44vw) translateY(-40px) scaleX(-1);
                opacity: 0;
            }
        }

        @keyframes runwayBlink {
            0%, 100% {
                opacity: 0.4;
            }
            50% {
                opacity: 1;
            }
        }

        @keyframes skyPulse {
            0% {
                transform: translateY(0);
            }
            100% {
                transform: translateY(-8px);
            }
        }

        @keyframes cloudDrift {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(5%);
            }
        }

        @keyframes wingLightBlink {
            0%, 42%, 100% {
                opacity: 0.2;
            }
            45%, 52% {
                opacity: 1;
            }
            70% {
                opacity: 0.25;
            }
        }

        @keyframes beaconPulse {
            0% { opacity: 0; }
            100% { opacity: 0; }
        }

        @keyframes airportPointPulse {
            0%,
            100% {
                transform: scale(1);
                box-shadow: 0 0 0 5px var(--airport-map-point-ring), 0 2px 7px rgba(10, 69, 98, 0.25);
            }
            50% {
                transform: scale(1.08);
                box-shadow: 0 0 0 8px transparent, 0 2px 7px rgba(10, 69, 98, 0.25);
            }
        }

        @keyframes depthFloat {
            0% {
                transform: translate3d(0, 0, 0) scale(1);
            }
            100% {
                transform: translate3d(0, -22px, 0) scale(1.06);
            }
        }


        .main-container.vision-support {
            background: var(--vision-support-background, radial-gradient(1400px 500px at 10% -20%, rgba(37, 130, 150, 0.28), transparent 60%), radial-gradient(1000px 500px at 100% 0%, rgba(226, 169, 52, 0.2), transparent 55%), linear-gradient(180deg, #edf7fb 0%, #e6f2f8 100%));
        }


        .main-container.vision-support .top-bar {
            background: var(--vision-top-bar-background, rgba(240, 251, 255, 0.95));
        }

        .main-container.vision-support .nav-tab.active {
            background: var(--vision-nav-active-background, linear-gradient(135deg, #0b8e8b, #1a6ea0));
            color: var(--vision-nav-active-color, #f1fcff);
        }

        .main-container.vision-support .profile-section {
            border-color: var(--vision-profile-hover-border, rgba(31, 136, 171, 0.35));
        }

        .side-menu {
            position: fixed;
            left: -300px;
            top: 0;
            width: 300px;
            height: 100vh;
            background: var(--vision-side-menu-background, linear-gradient(180deg, #ffffff 0%, #f3f9ff 100%));
            box-shadow: 10px 0 32px rgba(3, 39, 75, 0.15);
            transition: left 0.3s ease;
            z-index: 1000;
            overflow-y: auto;
            border-right: none;
        }

        .side-menu.open {
            left: 0;
        }

        .side-menu-content {
            padding: 28px 22px;
        }

        .user-info {
            text-align: center;
            padding-bottom: 18px;
            border-bottom: none;
            margin-bottom: 18px;
        }

        .avatar {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            margin: 0 auto 10px;
            background: linear-gradient(145deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            box-shadow: 0 10px 24px rgba(7, 57, 107, 0.25);
        }

        .avatar-img {
            width: 74px;
            height: 74px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-name {
            font-size: 15px;
            font-weight: 700;
            color: #11406f;
            margin: 0;
        }

        .user-role {
            font-size: 12px;
            color: #d29a16;
            font-weight: 700;
            margin: 2px 0 0;
            text-transform: capitalize;
        }

        .side-menu-btn {
            width: 100%;
            text-align: left;
            padding: 12px 18px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 14px;
            color: #33506f;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .side-menu-btn:hover {
            background: var(--vision-hover-background, rgba(10, 160, 159, 0.10));
            border-color: var(--vision-hover-border, rgba(10, 160, 159, 0.22));
            color: var(--vision-hover-color, #0b8e8b);
        }

        .logout-btn {
            margin-top: 18px;
            background: #fff2f2;
            color: #d94a5a;
            font-weight: 700;
            border-color: #ffd9de;
        }

        .logout-btn:hover {
            background: #ffe9ec;
            border-color: #ffccd4;
            color: #c03b4d;
        }

        .menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(3, 30, 58, 0.40);
            z-index: 999;
        }

        .menu-overlay.show {
            display: block;
        }

        .top-bar {
            background: var(--vision-top-bar-background, rgba(255, 255, 255, 0.90));
            padding: 16px 28px;
            box-shadow: 0 8px 24px rgba(10, 46, 88, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: none;
        }

        .logo {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            height: 40px;
            width: auto;
            display: flex;
            align-items: center;
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        .logo .reh {
            color: #0FA5A2;
        }

        .logo .let {
            color: #FEC74C;
        }

        .logo .na {
            color: #1D4D7C;
        }

        .menu-toggle {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            margin-right: 12px;
            border-radius: 10px;
            transition: background 0.2s ease;
        }

        .menu-toggle:hover {
            background: var(--vision-hover-background, rgba(10, 160, 159, 0.10));
        }

        .menu-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--vision-accent-strong, #1D4D7C);
            margin: 5px 0;
            transition: 0.3s;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 6px 8px 6px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(80, 149, 198, 0.16);
            transition: all 0.25s ease;
            position: relative;
        }

        .profile-section:hover {
            transform: translateY(-1px);
            border-color: var(--vision-profile-hover-border, rgba(86, 218, 255, 0.92));
            background: var(--vision-profile-hover-background, linear-gradient(135deg, rgba(219, 247, 255, 0.98), rgba(192, 238, 255, 0.94)));
            box-shadow: var(--vision-profile-hover-shadow, 0 0 0 1px rgba(129, 230, 255, 0.72), 0 0 16px rgba(65, 203, 255, 0.46), 0 10px 24px rgba(10, 98, 141, 0.24));
        }

        .profile-section::after {
            content: 'Settings';
            position: absolute;
            right: 14px;
            bottom: -18px;
            padding: 3px 8px;
            border-radius: 999px;
            background: rgba(29, 77, 124, 0.96);
            color: #ffffff;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.2px;
            opacity: 0;
            transform: translateY(-2px);
            transition: opacity 0.18s ease, transform 0.18s ease;
            pointer-events: none;
            box-shadow: 0 6px 14px rgba(7, 57, 107, 0.24);
            white-space: nowrap;
        }

        .profile-section:hover::after {
            opacity: 1;
            transform: translateY(0);
        }

        .profile-info {
            text-align: right;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 700;
            color: #1D4D7C;
            margin: 0;
        }

        .profile-role {
            font-size: 11px;
            color: #d19a1a;
            font-weight: 700;
            margin: 0;
            text-transform: capitalize;
        }

        .profile-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0FA5A2, #1D4D7C);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            position: relative;
            box-shadow: 0 8px 20px rgba(7, 57, 107, 0.20);
        }

        .profile-avatar img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.7);
        }

        .premium-crown-badge {
            position: absolute;
            top: -8px;
            right: -6px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            background: linear-gradient(135deg, #ffd66e, #f3b019);
            border: 2px solid #ffffff;
            box-shadow: 0 6px 14px rgba(90, 63, 0, 0.28);
            z-index: 3;
        }

        .online-status {
            position: absolute;
            bottom: 1px;
            right: 1px;
            width: 12px;
            height: 12px;
            background: #2ecc71;
            border-radius: 50%;
            border: 2px solid white;
        }

        /* Theme Toggle Button */
        .theme-toggle {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(10, 160, 159, 0.2);
            border-radius: 999px;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 20px;
            margin: 0 12px;
        }

        .theme-toggle:hover {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(10, 160, 159, 0.4);
            box-shadow: 0 6px 16px rgba(10, 160, 159, 0.15);
            transform: translateY(-2px);
        }

        .theme-toggle:active {
            transform: translateY(0);
        }

        /* Dark Mode Styles */
        body.dark-mode {
            background: #1a1a2e !important;
        }

        body.dark-mode .main-container {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%) !important;
        }

        body.dark-mode .airport-background {
            opacity: 0.72;
            --airport-map-route: rgba(124, 214, 255, 0.62);
            --airport-map-point: #8bdfff;
            --airport-map-point-ring: rgba(139, 223, 255, 0.22);
            --airport-map-label: #dff4ff;
        }

        body.dark-mode .airport-map {
            background: rgba(0, 0, 0, 0.55);
