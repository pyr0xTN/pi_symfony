{# templates/partials/_sidebar.html.twig #}
<aside class="sidebar">
    <div class="sidebar-logo">
        <img src="{{ asset('images/logo.png') }}" alt="Rehletna Logo" />
    </div>

    <hr class="sidebar-divider" />

    <nav class="sidebar-nav">
        <a href="{{ path('dashboard') }}"
           class="nav-btn {% if active_page == 'dashboard' %}active{% endif %}">
            📉 Dashboard
        </a>
        <a href="{{ path('services_index')}}"
           class="nav-btn {% if active_page == 'services' %}active{% endif %}">
            👨🏻‍💻 Services
        </a>
        <a href="{{ path('reservations_index') }}"
           class="nav-btn {% if active_page == 'reservations' %}active{% endif %}">
            🎫 Réservations
        </a>
    </nav>

    <div class="sidebar-footer">
        <span class="version-text">Rehletna Admin v1.0</span>
    </div>
</aside>
