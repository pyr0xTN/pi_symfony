{% extends 'base.html.twig' %}

{% block title %}Agency Dashboard{% endblock %}

{% block body %}
<div class="agency-root">
    {# ═══ LEFT SIDEBAR ═══ #}
    <aside class="agency-sidebar">
        <div class="agency-sidebar-user">
            <div class="agency-avatar">A</div>
            <span class="agency-sidebar-name">{{ agencyName }}</span>
            <span class="agency-sidebar-role">BACK OFFICE</span>
        </div>

        <nav class="agency-sidebar-nav">
            <a href="{{ path('agency_dashboard') }}" class="agency-nav-item active">Submissions</a>
            <a href="#" class="agency-nav-item">Statistics</a>
            <a href="#" class="agency-nav-item">Travelers</a>
            <a href="#" class="agency-nav-item">Settings</a>
        </nav>

        <div class="sidebar-spacer"></div>

        <div class="agency-sidebar-bottom">
            <button class="theme-toggle-btn" onclick="toggleTheme()">Dark Mode</button>
            <a href="{{ path('agency_logout') }}" class="agency-logout-btn">Logout</a>
        </div>
    </aside>

    {# ═══ MAIN CONTENT ═══ #}
    <main class="agency-main">
        {# ── Top bar ── #}
        <div class="agency-top-bar">
            <div>
                <h1 class="agency-page-title">Submissions</h1>
                <p class="agency-page-subtitle">Review and moderate traveler posts</p>
            </div>
            <a href="{{ path('agency_dashboard') }}" class="icon-btn">↻</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success">{{ message }}</div>
        {% endfor %}

        {# ── Stat Cards ── #}
        <div class="stat-cards-row">
            <div class="stat-card stat-card-pending">
                <span class="stat-label">PENDING</span>
                <span class="stat-number">{{ pendingCount }}</span>
                <span class="stat-sub">Awaiting review</span>
            </div>
            <div class="stat-card stat-card-approved">
                <span class="stat-label">APPROVED</span>
                <span class="stat-number">{{ approvedCount }}</span>
                <span class="stat-sub">Live on platform</span>
            </div>
            <div class="stat-card stat-card-rejected">
                <span class="stat-label">REJECTED</span>
                <span class="stat-number">{{ rejectedCount }}</span>
                <span class="stat-sub">Did not pass review</span>
            </div>
        </div>

        {# ── Filter Bar ── #}
        <div class="agency-filter-bar">
            <span class="filter-bar-label">FILTER:</span>
            <a href="{{ path('agency_dashboard', {filter: 'all'}) }}" 
               class="filter-tab {{ filter == 'all' ? 'active' : '' }}">All</a>
            <a href="{{ path('agency_dashboard', {filter: 'pending'}) }}" 
               class="filter-tab {{ filter == 'pending' ? 'active' : '' }}">Pending</a>
            <a href="{{ path('agency_dashboard', {filter: 'approved'}) }}" 
               class="filter-tab {{ filter == 'approved' ? 'active' : '' }}">Approved</a>
            <a href="{{ path('agency_dashboard', {filter: 'rejected'}) }}" 
               class="filter-tab {{ filter == 'rejected' ? 'active' : '' }}">Rejected</a>
        </div>

        {# ── Submission Grid ── #}
        <div class="submission-grid">
            {% for post in posts %}
                <div class="submission-card submission-{{ post.status|lower }}">
                    <div class="submission-status-badge badge-{{ post.status|lower }}">
                        {{ post.status }}
                    </div>
                    
                    <div class="submission-header">
                        <div class="avatar avatar-sm">{{ post.client.username|first|upper|default('U') }}</div>
                        <div>
                            <span class="submission-author">{{ post.client.username|default('Anonymous') }}</span>
                            <span class="submission-date">{{ post.timeAgo }}</span>
                        </div>
                    </div>

                    <p class="submission-content">{{ post.content|slice(0, 120) }}{{ post.content|length > 120 ? '…' : '' }}</p>

                    {% if post.hasImage %}
                        <img src="{{ asset(post.imagePath) }}" alt="" class="submission-image" loading="lazy">
                    {% endif %}

                    {% if post.hasPlace %}
                        <span class="submission-place">{{ post.place }}</span>
                    {% endif %}

                    {# ── Moderation Actions ── #}
                    <div class="submission-actions">
                        {% if post.isPending %}
                            <form action="{{ path('agency_approve', {id: post.id}) }}" method="post" style="display:inline">
                                <button type="submit" class="btn-approve">Approve</button>
                            </form>
                            <form action="{{ path('agency_reject', {id: post.id}) }}" method="post" style="display:inline">
                                <button type="submit" class="btn-reject">Reject</button>
                            </form>
                        {% elseif post.isApproved %}
                            <form action="{{ path('agency_reject', {id: post.id}) }}" method="post" style="display:inline">
                                <button type="submit" class="btn-reject-sm">Revoke</button>
                            </form>
                        {% else %}
                            <form action="{{ path('agency_approve', {id: post.id}) }}" method="post" style="display:inline">
                                <button type="submit" class="btn-approve-sm">Re-approve</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>No submissions yet</h3>
                    <p>Posts tagged with your agency will appear here.</p>
                </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}
