{# templates/agency/vol/edit.html.twig #}
{% extends 'agency/base_agency.html.twig' %}

{% block agency_page_title %}Modifier Vol{% endblock %}

{% block agency_content %}
<div class="form-wrapper" style="padding: 0;">
    <div class="form-card" style="max-width: 100%; margin: 0; box-shadow: none; border: 1px solid #eee;">

        <h2 class="form-title" style="font-size: 20px; border-bottom-color: #fbbe30;">✈ Modifier : {{ vol.nom }}</h2>

        {{ form_start(form, { attr: { enctype: 'multipart/form-data', novalidate: 'novalidate', id: 'volForm' } }) }}

            <div class="form-grid form-grid-2col">

                {# Nom #}
                <div class="form-group">
                    <label class="form-label">Compagnie / Nom :</label>
                    {{ form_widget(form.nom, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.nom) }}
                </div>

                {# Numéro de Vol #}
                <div class="form-group">
                    <label class="form-label">Numéro de Vol :</label>
                    <div style="display: flex; gap: 8px;">
                        {{ form_widget(form.numeroVol, { attr: { class: 'form-input', style: 'flex: 1;' } }) }}
                        <button type="button" class="btn-submit" id="btnAutoFill" style="width: auto; padding: 0 15px; background: #fbbe30;">⚡ Auto</button>
                    </div>
                    {{ form_errors(form.numeroVol) }}
                </div>

                {# Description #}
                <div class="form-group form-group-full">
                    <label class="form-label">Description :</label>
                    {{ form_widget(form.description, { attr: { class: 'form-input', rows: 3 } }) }}
                    {{ form_errors(form.description) }}
                </div>

                {# Ville Depart #}
                <div class="form-group">
                    <label class="form-label">Ville de Départ :</label>
                    {{ form_widget(form.villeDepart, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.villeDepart) }}
                </div>

                {# Ville Arrivée #}
                <div class="form-group">
                    <label class="form-label">Ville d'Arrivée :</label>
                    {{ form_widget(form.villeArrivee, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.villeArrivee) }}
                </div>

                {# Date Depart #}
                <div class="form-group">
                    <label class="form-label">Date et Heure de Départ :</label>
                    {{ form_widget(form.dateDepart, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.dateDepart) }}
                </div>

                {# Prix #}
                <div class="form-group">
                    <label class="form-label">Prix (TND) :</label>
                    {{ form_widget(form.prix, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.prix) }}
                </div>

                {# Capacité #}
                <div class="form-group">
                    <label class="form-label">Capacité (Sièges) :</label>
                    {{ form_widget(form.capacite, { attr: { class: 'form-input' } }) }}
                    {{ form_errors(form.capacite) }}
                </div>

                {# Photo #}
                <div class="form-group form-group-full" style="padding-top: 10px;">
                    <label class="form-label">Changer le logo :</label>
                    <div class="file-upload-row">
                        {{ form_widget(form.photo, { attr: { class: 'form-input', accept: 'image/*', style: 'padding: 8px;' } }) }}
                        {% if vol.imgUrl %}
                            <div id="imgPreviewContainer" class="mt-3">
                                <img id="imgPreview" src="{{ asset(vol.imgUrl) }}" alt="Aperçu" class="img-preview" style="max-width: 200px; border-radius: 8px; border: 1px solid #ddd;" />
                            </div>
                        {% endif %}
                    </div>
                    {{ form_errors(form.photo) }}
                </div>     

            </div>

            <div class="form-actions" style="border-top: 1px solid #eee; margin-top: 30px; padding-top: 20px;">
                <button type="submit" class="btn-submit" style="width: auto; padding: 12px 30px; font-size: 15px; background-color: #183c75;">✔ Enregistrer les modifications</button>
                <a href="{{ path('agency_services_index') }}" class="btn-back" style="padding: 11px 25px;">← Annuler</a>
            </div>

        {{ form_end(form) }}

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Image Preview
        const photoInput = document.querySelector('input[type="file"]');
        const preview = document.getElementById('imgPreview');

        if (photoInput) {
            photoInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    preview.src = URL.createObjectURL(file);
                }
            });
        }

        // Autofill logic
        const btnAutoFill = document.getElementById('btnAutoFill');
        const flightNumInput = document.getElementById('{{ form.numeroVol.vars.id }}');

        if (btnAutoFill && flightNumInput) {
            btnAutoFill.addEventListener('click', async function() {
                const flightNum = flightNumInput.value.trim();
                if (!flightNum) {
                    alert('Veuillez saisir un numéro de vol.');
                    return;
                }

                btnAutoFill.innerText = '...';
                btnAutoFill.disabled = true;

                try {
                    const response = await fetch('{{ path("agency_vol_autofill") }}?numeroVol=' + encodeURIComponent(flightNum));
                    const data = await response.json();

                    if (data.error) {
                        alert(`Erreur: ${data.error}`);
                    } else {
                        document.getElementById('{{ form.villeDepart.vars.id }}').value = data.villeDepart || '';
                        document.getElementById('{{ form.villeArrivee.vars.id }}').value = data.villeArrivee || '';
                        if (data.dateDepart) {
                             document.getElementById('{{ form.dateDepart.vars.id }}').value = data.dateDepart.substring(0, 16);
                        }
                    }
                } catch (e) {
                    alert('Erreur de connexion au service autofill.');
                } finally {
                    btnAutoFill.innerText = '⚡ Auto';
                    btnAutoFill.disabled = false;
                }
            });
        }
    });
    </script>
{% endblock %}
