<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 13px; color: #333; background: #fff; }
        .header { background: #1f2b5b; color: white; padding: 30px; text-align: center; }
        .header h1 { font-size: 24px; letter-spacing: 2px; }
        .status-stripe { background: #0fa5a2; color: white; text-align: center; padding: 10px; font-weight: bold; text-transform: uppercase; }
        .content { padding: 40px; }
        .hero { background: #f8fafc; border-radius: 10px; padding: 20px; margin-bottom: 30px; border-left: 5px solid #0fa5a2; }
        .hero .type { font-size: 11px; color: #64748b; text-transform: uppercase; }
        .hero .name { font-size: 20px; font-weight: bold; margin: 5px 0; }
        .hero .price { font-size: 18px; color: #0fa5a2; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { text-align: left; font-size: 11px; color: #94a3b8; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; }
        td { padding: 15px 0; vertical-align: top; }
        .label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .value { font-size: 14px; font-weight: bold; color: #1e293b; margin-top: 4px; }
        .footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 20px; text-align: center; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; }
    </style>
</head>
<body>
    <div class="header">
        <h1>REHLETNA</h1>
        <div style="font-size: 12px; margin-top: 5px; opacity: 0.8;">Reservation Confirmation</div>
    </div>
    <div class="status-stripe">Confirmed</div>

    <div class="content">
        <div class="hero">
            <div class="type">{{ reservation.idService.type|capitalize }}</div>
            <div class="name">{{ reservation.idService.nom }}</div>
            <div class="price">{{ reservation.idService.prix }} TND</div>
        </div>

        <table>
            <thead>
                <tr>
                    <th width="50%">Customer Information</th>
                    <th width="50%">Service Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="label">Name</div>
                        <div class="value">{{ reservation.nom }}</div>
                        
                        <div style="margin-top: 15px;">
                            <div class="label">Reservation Date</div>
                            <div class="value">{{ reservation.dateReservation|date('d/m/Y') }}</div>
                        </div>

                        <div style="margin-top: 15px;">
                            <div class="label">Payment Method</div>
                            <div class="value">{{ reservation.modePaiement|capitalize }}</div>
                        </div>

                        {% if reservation.seatNb > 0 %}
                            <div style="margin-top: 15px;">
                                <div class="label">Seat Number</div>
                                <div class="value" style="color: #0fa5a2; font-size: 18px;">#{{ reservation.seatNb }}</div>
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        {% if reservation.idService.type == 'hotel' %}
                            <div class="label">Location</div>
                            <div class="value">{{ reservation.idService.localisation }}</div>

                            <div style="margin-top: 15px;">
                                <div class="label">Rating</div>
                                <div class="value">
                                    {% for i in 1..reservation.idService.nombreEtoiles %}⭐{% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="label">Route</div>
                            <div class="value">{{ reservation.idService.villeDepart }} → {{ reservation.idService.villeArrivee }}</div>

                            <div style="margin-top: 15px;">
                                <div class="label">Flight Number</div>
                                <div class="value">{{ reservation.idService.numeroVol }}</div>
                            </div>

                            <div style="margin-top: 15px;">
                                <div class="label">Departure Date</div>
                                <div class="value">{{ reservation.idService.dateDepart|date('d/m/Y') }}</div>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 50px; text-align: center; color: #cbd5e1; font-size: 11px;">
            Document generated on {{ "now"|date('d/m/Y H:i') }}
        </div>
    </div>

    <div class="footer">
        Thank you for choosing Rehletna • Professional Travel Solutions
    </div>
</body>
</html>
