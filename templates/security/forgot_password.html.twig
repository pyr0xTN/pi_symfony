{% extends 'base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --reh-teal: #0AA09F;
            --reh-gold: #FCBA30;
            --reh-blue: #07396B;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 20% 20%, rgba(12, 174, 171, 0.22), transparent 35%),
                radial-gradient(circle at 80% 30%, rgba(252, 186, 48, 0.20), transparent 30%),
                linear-gradient(135deg, #072945 0%, #0b3f64 45%, #0a2f57 100%);
        }

        .bg-slideshow {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-slide {
            position: absolute;
            inset: 0;
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            filter: brightness(0.8) saturate(1.08) contrast(1.05);
            opacity: 0;
            transform: scale(1);
            transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 2s ease;
            will-change: opacity, transform;
        }

        .bg-slide.active {
            opacity: 1;
            transform: scale(1.08);
        }

        .bg-overlay-layer {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(5, 25, 45, 0.48) 0%, rgba(10, 35, 60, 0.56) 100%);
            backdrop-filter: blur(0.5px);
        }

        .reset-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            z-index: 2;
        }

        .reset-card {
            width: 100%;
            max-width: 440px;
            border-radius: 24px;
            border: 2px solid rgba(11, 164, 161, 0.28);
            background: linear-gradient(135deg, rgba(248, 251, 255, 0.88) 0%, rgba(240, 247, 252, 0.84) 100%);
            box-shadow: 0 26px 60px rgba(0, 57, 114, 0.28), 0 12px 28px rgba(11, 164, 161, 0.18);
            backdrop-filter: blur(16px) saturate(130%);
            padding: 34px;
        }

        .reset-step {
            display: inline-block;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--reh-blue);
            background: rgba(252, 186, 48, 0.22);
            border: 1px solid rgba(252, 186, 48, 0.4);
            border-radius: 999px;
            padding: 6px 12px;
            margin-bottom: 12px;
        }

        .reset-title {
            color: #0a2f57;
            font-size: 1.7rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .reset-help {
            color: #35516d;
            margin-bottom: 22px;
        }

        .form-label {
            color: #244766;
            font-weight: 600;
        }

        .input-shell {
            position: relative;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(238, 248, 255, 0.95));
            border: 2px solid rgba(11, 164, 161, 0.22);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .input-shell:focus-within {
            border-color: rgba(10, 160, 159, 0.78);
            box-shadow: 0 0 0 4px rgba(10, 160, 159, 0.15), 0 12px 24px rgba(7, 57, 107, 0.12);
            transform: translateY(-1px);
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.95rem;
            color: #3b678a;
            pointer-events: none;
        }

        .form-control {
            border: 0;
            background: transparent;
            border-radius: 14px;
            padding: 13px 14px 13px 40px;
            font-weight: 600;
            color: #123f62;
        }

        .form-control:focus {
            border: 0;
            background: transparent;
            box-shadow: none;
        }

        .form-control::placeholder {
            color: #6f8ca6;
            font-weight: 500;
        }

        .btn-reset {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 12px 16px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--reh-teal) 0%, var(--reh-blue) 100%);
            box-shadow: 0 10px 24px rgba(0, 57, 114, 0.26);
        }

        .btn-reset:hover {
            filter: brightness(1.05);
            color: #fff;
        }

        .reset-footer {
            margin-top: 16px;
            text-align: center;
            color: #35516d;
        }

        .reset-footer a {
            color: #0a2f57;
            font-weight: 700;
            text-decoration: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="bg-slideshow" aria-hidden="true">
    <div id="bgSlideA" class="bg-slide active"></div>
    <div id="bgSlideB" class="bg-slide"></div>
    <div class="bg-overlay-layer"></div>
</div>

<div class="reset-shell">
    <div class="reset-card">
        <span class="reset-step">Step 1 of 3</span>
        <h1 class="reset-title">Forgot Password</h1>
        <p class="reset-help">Enter your email address. We will send you a verification code by email.</p>

        <form method="post" action="{{ path('app_forgot_password') }}">
            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <div class="input-shell">
                    <span class="input-icon">@</span>
                    <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password_request') }}">
            <button type="submit" class="btn btn-reset">Send verification code</button>
        </form>

        <p class="reset-footer">
            Remembered your password?
            <a href="{{ path('app_login') }}">Back to login</a>
        </p>
    </div>
</div>

<script>
    (function () {
        const bgSlideA = document.getElementById('bgSlideA');
        const bgSlideB = document.getElementById('bgSlideB');
        const backgroundImages = [
            'https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1467269204594-9661b134dd2b?auto=format&fit=crop&w=1920&q=80'
        ];

        if (!bgSlideA || !bgSlideB || backgroundImages.length === 0) {
            return;
        }

        let currentIndex = 0;
        let showingA = true;

        bgSlideA.style.backgroundImage = `url('${backgroundImages[currentIndex]}')`;
        bgSlideA.classList.add('active');
        bgSlideB.classList.remove('active');

        setInterval(() => {
            const nextIndex = (currentIndex + 1) % backgroundImages.length;
            const incomingSlide = showingA ? bgSlideB : bgSlideA;
            const outgoingSlide = showingA ? bgSlideA : bgSlideB;

            incomingSlide.style.backgroundImage = `url('${backgroundImages[nextIndex]}')`;
            incomingSlide.classList.add('active');
            outgoingSlide.classList.remove('active');

            currentIndex = nextIndex;
            showingA = !showingA;
        }, 5000);
    })();
</script>
{% endblock %}
