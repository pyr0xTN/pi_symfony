{% extends 'base.html.twig' %}

{% block title %}Verify Reset Code{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --reh-teal: #0AA09F;
            --reh-gold: #FCBA30;
            --reh-blue: #07396B;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 20% 20%, rgba(12, 174, 171, 0.22), transparent 35%),
                radial-gradient(circle at 80% 30%, rgba(252, 186, 48, 0.20), transparent 30%),
                linear-gradient(135deg, #072945 0%, #0b3f64 45%, #0a2f57 100%);
        }

        .bg-slideshow {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-slide {
            position: absolute;
            inset: 0;
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            filter: brightness(0.8) saturate(1.08) contrast(1.05);
            opacity: 0;
            transform: scale(1);
            transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 2s ease;
            will-change: opacity, transform;
        }

        .bg-slide.active {
            opacity: 1;
            transform: scale(1.08);
        }

        .bg-overlay-layer {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(5, 25, 45, 0.48) 0%, rgba(10, 35, 60, 0.56) 100%);
            backdrop-filter: blur(0.5px);
        }

        .reset-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            z-index: 2;
        }

        .reset-card {
            width: 100%;
            max-width: 440px;
            border-radius: 24px;
            border: 2px solid rgba(11, 164, 161, 0.28);
            background: linear-gradient(135deg, rgba(248, 251, 255, 0.88) 0%, rgba(240, 247, 252, 0.84) 100%);
            box-shadow: 0 26px 60px rgba(0, 57, 114, 0.28), 0 12px 28px rgba(11, 164, 161, 0.18);
            backdrop-filter: blur(16px) saturate(130%);
            padding: 34px;
        }

        .reset-step {
            display: inline-block;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--reh-blue);
            background: rgba(252, 186, 48, 0.22);
            border: 1px solid rgba(252, 186, 48, 0.4);
            border-radius: 999px;
            padding: 6px 12px;
            margin-bottom: 12px;
        }

        .reset-title {
            color: #0a2f57;
            font-size: 1.7rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .reset-help {
            color: #35516d;
            margin-bottom: 6px;
        }

        .reset-expire {
            color: #6a7f94;
            font-size: 0.92rem;
            margin-bottom: 22px;
        }

        .form-label {
            color: #244766;
            font-weight: 600;
        }

        .otp-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            margin-bottom: 6px;
        }

        .otp-box {
            width: 100%;
            height: 52px;
            border-radius: 12px;
            border: 2px solid rgba(11, 164, 161, 0.25);
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.97), rgba(238, 248, 255, 0.95));
            text-align: center;
            font-size: 1.2rem;
            font-weight: 700;
            color: #123f62;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .otp-box:focus {
            outline: none;
            border-color: rgba(10, 160, 159, 0.85);
            box-shadow: 0 0 0 4px rgba(10, 160, 159, 0.15), 0 8px 20px rgba(7, 57, 107, 0.12);
            transform: translateY(-1px);
        }

        .otp-hint {
            color: #6a7f94;
            font-size: 0.9rem;
            margin-bottom: 16px;
        }

        .btn-reset {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 12px 16px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--reh-teal) 0%, var(--reh-blue) 100%);
            box-shadow: 0 10px 24px rgba(0, 57, 114, 0.26);
        }

        .btn-reset:hover {
            filter: brightness(1.05);
            color: #fff;
        }

        .reset-footer {
            margin-top: 16px;
            text-align: center;
            color: #35516d;
        }

        .reset-footer a {
            color: #0a2f57;
            font-weight: 700;
            text-decoration: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="bg-slideshow" aria-hidden="true">
    <div id="bgSlideA" class="bg-slide active"></div>
    <div id="bgSlideB" class="bg-slide"></div>
    <div class="bg-overlay-layer"></div>
</div>

<div class="reset-shell">
    <div class="reset-card">
        <span class="reset-step">Step 2 of 3</span>
        <h1 class="reset-title">Verify Reset Code</h1>
        <p class="reset-help">We sent a 6-digit code to <strong>{{ email }}</strong>.</p>
        {% if expires_in is not null %}
            <p class="reset-expire">Code expires in {{ expires_in }} seconds.</p>
        {% endif %}

        <form method="post" action="{{ path('app_forgot_password_verify') }}">
            <div class="mb-3">
                <label class="form-label">Verification code</label>
                <div class="otp-grid" id="otpGrid">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" />
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" />
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" />
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" />
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" />
                </div>
                <p class="otp-hint">Enter the 6 digits sent to your email.</p>
                <input type="hidden" id="code" name="code" required pattern="\d{6}">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password_verify') }}">
            <button type="submit" class="btn btn-reset">Verify code</button>
        </form>

        <p class="reset-footer">
            Wrong email?
            <a href="{{ path('app_forgot_password') }}">Go back</a>
        </p>
    </div>
</div>

<script>
    (function () {
        const bgSlideA = document.getElementById('bgSlideA');
        const bgSlideB = document.getElementById('bgSlideB');
        const backgroundImages = [
            'https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1920&q=80',
            'https://images.unsplash.com/photo-1467269204594-9661b134dd2b?auto=format&fit=crop&w=1920&q=80'
        ];

        if (bgSlideA && bgSlideB && backgroundImages.length > 0) {
            let currentIndex = 0;
            let showingA = true;

            bgSlideA.style.backgroundImage = `url('${backgroundImages[currentIndex]}')`;
            bgSlideA.classList.add('active');
            bgSlideB.classList.remove('active');

            setInterval(() => {
                const nextIndex = (currentIndex + 1) % backgroundImages.length;
                const incomingSlide = showingA ? bgSlideB : bgSlideA;
                const outgoingSlide = showingA ? bgSlideA : bgSlideB;

                incomingSlide.style.backgroundImage = `url('${backgroundImages[nextIndex]}')`;
                incomingSlide.classList.add('active');
                outgoingSlide.classList.remove('active');

                currentIndex = nextIndex;
                showingA = !showingA;
            }, 5000);
        }

        const form = document.querySelector('form[action="{{ path('app_forgot_password_verify') }}"]');
        const hiddenCode = document.getElementById('code');
        const boxes = Array.from(document.querySelectorAll('.otp-box'));

        if (!form || !hiddenCode || boxes.length !== 6) {
            return;
        }

        const updateHidden = () => {
            hiddenCode.value = boxes.map((input) => input.value).join('');
        };

        boxes.forEach((input, index) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '').slice(0, 1);
                updateHidden();

                if (input.value !== '' && index < boxes.length - 1) {
                    boxes[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (event) => {
                if (event.key === 'Backspace' && input.value === '' && index > 0) {
                    boxes[index - 1].focus();
                    boxes[index - 1].value = '';
                    updateHidden();
                }

                if (event.key === 'ArrowLeft' && index > 0) {
                    event.preventDefault();
                    boxes[index - 1].focus();
                }

                if (event.key === 'ArrowRight' && index < boxes.length - 1) {
                    event.preventDefault();
                    boxes[index + 1].focus();
                }
            });

            input.addEventListener('paste', (event) => {
                event.preventDefault();
                const pasted = (event.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                if (pasted.length === 0) {
                    return;
                }

                pasted.split('').forEach((digit, digitIndex) => {
                    if (digitIndex < boxes.length) {
                        boxes[digitIndex].value = digit;
                    }
                });

                updateHidden();
                boxes[Math.min(pasted.length, boxes.length) - 1].focus();
            });
        });

        form.addEventListener('submit', (event) => {
            updateHidden();

            if (!/^\d{6}$/.test(hiddenCode.value)) {
                event.preventDefault();
                boxes.find((input) => input.value === '')?.focus();
            }
        });

        boxes[0].focus();
    })();
</script>
{% endblock %}
