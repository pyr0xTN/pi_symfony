{% extends 'front/layout.html.twig' %}

{% block title %}{{ post ? 'Edit Post' : 'New Post' }}{% endblock %}

{% block content %}
<div class="create-post-container">
    <div class="create-post-card">
        <h2 class="create-post-title">{{ post ? 'Edit Post' : 'Create New Post' }}</h2>

        <form method="post" enctype="multipart/form-data" 
              action="{{ post ? path('app_post_edit', {id: post.id}) : path('app_post_new') }}">
            
            {# ── USER STRIP ── #}
            <div class="cpd-user-strip">
                <div class="avatar">{{ app.user.username|first|upper|default('U') }}</div>
                <div>
                    <span class="cpd-username">{{ app.user.username|default('User') }}</span>
                    <div class="cpd-audience">
                        <span class="cpd-audience-label">Posting to</span>
                        <span class="cpd-audience-pill" id="audienceLabel">Public Feed</span>
                    </div>
                </div>
            </div>

            <div class="cpd-divider"></div>

            {# ── MAIN TEXTAREA ── #}
            <textarea name="content" class="cpd-textarea" rows="5" 
                      placeholder="Share your travel experience..." 
                      required minlength="3" maxlength="2000">{{ post ? post.content : '' }}</textarea>

            {# ── IMAGE PREVIEW ── #}
            <div id="imagePreviewBox" class="cpd-image-zone" style="{{ post and post.hasImage ? '' : 'display:none' }}">
                <img id="imagePreview" src="{{ post and post.hasImage ? asset(post.imagePath) : '' }}" alt="">
                <button type="button" class="cpd-remove-img-btn" onclick="removeImagePreview()">✕</button>
            </div>

            {# ── LOCATION ── #}
            <div class="cpd-details-section">
                <div class="cpd-field-row">
                    <label class="cpd-field-icon">Location</label>
                    <div class="cpd-autocomplete-wrapper">
                        <input type="text" name="place" id="placeInput" 
                               value="{{ post ? post.place : '' }}" 
                               placeholder="Search a location..."
                               class="cpd-place-input" autocomplete="off">
                        <div id="placeDropdown" class="cpd-place-dropdown" style="display:none"></div>
                    </div>
                </div>

                {# Agency inputs removed securely #}
            {# ── TOOLBAR ── #}
            <div class="cpd-toolbar">
                <span class="cpd-toolbar-label">Add to post:</span>
                <label class="cpd-tool-btn">
                    📷 Photo
                    <input type="file" name="image" accept="image/*" style="display:none" 
                           onchange="previewImage(this)">
                </label>
                <button type="button" class="cpd-tool-btn" onclick="suggestImage()" id="suggestImgBtn">✨ AI Suggest</button>
            </div>
            <div id="unsplashCredit" class="unsplash-credit" style="display:none"></div>

            {# ── SUBMIT ── #}
            <div class="cpd-submit-row">
                <a href="{{ path('app_feed') }}" class="cpd-cancel-btn">Cancel</a>
                <button type="submit" class="primary-btn">{{ post ? 'Update Post' : 'Publish' }}</button>
            </div>
        </form>
    </div>
</div>

<script>
// Location autocomplete
let placeTimeout;
const placeInput = document.getElementById('placeInput');
const placeDropdown = document.getElementById('placeDropdown');

placeInput.addEventListener('input', function() {
    clearTimeout(placeTimeout);
    const q = this.value.trim();
    if (q.length < 3) { placeDropdown.style.display = 'none'; return; }
    placeTimeout = setTimeout(() => {
        fetch('/api/places/autocomplete?q=' + encodeURIComponent(q))
            .then(r => r.json())
            .then(results => {
                if (!results.length) { placeDropdown.style.display = 'none'; return; }
                placeDropdown.innerHTML = results.map(p => 
                    `<div class="cpd-place-option" onclick="selectPlace('${p.mainText.replace(/'/g,"\\'")}')">
                        <strong>${p.mainText}</strong><span>${p.secondaryText}</span>
                    </div>`
                ).join('');
                placeDropdown.style.display = 'block';
            });
    }, 600);
});

// Close dropdown on outside click
document.addEventListener('click', function(e) {
    if (!placeInput.contains(e.target) && !placeDropdown.contains(e.target)) {
        placeDropdown.style.display = 'none';
    }
});

function selectPlace(name) {
    placeInput.value = name;
    placeDropdown.style.display = 'none';
}

function previewImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('imagePreview').src = e.target.result;
            document.getElementById('imagePreviewBox').style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function removeImagePreview() {
    document.getElementById('imagePreview').src = '';
    document.getElementById('imagePreviewBox').style.display = 'none';
    const credit = document.getElementById('unsplashCredit');
    if (credit) credit.style.display = 'none';
}

// Unsplash AI image suggestion
function suggestImage() {
    const place = document.getElementById('placeInput').value.trim();
    const content = document.querySelector('.cpd-textarea').value.trim();
    const query = place || content.split(' ').slice(0, 5).join(' ');

    if (!query || query.length < 2) {
        showToast('Enter a location or some text first so I know what to search for!', 'info');
        return;
    }

    const btn = document.getElementById('suggestImgBtn');
    btn.textContent = '⏳ Searching...';
    btn.disabled = true;

    fetch('/api/unsplash/' + encodeURIComponent(query))
        .then(r => r.json())
        .then(data => {
            btn.textContent = '✨ AI Suggest';
            btn.disabled = false;

            if (data.error || !data.url) {
                showToast('No matching photo found. Try a different location!', 'info');
                return;
            }

            // Show the image preview
            document.getElementById('imagePreview').src = data.url;
            document.getElementById('imagePreviewBox').style.display = 'block';

            // Show photographer credit
            const credit = document.getElementById('unsplashCredit');
            credit.innerHTML = `Photo by <a href="${data.photographerUrl}?utm_source=rehletna&utm_medium=referral" target="_blank">${data.photographer}</a> on <a href="https://unsplash.com?utm_source=rehletna&utm_medium=referral" target="_blank">Unsplash</a>`;
            credit.style.display = 'block';

            showToast('Image suggestion loaded! You can still upload your own photo to replace it.', 'success');
        })
        .catch(() => {
            btn.textContent = '✨ AI Suggest';
            btn.disabled = false;
            showToast('Could not reach the image service. Please try again.', 'error');
        });
}
</script>
{% endblock %}
