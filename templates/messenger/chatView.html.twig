function applyReaction(e, msgId, emoji, badgeEl) {
    e.stopPropagation();

    // Fermer le picker
    document.querySelectorAll('.msg-reaction-picker.open')
        .forEach(p => p.classList.remove('open'));

    const zone = document.getElementById('reactions-zone-' + msgId);
    const msgEl = zone ? zone.closest('.message') : null;
    const isMyMsg = msgEl && msgEl.classList.contains('mine');

    // Détecter si c'est un toggle off (clic sur le badge existant)
    const currentBadge = zone ? zone.querySelector('.react-badge') : null;
    const currentEmoji = currentBadge ? currentBadge.dataset.emoji : null;
    const nextEmoji = (currentEmoji === emoji) ? null : emoji;

    fetch(`/api/messages/${msgId}/react`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emoji: nextEmoji })
    })
    .then(res => res.json())
    .then(data => {
        if (!zone) return;
        zone.innerHTML = '';
        if (data.reaction) {
            const badge = document.createElement('span');
            badge.className = 'react-badge' + (isMyMsg ? ' mine-react' : '');
            badge.dataset.emoji = data.reaction;
            badge.style.fontSize = '14px';
            badge.style.cursor = 'pointer';
            badge.textContent = data.reaction;
            badge.onclick = (ev) => applyReaction(ev, msgId, data.reaction, badge);
            zone.appendChild(badge);
        }
    })
    .catch(err => console.error('Reaction error:', err));
}

