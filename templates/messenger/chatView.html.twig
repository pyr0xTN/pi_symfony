<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
 <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


 <script >
 
	let currentConversationId = null;
	    const selectedMembers = new Set();
	
	    /* ══ SIDEBAR FILTERS + SEARCH ══ */
	    function applySidebarFilters() {
	        const query  = document.getElementById('contact-search').value.toLowerCase();
	        const filter = document.querySelector('.f-btn.active').dataset.filter;
	        document.querySelectorAll('.conv-item').forEach(item => {
	            const name = item.querySelector('.conv-name').textContent.toLowerCase();
	            const type = item.dataset.type;
	            item.style.display = (name.includes(query) && (filter === 'all' || type === filter)) ? 'flex' : 'none';
	        });
	    }
	    document.getElementById('contact-search').addEventListener('input', applySidebarFilters);
	    document.querySelectorAll('.f-btn').forEach(btn => {
	        btn.addEventListener('click', function () {
	            document.querySelector('.f-btn.active').classList.remove('active');
	            this.classList.add('active');
	            applySidebarFilters();
	        });
	    });
	
	    function toggleChatSearch() {
	        const wrap = document.getElementById('header-search-wrap');
	        const input = document.getElementById('msg-search-input');
	        if (wrap.style.display === 'none') {
	            wrap.style.display = 'flex';
	            input.focus();
	        } else {
	            wrap.style.display = 'none';
	            input.value = '';
	            searchInConversation(); // reset filter
	        }
	    }
	
	    function searchInConversation() {
	
	        const query = document.getElementById('msg-search-input').value.toLowerCase();
	        document.querySelectorAll('.message').forEach(msg => {
	            const text = msg.querySelector('.msg-content').textContent.toLowerCase();
	            msg.style.opacity = text.includes(query) ? '1' : '0.3';
	        });
	    }
	
	
	    /* ══ LOAD CONVERSATION ══ */
	    function toggleMoreOptions(e) {
	        e.stopPropagation();
	        const menu = document.getElementById('chat-options-menu');
	        menu.classList.toggle('open');
	    }
	
	    document.addEventListener('click', () => {
	        document.getElementById('chat-options-menu').classList.remove('open');
	    });
	
	function addConversationToSidebar(conv) {
	    const list = document.getElementById('conversation-list');
	    
	    // Vérifier si elle existe déjà pour éviter les doublons
	    if (document.querySelector(`.conv-item[data-id="${conv.id}"]`)) return;
	
	    // Supprimer le message "No conversations yet" si c'est la première
	    const emptyMsg = list.querySelector('.empty-side');
	    if (emptyMsg) emptyMsg.remove();
	
	    const newItem = document.createElement('div');
	    newItem.className = `conv-item ${conv.type.toLowerCase()} active`;
	    newItem.setAttribute('onclick', `loadConversation(${conv.id})`);
	    newItem.setAttribute('data-id', conv.id);
	    newItem.setAttribute('data-type', conv.type);
	
	    newItem.innerHTML = `
	        <div class="avatar ${conv.type === 'GROUPE' ? 'group' : ''}">
	            ${conv.displayName.charAt(0).toUpperCase()}
	        </div>
	        <div class="conv-body">
	            <div class="conv-row">
	                <span class="conv-name">${conv.displayName}</span>
	                <span class="conv-time">Now</span>
	            </div>
	            <p class="conv-preview">New conversation started</p>
	        </div>
	    `;
	
	    list.prepend(newItem); // Ajouter en haut de la liste
	}
	    /* ══ LOAD CHAT ══ */
	    function loadConversation(id) {
	        currentConversationId = id;
	        fetch(`/conversation/api/${id}`)
	            .then(res => res.json())
	            .then(conv => {
	                currentConversationData = conv;
	                document.getElementById('welcome-screen').style.display = 'none';
	                document.getElementById('chat-interface').style.display = 'flex';
	                document.getElementById('chat-name').textContent = conv.displayName;
	                const avatarEl = document.getElementById('chat-header-avatar');
	                avatarEl.textContent = conv.displayName.charAt(0).toUpperCase();
	                
	                // Show/Hide group options
	                const isGroup = (conv.type === 'GROUPE');
	                document.getElementById('opt-rename').style.display = isGroup ? 'block' : 'none';
	                document.getElementById('opt-members').style.display = isGroup ? 'block' : 'none';
	                
	
					addConversationToSidebar(conv);
	            document.querySelectorAll('.conv-item').forEach(i => i.classList.remove('active'));
	            const active = document.querySelector(`.conv-item[data-id="${id}"]`);
	            if (active) active.classList.add('active');
	            loadMessages(id);
				if (document.getElementById('media-panel').style.display !== 'none') {
                    loadMediaHistory(id);
                }
	            fetch(`/api/messages/mark-read/${id}`, { method: 'POST' })
    	            .then(() => {
    	                const sideItem = document.querySelector(`.conv-item[data-id="${id}"]`);
    	                if (sideItem) {
            	            sideItem.classList.remove('has-unread');
            	            const badge = sideItem.querySelector('.conv-unread-badge');
            	            if (badge) badge.remove();
                            const time = sideItem.querySelector('.conv-time');
        	                if (time) time.classList.remove('conv-time--unread');
        	                const preview = sideItem.querySelector('.conv-preview');
        	                if (preview) preview.classList.remove('conv-preview--unread');
            	            const name = sideItem.querySelector('.conv-name');
                            if (name) name.style.fontWeight = '';
                        }
                    });
	        });
	    }
	
	    function handleDeleteChat() {
	    if (!confirm("Are you sure you want to delete this conversation?")) return;
	
	    // On garde une référence à l'ID avant de fermer la vue
	    const idToDelete = currentConversationId;
	
	    fetch(`/conversation/delete/${idToDelete}`, { 
	        method: 'POST',
	        headers: { 
	            'X-Requested-With': 'XMLHttpRequest',
	            'Content-Type': 'application/json' 
	         } 
	    })
	    .then(response => {
	        if (response.ok) {
	            // 1. Retourner à l'écran d'accueil du chat
	            goBackToWelcome();
	
	            // 2. Supprimer l'élément de la liste latérale (le DOM)
	            const sideItem = document.querySelector(`.conv-item[data-id="${idToDelete}"]`);
	            if (sideItem) {
	                sideItem.remove(); // Supprime physiquement la ligne de la liste
	            }
	
	            // 3. Optionnel : si la liste est vide, afficher le message "No conversations"
	            const list = document.getElementById('conversation-list');
	            if (list && list.querySelectorAll('.conv-item').length === 0) {
	                list.innerHTML = `
	                    <div class="empty-side">
	                        <p>No conversations yet.</p>
	                    </div>`;
	            }
	        } else {
	            alert('Failed to delete conversation');
	        }
	    })
	    .catch(err => console.error('Error deleting conversation:', err));
	}
	    function openModal(type) {
	    const overlay = document.getElementById('msng-overlay');
	    const targetModal = document.getElementById('modal-' + type);
	
	    if (!targetModal) return; // Sécurité si l'ID est faux
	
	    // 1. Cacher toutes les autres modales d'abord
	    document.querySelectorAll('.msng-modal').forEach(m => {
	        m.classList.remove('active');
	        m.style.display = 'none';
	    });
	
	    // 2. Afficher l'overlay et la modale cible
	    overlay.style.display = 'flex';
	    targetModal.style.display = 'flex';
	
	    // 3. Un petit délai pour que la transition CSS (opacity/scale) se déclenche
	    setTimeout(() => {
	        overlay.classList.add('visible');
	        targetModal.classList.add('active'); // <--- TRÈS IMPORTANT pour le CSS
	    }, 10);
	
	    // 4. Charger les données spécifiques
	    if (type === 'members') {
	        loadMembersList();
	    }
	    
	    if (type === 'rename' && currentConversationData) {
	        document.getElementById('rename-input').value = currentConversationData.title || "";
	    }
	}
	
	   function loadMembersList() {
	    const list = document.getElementById('members-list-content');
	    
	    // Check if we have data
	    if (!currentConversationData || !currentConversationData.participants) {
	        list.innerHTML = '<div class="p-4 text-center">Loading members...</div>';
	        return;
	    }
	
	    // Logic similar to your Java "for (Person u : membres)"
	    list.innerHTML = currentConversationData.participants.map(p => `
	        <div class="modal-user-row" style="display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid #f8fafc;">
	            <div class="m-avatar" style="width:38px; height:38px; background:#dff0ee; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:700; color:#0d7a72;">
	                ${p.name.charAt(0).toUpperCase()}
	            </div>
	            <div class="m-info">
	                <div class="m-name" style="font-weight:600; color:#0d2a4a;">
	                    ${p.name}
	                </div>
	                <div style="font-size:11px; color:#1eb2a6;">Active Member</div>
	            </div>
	        </div>
	    `).join('');
		}
	
	    function submitRenameGroup() {
			const input = document.getElementById('rename-input');
			const errorEl = document.getElementById('rename-error');
			const content = input.value.trim();
			if (!content) {
	        errorEl.style.display = 'block'; // Affiche le message d'erreur
	        input.style.borderColor = '#dc3545'; // Optionnel : met la bordure en rouge
	        input.focus();
			setTimeout(() => {
	            errorEl.style.display = 'none';
	            input.style.borderColor = 'var(--border)';
	        }, 3000);
	        return;
	    } else {
	        errorEl.style.display = 'none'; // Cache l'erreur si c'est rempli
	        input.style.borderColor = 'var(--border)';
	    }
	        const newName = document.getElementById('rename-input').value.trim();
	        if (!newName) return;
	
	        fetch(`/conversation/rename/${currentConversationId}`, {
	            method: 'POST',
	            headers: { 'Content-Type': 'application/json' },
	            body: JSON.stringify({ title: newName })
	        })
	        .then(res => res.json())
	        .then(data => {
	            if (data.status === 'ok') {
	                closeModal();
	                // 1. Mettre à jour le titre dans le header
	                document.getElementById('chat-name').textContent = newName;
	                document.getElementById('chat-header-avatar').textContent = newName.charAt(0).toUpperCase();
	
	                // 2. Mettre à jour le titre dans la liste latérale
	                const sideItem = document.querySelector(`.conv-item[data-id="${currentConversationId}"]`);
	                if (sideItem) {
	                    sideItem.querySelector('.conv-name').textContent = newName;
	                    sideItem.querySelector('.avatar').textContent = newName.charAt(0).toUpperCase();
	                }
	                
	                // 3. Mettre à jour l'objet local en mémoire
	                currentConversationData.displayName = newName;
	                currentConversationData.title = newName;
	            }
	        })
	        .catch(err => console.error('Error renaming:', err));
	    }
	
	
	    /* ══ GO BACK TO WELCOME ══ */
	    function goBackToWelcome() {
	        currentConversationId = null;
	
	        document.getElementById('chat-interface').style.display = 'none';
	        document.getElementById('welcome-screen').style.display = 'flex';
	
	        // Remove active state from sidebar
	        document.querySelectorAll('.conv-item').forEach(i => i.classList.remove('active'));
	    }
	
	/* ══ UPLOAD FILE ══ */
	function handleFileUpload(input) {
	    const file = input.files[0];
	    if (!file || !currentConversationId) return;
	
	    const formData = new FormData();
	    formData.append('file', file);
	    formData.append('conversationId', currentConversationId);
	
	    fetch('/api/messages/upload', {
	        method: 'POST',
	        body: formData
	    })
	    .then(res => res.json())
	    .then(data => {
	        if (data.success) {
	            loadMessages(currentConversationId); // On recharge le chat
	            input.value = ''; // On réinitialise l'explorateur
	        } else {
	            alert("Upload failed: " + data.message);
	        }
	    })
	    .catch(err => console.error('Error uploading:', err));
	}

function loadMessages(id) {
    fetch(`/api/messages/fetch/${id}`)
        .then(res => res.json())
        .then(msgs => {
            const container = document.getElementById('chat-messages');
            container.innerHTML = `<div class="messages-date-divider"><span>Today</span></div>`;
            
            if (!msgs || msgs.length === 0) {
                container.innerHTML += `<div style="text-align:center;color:var(--muted);font-size:13px;padding:32px 0;">No messages yet. 👋</div>`;
                return;
            }

            msgs.forEach((m, i) => {
                const prev = msgs[i - 1];
                const isConsec = prev && prev.isMine === m.isMine;
                const showAvatar = !m.isMine && !isConsec;
                const isDeleted = m.isDeleted === true;
                const type = m.type ? m.type.toUpperCase() : 'TEXTE';

                // --- 1. GESTION DU CONTENU (Images, PDF, Texte) ---
                let displayContent = '';
                let bubbleExtraClass = '';

                if (isDeleted) {
                    displayContent = `<i class="msg-deleted-text">This message was deleted</i>`;
                } else {
                    const fileUrl = `/uploads/messages/${m.filePath}`;
                    switch (type) {
                        case 'IMAGE':
                            bubbleExtraClass = 'msg-content--media';
                            displayContent = `
                                <div class="msg-media-preview">
                                    <img src="${fileUrl}" class="msg-img-thumb" onclick="window.open(this.src)">
                                    <a href="${fileUrl}" download class="media-download-overlay">⬇️</a>
                                </div>`;
                            break;
                        case 'FICHIER':
                            bubbleExtraClass = 'msg-content--file';
                            const isPdf = m.filePath && m.filePath.toLowerCase().endsWith('.pdf');
                            displayContent = `
                                <div class="msg-file-card">
                                    <div class="file-icon-box ${isPdf ? 'is-pdf' : ''}">${isPdf ? 'PDF' : 'DOC'}</div>
                                    <div class="file-details">
                                        <span class="file-name-text">${escapeHtml(m.content || 'Document')}</span>
                                        <span class="file-meta-info">Cliquer pour télécharger</span>
                                    </div>
                                    <a href="${fileUrl}" download class="file-action-dl">
                                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                    </a>
                                </div>`;
                            break;
						case 'LOCATION':
                            try {
                            const loc = JSON.parse(m.content);
                            displayContent = `
                                <div class="msg-location-card" style="min-width: 220px;">
                                    <div style="font-weight: 700; font-size: 13px; margin-bottom: 4px;">📍 Position partagée</div>
                                    <div style="font-size: 11px; color: var(--muted); line-height: 1.4; margin-bottom: 10px;">
                                        ${escapeHtml(loc.address)}
                                    </div>
                                    <a href="https://www.google.com/maps?q=${loc.lat},${loc.lng}" target="_blank" 
                                        style="display: block; background: var(--teal); color: white; text-align: center; padding: 8px; border-radius: 8px; text-decoration: none; font-size: 12px; font-weight: 600;">
                                        Ouvrir dans Maps
                                    </a>
                                </div>`;
                            } catch (e) {
                                displayContent = "📍 Localisation partagée";
                          }
                            break;
                        default:
                            displayContent = escapeHtml(m.content);
                    }
                }
                let actionBtn = '';
                const pickerEmojis = ['❤️','😂','👍','😮','😢','😡'];
                const pickerHtml = `
                <div class="msg-reaction-picker" id="react-picker-${m.id}">
                    ${pickerEmojis.map(em => `<span class="react-emoji-opt" data-emoji="${em}" onclick="applyReaction(event,${m.id},'${em}',null)">${em}</span>`).join('')}
                </div>`;

const reactBtn = `
    <div style="position:relative;">
        <button class="msg-action-btn" onclick="toggleReactPicker(event,${m.id})" title="React">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path stroke-linecap="round" d="M8 14s1.5 2 4 2 4-2 4-2"/>
                <line x1="9" y1="9" x2="9.01" y2="9" stroke-linecap="round" stroke-width="3"/>
                <line x1="15" y1="9" x2="15.01" y2="9" stroke-linecap="round" stroke-width="3"/>
            </svg>
        </button>
        ${pickerHtml}
    </div>`;

if (m.isMine && !isDeleted) {
