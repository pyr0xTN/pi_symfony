	function startMsgEdit(e, item) {
	    e.stopPropagation();
	    const msg = item.closest('.message');
	    document.querySelectorAll('.msg-menu.open').forEach(m => m.classList.remove('open'));
	    msg.classList.add('editing');
	    const input = msg.querySelector('.msg-edit-input');
	    input.focus();
	    input.setSelectionRange(input.value.length, input.value.length);
	    input.onkeydown = (ev) => {
	        if (ev.key === 'Enter') { ev.preventDefault(); saveMsgEdit(ev, input, msg.dataset.msgId); }
	        if (ev.key === 'Escape') cancelMsgEdit(ev, input);
	    };
	}
	
	function cancelMsgEdit(e, btn) {
	    e.stopPropagation();
	    const msg = btn.closest('.message');
	    msg.classList.remove('editing');
	    const content = msg.querySelector('.msg-content').textContent.replace('(edited)', '').trim();
	    msg.querySelector('.msg-edit-input').value = content;
	}
	
	function saveMsgEdit(e, btn, msgId) {
	    e.stopPropagation();
	    const msg = btn.closest('.message');
	    const input = msg.querySelector('.msg-edit-input');
	    const newText = input.value.trim();
	    if (!newText) return;
	
	    fetch(`/api/messages/update/${msgId}`, {
	        method: 'PUT',
	        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
	        body: JSON.stringify({ content: newText })
	    })
	    .then(res => res.json())
	    .then(() => {
	        msg.querySelector('.msg-content').innerHTML = escapeHtml(newText) + ' <span class="edited-label">(edited)</span>';
	        msg.classList.remove('editing');
