let locationMap = null;
let locationMarker = null;
let selectedLatLng = null;
let selectedAddress = '';
let searchDebounceTimer = null;

function openLocationPicker() {
    // Affichage de la modale (ta logique existante)
    const overlay = document.getElementById('msng-overlay');
    document.querySelectorAll('.msng-modal').forEach(m => { m.classList.remove('active'); m.style.display = 'none'; });
    const modal = document.getElementById('modal-location');
    modal.style.display = 'flex';
    overlay.style.display = 'flex';
    
    setTimeout(() => { 
        overlay.classList.add('visible'); 
        modal.classList.add('active');
        initLeafletMap();
		setTimeout(() => {
            if (locationMap) {
                locationMap.invalidateSize();
            }
        }, 400);
    }, 10);
}

function initLeafletMap() {
    const defaultPos = [36.8065, 10.1815]; // Tunis

    // On évite de recréer la carte si elle existe déjà
    if (locationMap) {
        locationMap.remove();
    }

    // Création de la carte
    locationMap = L.map('location-map').setView(defaultPos, 13);

    // Ajout des tuiles OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(locationMap);

    // Création du marqueur déplaçable
    locationMarker = L.marker(defaultPos, { draggable: true }).addTo(locationMap);

    // Événement : Clic sur la carte pour déplacer le marqueur
    locationMap.on('click', (e) => {
        updatePosition(e.latlng.lat, e.latlng.lng);
    });

    // Événement : Fin du glisser-déposer du marqueur
    locationMarker.on('dragend', (e) => {
        const pos = e.target.getLatLng();
        updatePosition(pos.lat, pos.lng);
    });

    // Tentative de géolocalisation automatique de l'utilisateur
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition((pos) => {
            updatePosition(pos.coords.latitude, pos.coords.longitude, true);
        }, () => {
            updatePosition(defaultPos[0], defaultPos[1], true);
        });
    } else {
        updatePosition(defaultPos[0], defaultPos[1], true);
    }
}

function updatePosition(lat, lng, centerMap = false) {
    selectedLatLng = { lat, lng };
    locationMarker.setLatLng([lat, lng]);
    if (centerMap) locationMap.setView([lat, lng], 16);
    
    // Récupérer l'adresse textuelle (Reverse Geocoding) via Nominatim (Gratuit)
    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
        .then(res => res.json())
        .then(data => {
            selectedAddress = data.display_name;
            document.getElementById('location-address').textContent = selectedAddress;
            document.getElementById('location-modal-subtitle').textContent = 'Location selected';
        })
        .catch(() => {
            document.getElementById('location-address').textContent = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
        });
}

// Recherche d'adresse par texte
function debounceSearch(val) {
    clearTimeout(searchDebounceTimer);
    if (val.length < 3) return;

    searchDebounceTimer = setTimeout(() => {
        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(val)}`)
            .then(res => res.json())
            .then(data => {
                if (data.length > 0) {
                    const first = data[0];
                    updatePosition(parseFloat(first.lat), parseFloat(first.lon), true);
                }
            });
    }, 600);
}

function sendLocation() {
    if (!selectedLatLng || !currentConversationId) return;

    // On prépare le contenu sous forme de JSON string pour le stocker en BDD
    const content = JSON.stringify({
        lat: selectedLatLng.lat,
        lng: selectedLatLng.lng,
        address: selectedAddress
    });

    fetch(`/api/messages/send-location/${currentConversationId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content })
    })
    .then(res => res.json())
    .then(data => {
        closeModal();
        loadMessages(currentConversationId); // On rafraîchit le chat
    })
    .catch(err => console.error('Error sending location:', err));
}

function closeLocationModal() { closeModal(); }

function toggleMediaPanel() {
  const panel = document.getElementById('media-panel');
  if (panel.style.display === 'none' || !panel.style.display) {
    panel.style.display = 'flex';
    if (currentConversationId) loadMediaHistory(currentConversationId);
  } else {
    panel.style.display = 'none';
  }
}

function switchMediaTab(tab) {
  const isImages = tab === 'images';
  document.getElementById('tab-images').classList.toggle('active', isImages);
  document.getElementById('tab-files').classList.toggle('active', !isImages);
  document.getElementById('mp-body-images').style.display = isImages ? 'block' : 'none';
  document.getElementById('mp-body-files').style.display = isImages ? 'none' : 'block';
}

function loadMediaHistory(convId) {
  fetch(`/api/messages/${convId}/media`)
    .then(r => r.json())
    .then(data => {
      // --- Images ---
      const imgBody = document.getElementById('mp-body-images');
      document.getElementById('img-count').textContent = `(${data.images.length})`;
      if (!data.images.length) {
        imgBody.innerHTML = `<div class="mp-empty"><p>No images yet.</p></div>`;
      } else {
        imgBody.innerHTML = `<div class="img-grid">${
          data.images.map(img => `
            <div class="img-thumb" onclick="window.open('${img.url}')">
              <img src="${img.url}" loading="lazy">
              <div class="img-overlay">${img.date}</div>
            </div>`).join('')
        }</div>`;
      }

      // --- Files ---
      const fileBody = document.getElementById('mp-body-files');
      document.getElementById('file-count').textContent = `(${data.files.length})`;
      if (!data.files.length) {
        fileBody.innerHTML = `<div class="mp-empty"><p>No files yet.</p></div>`;
      } else {
        fileBody.innerHTML = `<div class="file-list">${
          data.files.map(f => `
            <a class="file-row" href="${f.url}" download>
              <div class="file-icon ${f.isPdf ? 'pdf' : 'doc'}">${f.isPdf ? 'PDF' : 'DOC'}</div>
              <div class="file-info">
                <div class="file-name">${escapeHtml(f.name)}</div>
                <div class="file-meta">${f.sender} · ${f.date}</div>
              </div>
              <div class="file-dl">⬇</div>
            </a>`).join('')
        }</div>`;
      }
      document.getElementById('mp-count-label').textContent =
        `${data.images.length} image${data.images.length !== 1 ? 's' : ''} · ${data.files.length} file${data.files.length !== 1 ? 's' : ''}`;
    });
}
