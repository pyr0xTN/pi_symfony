	        input.style.borderColor = 'var(--border)';
	    }
	        if (!content || !currentConversationId) return;
	
	        fetch(`/api/messages/send/${currentConversationId}`, {
	            method: 'POST',
	            headers: { 'Content-Type': 'application/json' },
	            body: JSON.stringify({ content: content })
	        })
	        .then(res => res.json())
	        .then(data => {
	            if (data.error) {
	                alert(data.error);
	            } else {
	                input.value = '';
	                loadMessages(currentConversationId); // Refresh messages list
	                
	                // Update sidebar preview
	                const sideItem = document.querySelector(`.conv-item[data-id="${currentConversationId}"]`);
	                if (sideItem) {
