	    function sendMessage() {
	        const input = document.getElementById('message-input');
			const contentError = document.getElementById('message-error');
	        const content = input.value.trim();
			if (!content) {
	        contentError.style.display = 'block'; // Affiche le message d'erreur
	        contentInput.style.borderColor = '#dc3545'; // Optionnel : met la bordure en rouge
	        input.focus();
